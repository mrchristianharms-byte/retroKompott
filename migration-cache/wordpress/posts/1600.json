,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 051 - neue C64 Spiele Part 1\",\"subtitle\":null,\"summary\":null,\"duration\":\"4:26:26\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:00:52\",\"title\":\"Vierzeiler\"},{\"start\":\"00:01:07\",\"title\":\"Titelmusik\"},{\"start\":\"00:02:25\",\"title\":\"Heute sind mit dabei\"},{\"start\":\"00:02:36\",\"title\":\"Retro Warm Up - auf in eine neue Runde\"},{\"start\":\"00:41:47\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"00:56:09\",\"title\":\"Retro Facts: neue C64 Spiele PART 1\"},{\"start\":\"02:23:33\",\"title\":\"PAUSENMUSIK (Bug of NCI)\"},{\"start\":\"02:25:26\",\"title\":\"Retro Play - Was sollen wir spielen?\"},{\"start\":\"02:27:09\",\"title\":\"PAUSENMUSIK (Bug of NCI)\"},{\"start\":\"02:28:17\",\"title\":\"Retro Play - das Resumee Parsec C64\"},{\"start\":\"02:37:44\",\"title\":\"Retro Talk - Das Schweigen\"},{\"start\":\"02:38:25\",\"title\":\"Retro Talk - Interview mit Frank Matzke\"},{\"start\":\"03:25:37\",\"title\":\" Pausenmusik (Bug of NCI)\"},{\"start\":\"03:26:45\",\"title\":\"Retro Mysteries - Sound Quiz\"},{\"start\":\"03:47:31\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"04:13:43\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"04:23:23\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2017-10-28_retrokompott_-_051_-_neue_c64_spiele_part1.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        <br />\n<a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2017-10-28_retrokompott_-_051_-_neue_c64_spiele_part1.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 51</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.patreon.com/posts/nachlese-zur-51-15086489\">N18</a> 27.10.2017 0h36min   Nachlese Folge 51   <a href=\"https://www.patreon.com/posts/nachlese-zur-51-15086489\">exclusiv fuer Patreon</a><a href=\"https://www.patreon.com/posts/die-nachlese-zur-8832336\"><br />\n</a></p>\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<hr />\n<p>Aufnahmedatum: 26.10.2017 &amp; 27.10.2017<br />\nmit <b>Robin, Patrick, Fabskimo, Selmar, Phillipp<br />\n</b></p>\n<p><b>und als Themenexperten Patrick, Fbaskimo, Phillipp</b></p>\n<p>Dauer: 4h26</p>\n<div id=\"magicdomid8\">\n<div>\n<hr />\n</div>\n<div>\n<p>Robin:<br />\nHabt ihr immer noch einen Jetlag von der 50ten Folge ?</p>\n<p>Selmar:<br />\nWas sind schon knappe 10 Stunden….</p>\n<p>Fabskimo:<br />\nBerlin ist immer bereit! Ob mit oder ohne Ton!</p>\n<p>Patrick:<br />\n…. und ich habe Knoten in den Fingern vom Schnitt…….<br />\nkoennen wir uns heute mal kuerzer fassen ?</p>\n<p>Philipp:<br />\nBeim Retrokompott ? Unwahrscheinlich!</p>\n<p>&nbsp;</p>\n</div>\n</div>\n<div>\n<div id=\"magicdomid6\">\n<div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<hr />\n<div id=\"magicdomid651\">\n<h2><strong>Ihr wollt beim Retrokompott mitmachen?</strong></h2>\n</div>\n<h3>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a><br />\noder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzeichnung<br />\ndes naechsten Themas als erstes!</h3>\n<div>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</div>\n<div>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></div>\n</div>\n<div>\n<div>\n<div>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</div>\n</div>\n<div>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</div>\n</div>\n</div>\n</div>\n<div>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</div>\n<div></div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<div>&#8230;</div>\n<div>&#8212;</div>\n<div>Das Rahmenprogramm zeichnen wir jeden zweiten Freitag<br />\nLIVE auf: <a href=\"http://www.mixlr.com/retrokompott\">www.mixlr.com/retrokompott</a></div>\n<div>&#8212;</div>\n<div>\n<p>Werbung in eigener Sache:</p>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken<br />\n</a>&#8230;</p>\n</div>\n<div></div>\n</div>\n</div>\n<hr />\n<div></div>\n<div>\n<p>Die Links und weiterfuehrenden Infos zum Podcast:</p>\n</div>\n</div>\n</div>\n<div>\n<p>Die Musik fuer diese Folge stammt von Bug of NCI ausser es wurde anders erwaehnt. Saemtliche Musik ist gemafrei.</p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.kickstarter.com/projects/c64audio/project-hubbard-official-rob-hubbard-kickstarter?lang=de\">https://www.kickstarter.com/projects/c64audio/project-hubbard-official-rob-hubbard-kickstarter?lang=de</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.youtube.com/watch?v=OKxamK2WwdM&amp;feature=youtu.be\">https://www.youtube.com/watch?v=OKxamK2WwdM&amp;feature=youtu.be</a></p>\n<p>&nbsp;</p>\n<p>ein paar Links von Gordon:</p>\n<p>&nbsp;</p>\n<p><a href=\"http://www.indieretronews.com/2017/10/creepy-brawlers-creepin-it-reel-justice.html\">http://www.indieretronews.com/2017/10/creepy-brawlers-creepin-it-reel-justice.html</a></p>\n<p>&nbsp;</p>\n<p><a href=\"http://www.indieretronews.com/2017/10/sheep-it-up-new-game-for-real-gameboy.html\">http://www.indieretronews.com/2017/10/sheep-it-up-new-game-for-real-gameboy.html</a></p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p><a href=\"http://jpgames.de/2017/10/retro-neuauflage-des-tamagotchi-erscheint-im-oktober/\">http://jpgames.de/2017/10/retro-neuauflage-des-tamagotchi-erscheint-im-oktober/</a></p>\n<p>&nbsp;</p>\n<p><a href=\"http://amiga-news.de/de/news/AN-2017-10-00047-DE.html\">http://amiga-news.de/de/news/AN-2017-10-00047-DE.html</a></p>\n<p>&nbsp;</p>\n<p>……………..</p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.kickstarter.com/projects/thalamusdigital/hunters-moon-remastered?lang=de\">https://www.kickstarter.com/projects/thalamusdigital/hunters-moon-remastered?lang=de</a></p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p><a href=\"https://soundcloud.com/tess-and-tel/tess-tel-interview-by-retrokompott-jubilaeumsshow-2017-october-13\">https://soundcloud.com/…/tess-tel-interview-by-retrokompott…</a></p>\n<p>&nbsp;</p>\n<p><a href=\"http://www.indieretronews.com/2017/10/a-c64-horror-game-is-coming-by-alf.html\">http://www.indieretronews.com/2017/10/a-c64-horror-game-is-coming-by-alf.html</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.forum64.de/index.php?thread/77732-spritemate-spriteeditor/\">https://www.forum64.de/index.php?thread/77732-spritemate-spriteeditor/</a></p>\n<p><a href=\"http://www.spritemate.com/\">http://www.spritemate.com/</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.nordbuzz.de/lifestyle/multimedia/super-nintendo-nachbau-kommt-bisher-unveroeffentlichtem-directors-super-turrican-8804236.html\">https://www.nordbuzz.de/lifestyle/multimedia/super-nintendo-nachbau-kommt-bisher-unveroeffentlichtem-directors-super-turrican-8804236.html</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.bittboy.com/\">https://www.bittboy.com/</a></p>\n</div>\n</div>\n</div>\n</div>\n<div></div>\n<div style=\"text-align: center;\">&#8230;&#8230;&#8230;&#8230;&#8230;&#8230;&#8230;.</div>\n<div id=\"magicdomid510\">\n<div style=\"text-align: center;\">\n<p>Naechste Rahmenprogrammaufzeichnung:</p>\n</div>\n<div style=\"text-align: center;\">\n<p>LIVE:  10.11.2017 22:00 Uhr<br />\nvoraussichtlich von dem AMIGA MEETING Neumuenster:<br />\n<a href=\"http://www.amigameeting.de\">www.amigameeting.de</a></p>\n<p>LIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a><br />\n(Thema als Aufzeichnung vorausichtlich ab 20:00 Uhr)</p>\n<p>Thema: neue C64 Spiele PART 2</p>\n</div>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></p>\n<p style=\"text-align: center;\">weitere Infos in der Textdatei.<br />\nDiese wird regelmaessig aktualisiert,<br />\nes kommen auch noch C64 &amp; Konsolenspiele dazu.</p>\n</div>\n",
