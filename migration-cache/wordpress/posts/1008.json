,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 032 - Spielezeitschriften Part 1\",\"subtitle\":null,\"summary\":null,\"duration\":\"5:43:37\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:00:15\",\"title\":\"Vierzeiler\"},{\"start\":\"00:00:25\",\"title\":\"Titelmusik\"},{\"start\":\"00:01:42\",\"title\":\"Heute sind mit dabei\"},{\"start\":\"00:01:53\",\"title\":\"Retro Warm Up - auf in eine neue Runde\"},{\"start\":\"00:15:03\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"00:21:05\",\"title\":\"Retro Play - was sollen wir spielen ?\"},{\"start\":\"00:23:34\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"00:24:44\",\"title\":\"Retro Play - das Resumee\"},{\"start\":\"00:25:44\",\"title\":\"Frankie goes to Hollywood (C64)\"},{\"start\":\"00:31:46\",\"title\":\"Ricochet (C64)\"},{\"start\":\"00:34:52\",\"title\":\"Retro Facts - das heutige Thema Spielezeitschriften PART 1\"},{\"start\":\"00:41:24\",\"title\":\"Die wichtigsten Verlage\"},{\"start\":\"00:49:00\",\"title\":\"Telematch \"},{\"start\":\"01:07:37\",\"title\":\"Happy Computer \"},{\"start\":\"01:20:32\",\"title\":\"64er Magazin\"},{\"start\":\"01:31:51\",\"title\":\"ASM \"},{\"start\":\"01:50:43\",\"title\":\"Power Play \"},{\"start\":\"02:08:11\",\"title\":\"Computer Flohmarkt \"},{\"start\":\"02:25:40\",\"title\":\"PAUSENMUSIK_WHY_ARE_YOU_GONE_POPPIANO_30\"},{\"start\":\"02:26:47\",\"title\":\"Retro Talk - Auf ein Wort\"},{\"start\":\"02:27:12\",\"title\":\"Retro Talk -  Bonnadinho - Magazine aus dem Ausland\"},{\"start\":\"02:43:27\",\"title\":\"Retro Talk -  Selmar - Retro Grafik\"},{\"start\":\"03:00:33\",\"title\":\"Retro Talk -  Brotbox64 - Amiga Part 3\"},{\"start\":\"03:10:08\",\"title\":\"Retro Talk -  Klaus Sommer - Kultmags.com\"},{\"start\":\"03:37:02\",\"title\":\"Retro Talk - das Interview Carsten Borgmeier\"},{\"start\":\"04:55:27\",\"title\":\"PAUSENMUSIK_HI_FREAK_PUNK_EDIT_30\"},{\"start\":\"04:56:28\",\"title\":\"Retro Mysteries - R\\u00e4tsel aus der Vergangenheit\"},{\"start\":\"05:07:16\",\"title\":\"Selmar im Quiz\"},{\"start\":\"05:18:58\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"05:30:16\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"05:40:34\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2017-02-11_retrokompott_-_032_-_spielezeitschriften_part1.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        <br />\n<a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2017-02-11_retrokompott_-_032_-_spielezeitschriften_part1.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 32</a></p>\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<hr />\n<p>Aufnahmedatum: 09.02.2017 &amp; 10.02.2017<br />\nmit Patrick, Robin, Selmar &amp; Fabskimo<br />\nsowie Bonnadinho bei den Retro Mysteries<br />\nDauer: 05:43:37</p>\n<div id=\"magicdomid8\">\n<div>\n<hr />\n</div>\n<div></div>\n<div>\n<p>Selmar:<br />\nHallo Freaks!</p>\n<p>Fabskimo:<br />\nWas ist denn mit dem los ?</p>\n<p>Patrick:<br />\nder hat zu viel  Happy Computer gelesen</p>\n<p>Selmar:<br />\ndie Zeit ist reif fuer ein neues Magazin</p>\n</div>\n<div></div>\n</div>\n<div>\n<div id=\"magicdomid6\">\n<div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<hr />\n<div id=\"magicdomid651\">\n<h2><span style=\"text-decoration: underline;\"><strong>Ihr wollt beim Retrokompott mitmachen?</strong></span></h2>\n<p>&nbsp;</p>\n</div>\n<h3>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a>,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzecichnung<br />\ndes naechsten Themas als erstes!</h3>\n<div> Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</div>\n<div>\n<p>An unser Verlosung nimmt jeder teil, der uns einen Audiokommentar fuer die Retrotalk Rubrik schickt<br />\nund den Vermerk Verlsoung + eigene Adresse mit angibt.<br />\nPatreon Unterstuetzer koennen auch<br />\nohne Audiokommentar an der Verlosung teilnehmen.</p>\n</div>\n</div>\n</div>\n<div id=\"magicdomid10\">\n<div>\n<div></div>\n<div>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></div>\n<div></div>\n<div>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unser <a href=\"http://www.retrokompott.de\">Homepage</a>.<br />\nUnser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR</a></div>\n<div>\n<p>Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abbonieren.</p>\n</div>\n<div></div>\n</div>\n</div>\n<hr />\n<div></div>\n<div id=\"magicdomid92\">Die Links und weiterfuehrenden Infos zum Podcast:</div>\n</div>\n<div></div>\n<div>Gewinner der Verlosung: Phillip</div>\n<div></div>\n<p><a href=\"http://www.kultpower.de\">www.kultpower.de</a></p>\n<p>(vor allem Happy Computer, Power Play, Telematch)</p>\n<p><a href=\"http://www.kultboy.de\">www.kultboy.de</a><br />\n(einzelne Testberichte unter anderem aus HC, PP,ASM,<br />\nAmiga Joker)</p>\n<p><a href=\"http://www.archive.org\">www.archive.or</a></p>\n<p>(z.B. PC Player, 64er / 128er, ASM)</p>\n<p><a href=\"http://www.kultmags.com\">www.kultmags.co</a></p>\n</div>\n<div>\n<p>(z.B. PC Games, Mega Fun, Maniac)</p>\n<p>Die augenblickliche &#8222;Highscore Liste&#8220; der Retro Mysteries:</p>\n<p>Stufe 9:<br />\nSelmar</p>\n<p>Stufe 8:<br />\nRobin</p>\n<p>Stufe 7:<br />\nAlexander, Fabskimo</p>\n</div>\n<div></div>\n</div>\n<p><a href=\"http://www.gamersglobal.de/news/125655/podcast-retrokompott-folge-31-c64-vertikalshooter\"><i>http://www.gamersglobal.de/news/125655/podcast-retrokompott-folge-31-c64-vertikalshooter</i></a><br />\n<a href=\"http://www.letsplaysega.com/play-outrun-online/\"><i>http://www.letsplaysega.com/play-outrun-online/</i></a></p>\n<p><i> </i><a href=\"http://chordian.net/2017/01/09/my-computer-chronicles-part-1/\"><i>http://chordian.net/2017/01/09/my-computer-chronicles-part-1/</i></a><br />\n<a href=\"http://www.indieretronews.com/2016/01/bomb-jack-dx-c64-c64-classic-overhauled.html\"><i>http://www.indieretronews.com/2016/01/bomb-jack-dx-c64-c64-classic-overhauled.html</i></a><br />\n<a href=\"http://www.actsofgord.com\"><i>www.actsofgord.com</i></a><br />\n<a href=\"https://www.heise.de/newsticker/meldung/8-Bit-Civilizations-Neues-4X-Strategiespiel-fuer-den-C64-3611100.html\"><i>https://www.heise.de/newsticker/meldung/8-Bit-Civilizations-Neues-4X-Strategiespiel-fuer-den-C64-3611100.html</i></a><br />\n<a href=\"https://www.golem.de/news/cpu-koennten-hirnforscher-einen-c64-verstehen-1701-125738.html\">https://www.golem.de/news/cpu-koennten-hirnforscher-einen-c64-verstehen-1701-125738.html</a><br />\n<a href=\"https://www.youtube.com/watch?v=QeOdo2ee6GQ\">https://www.youtube.com/watch?v=QeOdo2ee6GQ</a><br />\n<a href=\"https://curved.de/news/nintendo-classic-mini-auf-speed-das-analogue-nt-mini-kommt-455755\">https://curved.de/news/nintendo-classic-mini-auf-speed-das-analogue-nt-mini-kommt-455755</a></p>\n</div>\n<div></div>\n<div><a href=\"http://www.ndr.de/ndrkultur/sendungen/kulturforum/Pixeltunes-Vom-Sound-der-Spiele,sendung575600.html\">http://www.ndr.de/ndrkultur/sendungen/kulturforum/Pixeltunes-Vom-Sound-der-Spiele,sendung575600.html</a><br />\n<a href=\"http://www1.wdr.de/radio/wdr3/programm/sendungen/wdr3-hoerspiel/pixeltunes-102.html\">http://www1.wdr.de/radio/wdr3/programm/sendungen/wdr3-hoerspiel/pixeltunes-102.html</a><br />\n<a href=\"https://www.welt.de/wirtschaft/webwelt/article161866802/Amiga-und-C64-finden-immer-noch-neue-Fans.html\">https://www.welt.de/wirtschaft/webwelt/article161866802/Amiga-und-C64-finden-immer-noch-neue-Fans.html</a></div>\n</div>\n<div style=\"text-align: center;\">\n<p>&#8212;&#8212;&#8212;&#8211;</p>\n</div>\n<div id=\"magicdomid510\">\n<div style=\"text-align: center;\">\n<p>Naechste Sendung:</p>\n<p>Sonderaktion: 18.02.2017 Teilname bei Night of the Pods</p>\n</div>\n<div style=\"text-align: center;\">\n<p> LIVE:  24.02.2017. 22:00 Uhr<br />\n(Thema als Aufzeichnung vorausichtlich ab 20:00 Uhr)</p>\n<p>Thema: Spielezeitschriften Teil 2</p>\n</div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\">weitere Infos demnaechst hier.</div>\n<div style=\"text-align: center;\">LIVE auf mixlr.com/retrokompott</div>\n</div>\n",
