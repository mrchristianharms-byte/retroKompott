,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 064 - Sega Saturn Part II\",\"subtitle\":null,\"summary\":null,\"duration\":\"6:43:41\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:00:59\",\"title\":\"Vierzeiler\"},{\"start\":\"00:01:11\",\"title\":\"Titelmusik\"},{\"start\":\"00:02:28\",\"title\":\"Heute sind mit dabei   \"},{\"start\":\"00:02:39\",\"title\":\"Retro Warm Up - auf in eine neue Runde    \"},{\"start\":\"00:14:21\",\"title\":\"Teaser Patreon Formate\"},{\"start\":\"00:48:48\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"00:57:58\",\"title\":\"Retro Facts: Sega Saturn Part II\"},{\"start\":\"02:05:09\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"02:06:19\",\"title\":\"Retro Play - das Resume Seaside Special C64\"},{\"start\":\"02:13:47\",\"title\":\"Retro Play - Was sollen wir spielen? Freds Back C64\"},{\"start\":\"02:16:28\",\"title\":\"Retro Talk - Kay aus Leipzig\"},{\"start\":\"02:27:33\",\"title\":\"Retro Talk - Lange Nacht der Computerspiele Leipzig\"},{\"start\":\"03:10:23\",\"title\":\"Retro Talk - Retrotalk Berber6677 Ready Player One BUCH\"},{\"start\":\"03:17:29\",\"title\":\"Retro Talk - Axel Skurrile Hardware\"},{\"start\":\"03:21:09\",\"title\":\"Retro Talk - rauschende Urlaubsgruesse retrodim\"},{\"start\":\"04:09:16\",\"title\":\"Retro Talk - Interview Rebecca Ann Heineman\"},{\"start\":\"05:24:12\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"05:25:01\",\"title\":\"Retro Mysteries SoundQuiz \"},{\"start\":\"05:38:08\",\"title\":\"Retro Mysteries Quiz mit Christian\"},{\"start\":\"06:11:29\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"06:33:13\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"06:40:40\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2018-04-29_retrokompott_-_064_-_sega_saturn_part_2.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        </p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">HELFT UNS DIE REGELMESSIGE AUSSTRAHLUNG UND ZUKUNFT DES PODCASTS ZU SICHERN UND UNTERSTUETZT UNS<br />\nAUF <a href=\"http://www.patreon.com/retrokompott\">PATREON</a> ODER <a href=\"http://paypal.me/retrokompott\">PAYPAL</a><br />\nVIELEN DANK!</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Patrick:</p>\n<p style=\"text-align: center;\">Auf der langen Nacht der Museen habe ich Serious Sam vermisst</p>\n<p style=\"text-align: center;\">Fabskimo:</p>\n<p style=\"text-align: center;\">Wovon redet er da ?</p>\n<p style=\"text-align: center;\">Robin:</p>\n<p style=\"text-align: center;\">Er meint die lange Nacht der Spiele und Sams Journey.</p>\n<p style=\"text-align: center;\">Oliver:</p>\n<p style=\"text-align: center;\">&#8230;Ohgott, die Retro-Demenz. Aber den Podcast schneiden kann er noch oder ?</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-04-29_retrokompott_-_064_-_sega_saturn_part_2.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 64</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.patreon.com/posts/nachlese-zur-64-18469047\">N64</a> 27.04.2018 0h25min   Nachlese Folge 64   <a href=\"https://www.patreon.com/posts/nachlese-zur-64-18469047\">fuer Patreonen</a></p>\n</div>\n<p style=\"text-align: center;\">mit Patrick, Robin, Fabskimo, Oliver</p>\n<p style=\"text-align: center;\">und als Themenexperten Selmar, Andreas, Oliver</p>\n<p style=\"text-align: center;\">(Aufnahmedatum des Themas: 15.03.2018)</p>\n<p style=\"text-align: center;\">Dauer: 6h44</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Die naechsten LIVE Termine auf <a href=\"http://www.mixlr.com/retrokompott\">www.mixlr.com/retrokompott</a><br />\ngebe wir zeitnah hier bekannt.</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Ihr wollt beim Retrokompott mitmachen?</p>\n<div style=\"text-align: center;\">\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a><br />\noder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzeichnung<br />\ndes naechsten Themas als erstes!</p>\n<p>ab 3$ im Monat &#8222;Robins Retro Woche&#8220; (<a href=\"https://www.patreon.com/posts/robins-retro-17866073\">aktuelle Folge</a>)<br />\nund demnaechst: &#8222;Patrick am Pranger&#8220;</p>\n<hr />\n<hr />\n<p>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</p>\n<p>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></p>\n</div>\n<div>\n<div>\n<p>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</p>\n<p>&nbsp;</p>\n<div>\n<hr />\n</div>\n</div>\n<hr />\n<p>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</p>\n</div>\n</div>\n</div>\n<p>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</p>\n<div>\n<hr />\n<hr />\n<p>Werbung in eigener Sache:</p>\n</div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken</a></p>\n<p>&nbsp;</p>\n</div>\n</div>\n<hr />\n<hr />\n<p>Die Links und weiterfuehrenden Infos zum Podcast:</p>\n</div>\n</div>\n<p style=\"text-align: center;\">Die Musik fuer diese Folge stammt von Bug of NCI<br />\nausser es wurde anders erwaehnt. Saemtliche Musik ist gemafrei.</p>\n<p style=\"text-align: center;\">dolbyfied musik</p>\n<p style=\"text-align: center;\"><a href=\"https://www.youtube.com/channel/UCJKt_QVDyUbqdm3ag_py2eQ\">https://www.youtube.com/channel/UCJKt_QVDyUbqdm3ag_py2eQ</a></p>\n<p style=\"text-align: center;\">retrokram</p>\n<p style=\"text-align: center;\"><a href=\"http://retro.wtf/\">http://retro.wtf/</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.pcwelt.de/ratgeber/30-Jahre-C64-wieder-aufgebaut-und-ausprobiert-6467579.html\">https://www.pcwelt.de/ratgeber/30-Jahre-C64-wieder-aufgebaut-und-ausprobiert-6467579.html</a></p>\n<p style=\"text-align: center;\"><a href=\"https://freeze64.com/c64mini-hacks/\">https://freeze64.com/c64mini-hacks/</a></p>\n<p style=\"text-align: center;\"><a href=\"https://ideas.lego.com/projects/e8415d1c-961a-489b-b035-2de27490761d\">https://ideas.lego.com/projects/e8415d1c-961a-489b-b035-2de27490761d</a></p>\n<p style=\"text-align: center;\"><a href=\"http://gamenewz.de/snk-kommt-ein-neo-geo-mini/\">http://gamenewz.de/snk-kommt-ein-neo-geo-mini/</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.mobiflip.de/sega-mega-drive-mini/\">https://www.mobiflip.de/sega-mega-drive-mini/</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.retromagazine.eu/retro/2018-04/teletext-am-c64-norbert-kehrer-retropulsiv-11-0-augsburg/\">http://www.retromagazine.eu/retro/2018-04/teletext-am-c64-norbert-kehrer-retropulsiv-11-0-augsburg/</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.zeit.de/digital/games/2018-04/donkey-kong-billy-mitchell-games-rekorde-aberkannt\">http://www.zeit.de/digital/games/2018-04/donkey-kong-billy-mitchell-games-rekorde-aberkannt</a></p>\n<p style=\"text-align: center;\"><a href=\"http://magazinesfromthepast.wikia.com/wiki/Magazines_from_the_Past_Wiki\">http://magazinesfromthepast.wikia.com/wiki/Magazines_from_the_Past_Wiki</a></p>\n<div style=\"text-align: center;\">\n<hr />\n</div>\n<div id=\"magicdomid510\">\n<hr />\n<p style=\"text-align: center;\">Naechste Rahmenprogrammaufzeichnung:</p>\n<p style=\"text-align: center;\">LIVE:  demnaechst<br />\nLIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a></p>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></p>\n<p style=\"text-align: center;\">weitere Infos in der Textdatei.<br />\nDiese wird regelmaessig aktualisiert,<br />\nes kommen auch noch C64 &amp; Konsolenspiele dazu.</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">\n</div>\n",
