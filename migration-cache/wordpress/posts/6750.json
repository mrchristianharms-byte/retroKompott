\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        \r\n<!-- /wp:post-content -->\r\n\r\n<!-- wp:separator --><hr class=\"wp-block-separator\" /><!-- /wp:separator -->\r\n\r\n<!-- wp:separator -->\r\n<p><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS-FEED</a> <a href=\"https://discord.gg/T7NQzF2WRK\">Discord</a> <a href=\"http://www.patreon.com/retrokompott\">PATREON</a> <a href=\"https://steadyhq.com/de/retrokompott\">STEADY</a> <a href=\"http://paypal.me/retrokompott\">PAYPAL</a> <a href=\"https://www.youtube.com/channel/UC3n_WXlK-BlcGAJOMMV2vaQ\">YOUTUBE</a> <a href=\"https://www.twitch.tv/retro_kompott\">TWITCH</a> <a href=\"https://www.facebook.com/retrokompott/\">Facebook</a> <a href=\"https://twitter.com/retrokompott/\">Twitter</a> <a href=\"https://www.instagram.com/retrokompott/\">Instagramm</a></p>\r\n<!-- wp:separator --><hr class=\"wp-block-separator\" /><!-- /wp:separator -->\r\n\r\n<!-- wp:separator -->\r\n<p><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2024-10-14_retrokompott_-_232_-_sealteam.mp3?\">Download von Folge 232</a></p>\r\n<!-- /wp:separator -->\r\n\r\n<!-- wp:paragraph -->\r\n<pre>mit Patrick &amp; Robin</pre>\r\n<pre>Themenexperten:</pre>\r\n<pre>Alexander &amp; Selmar</pre>\r\n<pre>Dauer: 4:23 min</pre>\r\n<hr />\r\n<p><b>Shownotes:</b></p>\r\n<pre><b>allgemeine Podcast Infos:</b></pre>\r\n<pre>Jeden Mittwoch gibt es um 20:15 eine <a href=\"http://www.retrolagerfeuer.de\">Big Box Verkaufsshow</a> auf Twitch\r\n(am ersten Mittwoxch im Monat das Retro Bingo), \r\njeden Donnerstag ab 20 Uhr gibt es den <a href=\"https://blog.retrokompott.de/live-video-stammtisch/\"> LIVE VIDEO STAMMTISCH</a>, \r\njeden Freitag ab 21 Uhr den <a href=\"https://blog.retrokompott.de/01-stammtisch/\"> LIVE AUDIO STAMMTISCH auf Teamspeak</a>.\r\n\r\nUnseren Retro Spiele Club, unser bespielbares Museum in Hamburg Horn \r\nfindet ihr auf <a href=\"http://www.retrospieleclub.de\">www.retrospieleclub.de</a>. \r\n\r\nFuer weitere Infos nutzt gerne unseren Newsletter \r\n(<a href=\"http://www.retrospieleclub.de/newsletter/\">http://www.retrospieleclub.de/newsletter/</a>).\r\n\r\n<b>Inhalt &amp; Zeitmarken:\r\n</b></pre>\r\n<pre>00:00:00 Vorspann und Danksagungen\r\n00:01:32 Heute sind mit dabei\r\n00:01:41 Titelmusik\r\n00:03:03 Retro Warm Up - auf in eine neue Runde\r\n00:18:39 Werbung (Dragonbox Shop)\r\n00:20:37 Retro Facts: Seal Team\r\n02:03:31 Einspieler: Werbung in eigener Sache\r\n02:05:20 Musik: Chris Huelsbeck - Embrace The Moment (Royalty Free)\r\n02:09:14 Quiz Classics mit Christian (inkl. Hoererfrage)\r\n02:33:34 Retro Talk - Interview mit Colin Porch\r\n03:19:28 Musik: Komiku - Poupi on a Scooter (Public Domain)\r\n03:27:04 Retro Play - Was haben wir gespielt?\r\n03:42:49 Retro News - Neues aus der Szene\r\n03:59:49 Musik: Pixelwelt der Liebe (Pixelliebe) Udio KI/P. Becher\r\n04:02:15 Retro Talk - Neu i. d. Sammlung - Wizard of Oz (Christian H.)\r\n04:09:43 Einspieler: Unser Retro Spiele Museum\r\n04:10:32 Retro Credits - Kurz vor Schluss\r\n04:19:50 Abspann\r\n\r\nDauer: 04:23:01</pre>\r\n<pre>HELFT UNS, DIE REGELMAESSIGE AUSSTRAHLUNG UND ZUKUNFT DES PODCASTS ZU SICHERN\r\nUND UNTERSTUETZT UNS AUF<a href=\"http://www.patreon.com/retrokompott\"> PATREON</a>,  ODER<a href=\"http://paypal.me/retrokompott\"> PAYPAL.</a> \r\nZugang zu unserer internen WhatsApp Gruppe erhalten Unterstuetzer automatisch.</pre>\r\n<pre><b>Die gespielten Spiele der Teilnehmer:</b><b> </b></pre>\r\n<pre><strong>Das besondere Spiel:</strong></pre>\r\n<pre>Patrick: Pinball Fantasies mit Controller\r\nRobin: Indiana Jones 3 and the last Crusade\r\n\r\n<strong>… und der Rest:</strong></pre>\r\n<pre>Patrick: Menace\r\nRobin: Monkey Island, Rogue, Pinball Dreams, Fantasies usw.</pre>\r\n<p><strong>Die Links aus den News: </strong></p>\r\n<pre><a href=\"https://www.pcgamer.com/hardware/doom-will-run-on-a-literal-potato-but-apparently-quantum-computers-still-arent-powerful-enough-to-run-even-this-wireframe-version-natively/\"><b>https://www.pcgamer.com/hardware/doom-</b>will-run-on-a-literal-potato-but-apparently-quantum-computers-still-arent-powerful-enough-to-run-even-this-wireframe-version-natively/</a> \r\n<a href=\"https://mein-mmo.de/leistungsstaerkste-quantencomputer-nicht-doom-spielen/\">https://mein-mmo.de/leistungsstaerkste-quantencomputer-nicht-doom-spielen/</a>\r\n<a href=\"https://mynintendonews.com/2024/08/09/limited-run-games-announces-upgraded-doom-cartridge-for-snes/\">https://mynintendonews.com/2024/08/09/limited-run-games-announces-upgraded-doom-cartridge-for-snes/</a>\r\n<a href=\"https://doom.fandom.com/wiki/Super_NES\">https://doom.fandom.com/wiki/Super_NES</a>\r\n<a href=\"https://www.pcgames.de/Nintendo-Firma-15624/News/letzter-grosser-switch-emulator-ist-offiziell-tot-1456963/\">https://www.pcgames.de/Nintendo-Firma-15624/News/letzter-grosser-switch-emulator-ist-offiziell-tot-1456963/</a></pre>\r\n<pre><strong>\r\nDiscord</strong></pre>\r\n<pre><a href=\"https://www.gamersglobal.de/news/301906/retro-gamer-japandoku-auf-der-polaris-2024-11-1310\">https://www.gamersglobal.de/news/301906/retro-gamer-japandoku-auf-der-polaris-2024-11-1310</a>\r\n<a href=\"https://www.cartreader.net/\">https://www.cartreader.net/</a>\r\n<a href=\"https://youtu.be/fXhbti5SneE?t=4839\">https://youtu.be/fXhbti5SneE?t=4839</a>\r\n<a href=\"https://www.youtube.com\">YouTube</a>\r\n<a href=\"https://www.youtube.com/channel/UCBOLXG6Zk441DgVNno9GGqQ\">Michael Khanh (dogplayingtetris)</a>\r\n<a href=\"https://www.youtube.com/watch?v=fXhbti5SneE&amp;start=4839\">First Ever REBIRTH in NES Tetris</a>\r\n<a href=\"https://www.nytimes.com/2024/10/09/science/nobel-prize-chemistry.html?smid=nytcore-ios-share&amp;referringSource=articleShare\">https://www.nytimes.com/2024/10/09/science/nobel-prize-chemistry.html?smid=nytcore-ios-share&amp;referringSource=articleShare</a>\r\n<a href=\"https://www.youtube.com/@piotoor_dev2579\">https://www.youtube.com/@piotoor_dev2579</a>\r\n<a href=\"https://mein-mmo.de/mark-zuckerberg-civilization-twitch-streams/\">https://mein-mmo.de/mark-zuckerberg-civilization-twitch-streams/</a> \r\n<a href=\"http://brutmanlabs.org/\">http://brutmanlabs.org/</a>\r\n<a href=\"https://www.gamersglobal.de/text-gallery/302171/portland-retro-gaming-expo-2024-prge\">https://www.gamersglobal.de/text-gallery/302171/portland-retro-gaming-expo-2024-prge</a>\r\n<strong>\r\nLizenzen &amp; Werbung:</strong></pre>\r\n<pre><strong>Musik Lizenzen:</strong></pre>\r\n<pre>\"Titel, Rubriken &amp; Abspannmusik\"\r\n(Patrick Becher, lizenziert f\"Titel, Rubriken &amp; Abspannmusik\"\r\n(Patrick Becher, lizenziert fuer den Retrokompott und seine Projekte, gemafrei)\r\n\r\n\" Pixelwelt der Liebe (Pixelliebe)\"\r\nUdio KI/Patrick Becher\r\n\r\n\"Retro Quiz Title\"\r\n(Christian Ohrens, mit Genehmigung des Urhebers, uneingeschraenktes Nutzungsrecht fuer den Retrokompott und seine Projekte, Instrumente:. Impact Soundworks \"Super Audio Card\" sowie ReFx \"Nexus 4\"=\r\n\r\n\"Komiku - Poupi on a Scooter\"\r\nKomiku (Public Domain)\r\n\r\n\"Embrace The Moment\"\r\nby Chris Huelsbeck, used under a royalty-free license,\r\nvisit <a href=\"http://www.patreon.com/chris_huelsbeck\">www.patreon.com/chris_huelsbeck</a> for infos</pre>\r\n<pre>Wir danken unserem Werbepartner fuer die Themenrubrik,\r\nDragonbox (<a href=\"https://dragonbox.de/de/\">https://dragonbox.de/de/</a>)\r\n<b>Kontaktmoeglichkeiten &amp; Infoseiten:\r\n\r\nIhr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren \r\nRetro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten? \r\nPer Mail erreicht man uns unter mail@retrokompott.de Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, \r\nauf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>, oder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>. Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</b>\r\n\r\n<a href=\"http://www.retrospieleclub.de\">www.retrospieleclub.de</a> (unser Museum in Hamburg)\r\n<a href=\"http://www.retrokompott.de\">www.retrokompott.de</a> (unser Podcast)\r\n<a href=\"https://www.twitch.tv/retro_kompott\">https://www.twitch.tv/retro_kompott</a> (unser Twitch Kanal, hier senden wir die Gala LIVE)\r\n<a href=\"https://www.youtube.com/channel/UC3n_WXlK-BlcGAJOMMV2vaQ\">https://www.youtube.com/channel/UC3n_WXlK-BlcGAJOMMV2vaQ</a> (unser Youtube Archiv)\r\n<a href=\"http://facebook.com/retrospieleclub\">facebook.com/retrospieleclub</a> (unser Museum auf Facebook)\r\n<a href=\"https://www.facebook.com/retrokompott\">https://www.facebook.com/retrokompott</a> (unser Podcast auf Facebook)\r\n<a href=\"http://twitter.com/retrokompott\">twitter.com/retrokompott</a> (unser Twitter Account)\r\n<a href=\"http://instagram.com/retrokompott\">instagram.com/retrokompott</a> (Instagram)\r\n<a href=\"http://patreon.com/retrokompott\">patreon.com/retrokompott</a> (Patreon)\r\n<a href=\"http://steadyhq.com/retrokompott\">steadyhq.com/retrokompott </a>(Steady)\r\n<a href=\"https://discord.gg/T7NQzF2WRK\">https://discord.gg/T7NQzF2WRK</a> (Discord)\r\n<a href=\"https://www.paypal.me/retrokompott\">https://www.paypal.me/retrokompott</a> (Spendenlink fuer Projekte)\r\n\r\nDer Retrokompott Podcast ist eine Produktion der Fa. Com Illusion Gbr., Abt. Medienpublikation, \r\nweitere Informationen findet man hier: \r\n<a href=\"https://blog.retrokompott.de/impressum/\">https://blog.retrokompott.de/impressum/</a>, \r\n<a href=\"https://blog.retrokompott.de/datenschutz/\">https://blog.retrokompott.de/datenschutz/</a>.\r\n\r\n</pre>\r\n<pre><b>Viel Spass wuenscht das Retrokompott Team.</b></pre>\r\n<pre>#Folge #Zeitreise #Homecomputer #Spielekonsolen #Games #Retrokompott #Podcast #C64\r\n#Sealteam #PrettyOldPixel  #AMIGA #MSDOS #commodore #ColinPorch #patreon #steady #Live  \r\n#retrospieleclub #quiz #Polaris</pre>\r\n<p>&nbsp;</p>\r\n<hr class=\"wp-block-separator\" /><!-- /wp:paragraph -->\r\n\r\n<!-- wp:separator /--><!-- /wp:separator -->",
