,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 072 - franzoesische Spiele Part I\",\"subtitle\":null,\"summary\":null,\"duration\":\"5:15:09\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:01:18\",\"title\":\"Vierzeiler\"},{\"start\":\"00:01:33\",\"title\":\"Titelmusik\"},{\"start\":\"00:02:51\",\"title\":\"Heute sind mit dabei   \"},{\"start\":\"00:03:02\",\"title\":\"Retro Warm Up - auf in eine neue Runde  \"},{\"start\":\"00:15:50\",\"title\":\"Einspieler von Andreas  \"},{\"start\":\"00:22:36\",\"title\":\"Retro Facts: Franzoesische Spiele PART I\"},{\"start\":\"02:04:41\",\"title\":\"Pausenmusik - Chris Huelsbeck - Joshua Tree Windstorm\"},{\"start\":\"02:08:32\",\"title\":\"Retro Mysteries - Niels vom Retrozirkel\"},{\"start\":\"02:39:17\",\"title\":\"Retro Talk - Interview Constantin Gillies\"},{\"start\":\"03:23:26\",\"title\":\"Pausenmusik - Chris Huelsbeck - 4 Visions of Tyrell\"},{\"start\":\"03:27:22\",\"title\":\"Retro Play - das Resume Mercs C64\"},{\"start\":\"03:38:30\",\"title\":\"Retro Play - Was sollen wir spielen? Speedking C64\"},{\"start\":\"03:40:17\",\"title\":\"Retro Talk - Teaser Retro Rollenspiel\"},{\"start\":\"03:43:14\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"04:44:21\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"05:01:12\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"05:12:05\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2018-08-18_retrokompott_-_072_-_franzoesische_spiele_teil1.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        </p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">HELFT UNS DIE REGELMESSIGE AUSSTRAHLUNG UND ZUKUNFT DES PODCASTS ZU SICHERN UND UNTERSTUETZT UNS<br />\nAUF <a href=\"http://www.patreon.com/retrokompott\">PATREON</a>, <a href=\"https://steadyhq.com/de/retrokompott\">STEADY</a> ODER <a href=\"http://paypal.me/retrokompott\">PAYPAL</a> (hier gibt es <a href=\"https://blog.retrokompott.de/you-tube-videos/\">BONUS VIDEOS</a> freizuschalten)</p>\n<p style=\"text-align: center;\">weitere Infos in diesem <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-06-10_retrokompott_patreon_special_001.mp3?\">PATREON Special Podcast</a></p>\n<p style=\"text-align: center;\">Merchandise Artikel gibt es ab jetzt auch im Shop:<br />\n<a href=\"https://shop.spreadshirt.de/retrokompott\">RETROKOMPOTT MERCHANDISE</a></p>\n<hr />\n<hr />\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<p><a href=\"https://blog.retrokompott.de/wp-content/uploads/2018/08/folgenbild_72Franz1.jpg\"><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-2430\" src=\"https://blog.retrokompott.de/wp-content/uploads/2018/08/folgenbild_72Franz1.jpg\" alt=\"\" width=\"1440\" height=\"1440\" srcset=\"https://blog.retrokompott.de/wp-content/uploads/2018/08/folgenbild_72Franz1.jpg 1440w, https://blog.retrokompott.de/wp-content/uploads/2018/08/folgenbild_72Franz1-150x150.jpg 150w, https://blog.retrokompott.de/wp-content/uploads/2018/08/folgenbild_72Franz1-300x300.jpg 300w, https://blog.retrokompott.de/wp-content/uploads/2018/08/folgenbild_72Franz1-768x768.jpg 768w, https://blog.retrokompott.de/wp-content/uploads/2018/08/folgenbild_72Franz1-1024x1024.jpg 1024w, https://blog.retrokompott.de/wp-content/uploads/2018/08/folgenbild_72Franz1-144x144.jpg 144w\" sizes=\"auto, (max-width: 1440px) 100vw, 1440px\" /></a></p>\n<p>&nbsp;</p>\n<p>Robin:<br />\nHeute machen wir es franzoesisch, und Fabskimo sitzt schon neben mir bereit.</p>\n<p>Fabskimo:<br />\n&#8230; endlich mal wieder Erotik beim Retrokompott</p>\n<p>Oliver:<br />\n&#8230;woran Fab schon wieder denkt&#8230;</p>\n<p>Patrick:<br />\nIch denke an den Eiffelturm, frische Baguettes und die Liebe</p>\n<p>Robin:<br />\n&#8230; und am Ende reden sie doch wieder nur ueber Spiele…..</p>\n<p>&nbsp;</p>\n<hr />\n<hr />\n<p><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-08-18_retrokompott_-_072_-_franzoesische_spiele_teil1.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 72</a></p>\n<p><a href=\"https://www.patreon.com/posts/nachlese-zur-72-20828078\">N72</a> 17.08.2018 0h42 min   Nachlese Folge 72   <a href=\"https://www.patreon.com/posts/nachlese-zur-72-20828078\">fuer Patreonen</a></p>\n</div>\n<p style=\"text-align: center;\">mit Patrick, Robin, Fabskimo, Oliver &amp; Andreas</p>\n<p style=\"text-align: center;\">und als Themenexperten Oliver &amp; Robin</p>\n<p style=\"text-align: center;\">(Aufnahmedatum des Themas: 31.07.2018</p>\n<p style=\"text-align: center;\">Dauer: 5h15</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Die naechsten LIVE Termine auf <a href=\"http://www.mixlr.com/retrokompott\">www.mixlr.com/retrokompott:</a></p>\n<p style=\"text-align: center;\">21.08.2018 22:xx evtl. Retro Talk Rollenspiel<br />\n31.08.2018 22:00 Aufzeichnung Rahmenprogramm franz. Spiele II</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Ihr wollt beim Retrokompott mitmachen?</p>\n<div style=\"text-align: center;\">\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON,</a> <a href=\"https://steadyhq.com/de/retrokompott\">STEADY</a><br />\noder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL<br />\n(als Belohnung schalten wir <a href=\"https://blog.retrokompott.de/you-tube-videos/\">Videos</a> frei),<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzeichnung<br />\ndes naechsten Themas als erstes!</p>\n<p>ab 3$ im Monat<br />\n&#8222;Robins Retro Woche&#8220; (<a href=\"https://www.patreon.com/posts/robins-retro-12-20718055\">aktuelle Folge 12</a>)<br />\n&#8222;Patrick am Pranger&#8220; (<a href=\"https://www.patreon.com/posts/patrick-am-folge-20828108\">aktuelle Folge 11</a>)</p>\n<hr />\n<hr />\n<p>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</p>\n<p>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></p>\n</div>\n<div>\n<div>\n<p>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</p>\n<p>&nbsp;</p>\n<div>\n<hr />\n</div>\n</div>\n<hr />\n<p>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</p>\n</div>\n</div>\n</div>\n<p>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</p>\n<div>\n<hr />\n<hr />\n<p>Werbung in eigener Sache:</p>\n</div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken</a></p>\n<p>&nbsp;</p>\n</div>\n</div>\n<hr />\n<hr />\n<p>Die Links und weiterfuehrenden Infos zum Podcast:</p>\n</div>\n</div>\n<p style=\"text-align: center;\">Die Musiken fuer diese Folge stammen von Chris Huelsbeck:</p>\n<p style=\"text-align: center;\"><b>Chris Huelsbeck &#8211; Royalty-Free Music Vol. 1<br />\n</b></p>\n<p style=\"text-align: center;\">Joshua Tree Windstorm<br />\nVisions of Tyrell</p>\n<p style=\"text-align: center;\"><b>Music titles by Chris Huelsbeck, used under a royalty-free license, please visit</b><a href=\"https://www.patreon.com/chris_huelsbeck\"> <b>www.patreon.com/chris_huelsbeck</b></a><b> for more info!</b></p>\n<p style=\"text-align: center;\">Saemtliche Musik ist gemafrei.</p>\n<hr />\n<p style=\"text-align: center;\">Die weiterfuehrendne Links:</p>\n<p style=\"text-align: center;\"><a href=\"https://www.gamestar.de/artikel/hakenkreuze-in-videospielen-usk-hebt-generelles-verbot-in-videospielen-auf,3333259.html\">https://www.gamestar.de/artikel/hakenkreuze-in-videospielen-usk-hebt-generelles-verbot-in-videospielen-auf,3333259.html</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.usk.de/service/presse/details-zum-presseartikel/article/erstes-spiel-unter-beruecksichtigung-der-sozialadaequanz-gekennzeichnet/\">http://www.usk.de/service/presse/details-zum-presseartikel/article/erstes-spiel-unter-beruecksichtigung-der-sozialadaequanz-gekennzeichnet/</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.pocketgamer.biz/asia/news/68736/sociable-soccer-dev-tower-studios-snags-china-publishing-deal-with-china-mobile/\">https://www.pocketgamer.biz/asia/news/68736/sociable-soccer-dev-tower-studios-snags-china-publishing-deal-with-china-mobile/</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.areamobile.de/news/48074-disketten-laufwerk-am-smartphone-weil-es-geht\">http://www.areamobile.de/news/48074-disketten-laufwerk-am-smartphone-weil-es-geht</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.youtube.com/watch?v=V0NasncA_Cc\">https://www.youtube.com/watch?v=V0NasncA_Cc</a></p>\n<p style=\"text-align: center;\"><a href=\"https://de.ydkj.eu/\">https://de.ydkj.eu/</a></p>\n<hr />\n<div id=\"magicdomid510\">\n<p style=\"text-align: center;\">Naechste Rahmenprogrammaufzeichnung:</p>\n<p style=\"text-align: center;\">LIVE: 17.08.2018<br />\nLIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a></p>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></p>\n<p style=\"text-align: center;\">weitere Infos in der Textdatei.<br />\nDiese wird regelmaessig aktualisiert,<br />\nes kommen auch noch C64 &amp; Konsolenspiele dazu.</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">\n</div>\n",
