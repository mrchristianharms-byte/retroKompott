n    <tab name=\"transcripts\">\n      <tab-transcripts></tab-transcripts>\n    </tab>\n    <tab name=\"files\">\n      <tab-files></tab-files>\n    </tab>\n    <tab name=\"playlist\">\n      <tab-playlist></tab-playlist>\n    </tab>\n    <tab name=\"share\">\n      <tab-share></tab-share>\n    </tab>\n    <tab-overflow></tab-overflow>\n  </div>\n  <error></error>\n</root>\n</div>\n            <script>\n              document.addEventListener(\"DOMContentLoaded\", function() {\n                var player = document.getElementById(\"player-6aee478fc38a1\");\n                podlovePlayerCache.add([null, {\"url\":\"https:\\/\\/blog.retrokompott.de\\/wp-json\\/podlove-web-player\\/shortcode\\/config\\/retrokompott\\/theme\\/retrokompott\",\"data\":{\"activeTab\":\"chapters\",\"subscribe-button\":null,\"share\":{\"channels\":[\"facebook\",\"twitter\",\"whats-app\",\"linkedin\",\"pinterest\",\"xing\",\"mail\",\"link\"],\"outlet\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/share.html\",\"sharePlaytime\":true},\"related-episodes\":{\"source\":\"disabled\",\"value\":null},\"version\":5,\"theme\":{\"tokens\":{\"brand\":\"#15C0E6\",\"brandDark\":\"#235973\",\"brandDarkest\":\"#1A3A4A\",\"brandLightest\":\"#E9F1F5\",\"shadeDark\":\"#807E7C\",\"shadeBase\":\"#807E7C\",\"contrast\":\"#000\",\"alt\":\"#fff\"},\"fonts\":{\"ci\":{\"name\":\"ci\",\"family\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":800},\"regular\":{\"name\":\"regular\",\"family\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":300},\"bold\":{\"name\":\"bold\",\"family\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 068 - Sega Mega Drive PART 3\",\"subtitle\":null,\"summary\":null,\"duration\":\"6:26:01\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:01:44\",\"title\":\"Vierzeiler\"},{\"start\":\"00:02:04\",\"title\":\"Titelmusik\"},{\"start\":\"00:03:22\",\"title\":\"Heute sind mit dabei   \"},{\"start\":\"00:03:32\",\"title\":\"Retro Warm Up - auf in eine neue Runde    \"},{\"start\":\"00:44:02\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"01:05:37\",\"title\":\"Retro Facts: Sega Mega Drive PART 3\"},{\"start\":\"02:28:41\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"02:29:48\",\"title\":\"Retro Play - das Resume Slicks Codmeasters C64\"},{\"start\":\"02:37:24\",\"title\":\"Retro Play - Was sollen wir spielen? Crillion C64\"},{\"start\":\"02:40:50\",\"title\":\"Retro Talk - Fossi Gilb\"},{\"start\":\"02:59:18\",\"title\":\"Retro Talk - PoP Hacker\"},{\"start\":\"03:52:40\",\"title\":\"Retro Talk - Bernds Retroerinnerungen\"},{\"start\":\"04:07:15\",\"title\":\"Retro Talk - Interview Wolfgang Walk\"},{\"start\":\"05:14:11\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"05:15:19\",\"title\":\"Retro Mysteries SoundQuiz \"},{\"start\":\"05:30:27\",\"title\":\"Retro Mysteries Quiz mit Constantin Gillies\"},{\"start\":\"05:57:41\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"06:15:40\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"06:22:56\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2018-06-23_retrokompott_-_068_-_sega_mega_drive_part3.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        </p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">HELFT UNS DIE REGELMESSIGE AUSSTRAHLUNG UND ZUKUNFT DES PODCASTS ZU SICHERN UND UNTERSTUETZT UNS<br />\nAUF <a href=\"http://www.patreon.com/retrokompott\">PATREON</a> ODER <a href=\"http://paypal.me/retrokompott\">PAYPAL</a></p>\n<p style=\"text-align: center;\">weitere Infos in diesem <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-06-10_retrokompott_patreon_special_001.mp3?\">PATREON Special Podcast</a></p>\n<hr />\n<hr />\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<p>Oliver:    Stimmt es, dass Patrick heute extra nach Berlin gefahren ist, um dafuer zu sorgen, dass Peter nicht abfabbt?</p>\n<p>Robin:</p>\n<p>Natuerlich. Fuer die Qualitaet und unsere Hoerer tun wir alles.</p>\n<p>Andreas:</p>\n<p>… und irgendwann kommt er auch nach Oesterreich damit ich hochdeutsch lerne?</p>\n<p>Patrick:</p>\n<p>Nein, Lokalkolorit wird bei uns gern gesehen und erfreut die Hoererschaft</p>\n<p>Fabskimo:</p>\n<p>…. und was machen wir in zwei Wochen ?</p>\n<hr />\n<hr />\n<p><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-06-23_retrokompott_-_068_-_sega_mega_drive_part3.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 68</a></p>\n<p><a href=\"https://www.patreon.com/posts/nachlese-zur-68-19623627\">N67</a> 22.06.2018 0h28min   Nachlese Folge 68   <a href=\"https://www.patreon.com/posts/die-nachlese-zur-19338670\">fuer Patreonen</a></p>\n</div>\n<p style=\"text-align: center;\">mit Patrick, Robin, Fabskimo, Andreas &amp; Oliver</p>\n<p style=\"text-align: center;\">und als Themenexperten Oliver, Andreas &amp; Robin</p>\n<p style=\"text-align: center;\">(Aufnahmedatum des Themas: 22.03.2018)</p>\n<p style=\"text-align: center;\">Dauer: 6h26</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Die naechsten LIVE Termine auf <a href=\"http://www.mixlr.com/retrokompott\">www.mixlr.com/retrokompott:</a></p>\n<p style=\"text-align: center;\">07.07.2018 22:00 Aufzeichnung Rahmenprogramm THE LAST NINJA</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Ihr wollt beim Retrokompott mitmachen?</p>\n<div style=\"text-align: center;\">\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a><br />\noder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzeichnung<br />\ndes naechsten Themas als erstes!</p>\n<p>ab 3$ im Monat<br />\n&#8222;Robins Retro Woche&#8220; (<a href=\"https://www.patreon.com/posts/robins-retro-vom-18943794\">aktuelle Folge 10</a>)<br />\n&#8222;Patrick am Pranger&#8220; (<a href=\"https://www.patreon.com/posts/patrick-am-folge-19591427\">aktuelle Folge 7</a>)</p>\n<hr />\n<hr />\n<p>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</p>\n<p>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></p>\n</div>\n<div>\n<div>\n<p>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</p>\n<p>&nbsp;</p>\n<div>\n<hr />\n</div>\n</div>\n<hr />\n<p>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</p>\n</div>\n</div>\n</div>\n<p>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</p>\n<div>\n<hr />\n<hr />\n<p>Werbung in eigener Sache:</p>\n</div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken</a></p>\n<p>&nbsp;</p>\n</div>\n</div>\n<hr />\n<hr />\n<p>Die Links und weiterfuehrenden Infos zum Podcast:</p>\n</div>\n</div>\n<p style=\"text-align: center;\">Die Musik fuer diese Folge stammt von Bug of NCI<br />\nausser es wurde anders erwaehnt. Saemtliche Musik ist gemafrei.</p>\n<p style=\"text-align: center;\"><a href=\"https://c64audio.com/blogs/news/anthony-lees-an-obituary\">https://c64audio.com/blogs/news/anthony-lees-an-obituary</a></p>\n<p>&nbsp;</p>\n<p style=\"text-align: center;\"><a href=\"https://youtu.be/ftikpWH3OwI\"> https://youtu.be/ftikpWH3OwI</a></p>\n<p>&nbsp;</p>\n<p style=\"text-align: center;\"><a href=\"https://www.facebook.com/chris.abbott.9638/posts/10213713304639469\">https://www.facebook.com/chris.abbott.9638/posts/10213713304639469</a></p>\n<p style=\"text-align: center;\"><a href=\"https://soundcloud.com/maniacs-of-noise/jeroen-tel-rubicon-v22-wh00p-wh00p\">https://soundcloud.com/maniacs-of-noise/jeroen-tel-rubicon-v22-wh00p-wh00p</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.c256foenix.com/\">https://www.c256foenix.com/</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.heise.de/newsticker/meldung/Genesis-und-Kampf-40-Jahre-Space-Invaders-4084782.html\">https://www.heise.de/newsticker/meldung/Genesis-und-Kampf-40-Jahre-Space-Invaders-4084782.html</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.psytronik.net/newsite/index.php/c64/98-organism\">http://www.psytronik.net/newsite/index.php/c64/98-organism<br />\n</a><a href=\"http://www.psytronik.net/newsite/index.php/c64/97-atlantis\">http://www.psytronik.net/newsite/index.php/c64/97-atlantis</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.heise.de/newsticker/meldung/40-Jahre-8086-der-Prozessor-der-die-PC-Welt-veraenderte-4074260.html\">https://www.heise.de/newsticker/meldung/40-Jahre-8086-der-Prozessor-der-die-PC-Welt-veraenderte-4074260.html</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.zdf.de/dokumentation/zdfinfo-doku/was-spielt-deutschland-moorhuehner-siedler-und-planer-102.html\">https://www.zdf.de/dokumentation/zdfinfo-doku/was-spielt-deutschland-moorhuehner-siedler-und-planer-102.html</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.facebook.com/ReturnOfTheTentacle/\">https://www.facebook.com/ReturnOfTheTentacle/</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.chip.de/downloads/Vollversion-Red-Baron-3D_28711203.html\">http://www.chip.de/downloads/Vollversion-Red-Baron-3D_28711203.html</a></p>\n<div style=\"text-align: center;\">\n<hr />\n</div>\n<div id=\"magicdomid510\">\n<hr />\n<p style=\"text-align: center;\">Naechste Rahmenprogrammaufzeichnung:</p>\n<p style=\"text-align: center;\">LIVE: 07.07.2018<br />\nLIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a></p>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medie