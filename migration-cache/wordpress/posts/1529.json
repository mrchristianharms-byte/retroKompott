,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 049 - SimX Part 1\",\"subtitle\":null,\"summary\":null,\"duration\":\"6:43:53\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:00:51\",\"title\":\"Vierzeiler\"},{\"start\":\"00:01:07\",\"title\":\"Titelmusik\"},{\"start\":\"00:02:25\",\"title\":\"Heute sind mit dabei\"},{\"start\":\"00:02:35\",\"title\":\"Retro Warm Up - auf in eine neue Runde\"},{\"start\":\"00:32:26\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"00:45:50\",\"title\":\"Retro Facts: SIM X Part 1\"},{\"start\":\"02:08:47\",\"title\":\"PAUSENMUSIK (Bug of NCI)\"},{\"start\":\"02:09:54\",\"title\":\"Retro Play - Was sollen wir spielen?\"},{\"start\":\"02:12:49\",\"title\":\"PAUSENMUSIK (Bug of NCI)\"},{\"start\":\"02:13:56\",\"title\":\"Retro Play - das Resumee Card Sharks C64\"},{\"start\":\"02:25:32\",\"title\":\"Retro Talk - PoP Battle Isle 2\"},{\"start\":\"04:12:25\",\"title\":\"Retro Talk - Interview David Fox\"},{\"start\":\"05:12:23\",\"title\":\"PAUSENMUSIK (Bug of NCI)\"},{\"start\":\"05:13:31\",\"title\":\"Retro Mysteries - Quiz mit Marius\"},{\"start\":\"05:31:00\",\"title\":\"Retro Mysteries - Soundquiz\"},{\"start\":\"05:46:18\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"06:29:13\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"06:40:49\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2017-10-01_retrokompott_-_049_-_sim_x_part1.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        <br />\n<a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2017-10-01_retrokompott_-_049_-_sim_x_part1.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 49</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.patreon.com/posts/nachlese-zur-49-14644306\">N16</a> 30.09.2017 0h48min   Nachlese Folge 49   <a href=\"https://www.patreon.com/posts/nachlese-zur-49-14644306\">exclusiv fuer Patreon</a><a href=\"https://www.patreon.com/posts/die-nachlese-zur-8832336\"><br />\n</a></p>\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<hr />\n<p>Aufnahmedatum: 05.07.2017 &amp; 30.09.2017<br />\nmit <b>Robin, Patrick, Fabskimo &amp; Alexander<br />\nals Themenexperten <strong>Robin, Selmar, Alexander<br />\n</strong></b>Dauer: 6h44</p>\n<div id=\"magicdomid8\">\n<div>\n<hr />\n</div>\n<div>\n<p>Patrick:<br />\n…. Robin hat Nintendo gut gebrieft, die scheinen ihr Konzept ueberdacht zu haben</p>\n<p>Robin:<br />\nVielleicht sollten wir ueber einen japanischen Retrokompottableger nachdenken</p>\n<p>Fabskimo:<br />\n….Naja, die Hardware fuer das SNES Classic und NES Classic ist identisch.</p>\n<p>Alexander:<br />\nich glaube da hat Nintendo nicht viel nachdenken muessen…….</p>\n</div>\n</div>\n<div>\n<div id=\"magicdomid6\">\n<div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<hr />\n<div id=\"magicdomid651\">\n<h2><strong>Ihr wollt beim Retrokompott mitmachen?</strong></h2>\n</div>\n<h3>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a>,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzecichnung<br />\ndes naechsten Themas als erstes!</h3>\n<div>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</div>\n<div>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></div>\n</div>\n<div>\n<div>\n<div>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</div>\n</div>\n<div>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</div>\n</div>\n</div>\n</div>\n<div>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</div>\n<div></div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<div>&#8230;</div>\n<div>\n<p>Werbung in eigener Sache:</p>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken<br />\n</a>&#8230;</p>\n</div>\n<div></div>\n</div>\n</div>\n<hr />\n<div></div>\n<div>\n<p>Die Links und weiterfuehrenden Infos zum Podcast:</p>\n</div>\n</div>\n</div>\n<div>\n<p>Die Musik fuer diese Folge stammt von Bug of NCI</p>\n</div>\n</div>\n</div>\n</div>\n<div style=\"text-align: center;\">\n<p>&nbsp;</p>\n<p><a href=\"https://www.computerbase.de/2017-09/nintendo-snes-mini-teardown/\" target=\"_blank\" rel=\"noopener\">Nintendo: Im SNES Mini steckt ein NES Classic Mini</a></p>\n<p><a href=\"http://cpcretrodev.byterealms.com/contest-en/cpcretrodev-2017/\">auch dieses jahr wieder cpcretrodev 2017</a></p>\n<p><a href=\"http://www.buffed.de/Kurioses-Thema-205466/News/vr-brille-c64-1238915/\"><i>http://www.buffed.de/Kurioses-Thema-205466/News/vr-brille-c64-1238915/</i></a></p>\n<p><a href=\"http://pondsoft.uk/\"><i>http://pondsoft.uk/</i></a></p>\n<p><a href=\"http://www.wuerttembergische-philharmonie.de/konzert/id/video-game-music-in-concert.html\"><i>http://www.wuerttembergische-philharmonie.de/konzert/id/video-game-music-in-concert.html</i></a></p>\n<p><a href=\"http://www.bild.de/spiele/spiele-news/softwarepiraterie/eu-studie-piraterie-ist-gut-fuer-den-spiele-markt-53281360.bild.html\"><i>http://www.bild.de/spiele/spiele-news/softwarepiraterie/eu-studie-piraterie-ist-gut-fuer-den-spiele-markt-53281360.bild.html</i></a></p>\n<p><a href=\"https://www.kickstarter.com/projects/1575848200/thaumistry-in-charms-way-a-new-comedy-text-adventu?lang=de\"><i>https://www.kickstarter.com/projects/1575848200/thaumistry-in-charms-way-a-new-comedy-text-adventu?lang=de</i></a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://en.wikipedia.org/wiki/The_King_of_Kong\"><i>https://en.wikipedia.org/wiki/The_King_of_Kong</i></a></p>\n<p><a href=\"http://www.zeus-software.com/downloads/nglide\"><i>http://www.zeus-software.com/downloads/nglide</i></a></p>\n<p><a href=\"https://www.kickstarter.com/projects/1586914059/the-computer-classics-card-game?ref=nav_search\"><i>https://www.kickstarter.com/projects/1586914059/the-computer-classics-card-game?ref=nav_search</i></a></p>\n<p><a href=\"https://www.golem.de/news/offene-konsole-ataribox-entspricht-mittelklasse-pc-mit-linux-1709-130272.html\"><i>https://www.golem.de/news/offene-konsole-ataribox-entspricht-mittelklasse-pc-mit-linux-1709-130272.html</i></a></p>\n<p><a href=\"https://m.youtube.com/watch?v=bG5THdtdqHE\"><i>Atari Box &#8211; Ein Holzklotz und ein PC ergeben keine Spielekonsole VisioRetron Podcast</i></a></p>\n<p><a href=\"http://www.gamersglobal.de/news/135397/the-c64-mini-neuauflage-der-retro-plattform-2018-preis-und-weitere-details\"><i>The C64 Mini</i></a><i> oder </i><a href=\"http://www.pcgameshardware.de/Retro-Games-Software-204959/News/C64-Mini-mit-64-legendaeren-Spielen-und-Joystick-angekuendigt-1240007/\"><i>http://www.pcgameshardware.de/Retro-Games-Software-204959/News/C64-Mini-mit-64-legendaeren-Spielen-und-Joystick-angekuendigt-1240007/</i></a></p>\n<p><i> </i><a href=\"http://www.twingalaxies.com/member.php/31849-WCopeland\"><i>http://www.twingalaxies.com/member.php/31849-WCopeland</i></a></p>\n</div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\">&#8230;&#8230;&#8230;&#8230;&#8230;&#8230;&#8230;.</div>\n<div id=\"magicdomid510\">\n<div style=\"text-align: center;\">\n<p>Naechste Sendung:</p>\n</div>\n<div style=\"text-align: center;\">\n<p>LIVE:  13.10.2017 22:00 Uhr</p>\n<p>LIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a><br />\n(Thema als Aufzeichnung vorausichtlich ab 20:00 Uhr)</p>\n<p>Thema: SIM X Part 2</p>\n</div>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></p>\n<p style=\"text-align: center;\">weitere Infos in der Textdatei.<br />\nDiese wird regelmaessig aktualisiert,<br />\nes kommen auch noch C64 &amp; Konsolenspiele dazu.</p>\n</div>\n",
