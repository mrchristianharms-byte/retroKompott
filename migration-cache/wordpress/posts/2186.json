,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 063 - Sega Saturn Part I\",\"subtitle\":null,\"summary\":null,\"duration\":\"7:16:16\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:00:59\",\"title\":\"Vierzeiler\"},{\"start\":\"00:01:19\",\"title\":\"Titelmusik\"},{\"start\":\"00:02:36\",\"title\":\"Heute sind mit dabei   \"},{\"start\":\"00:02:47\",\"title\":\"Retro Warm Up - auf in eine neue Runde    \"},{\"start\":\"00:47:34\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"00:56:46\",\"title\":\"Retro Facts: Nachschlag Skurrile Hardware von Axel\"},{\"start\":\"01:00:21\",\"title\":\"Retro Facts: Sega Saturn Part I\"},{\"start\":\"02:04:43\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"02:05:44\",\"title\":\"Retro Play - das Resume Decap Attack Mega Drive\"},{\"start\":\"02:16:18\",\"title\":\"Retro Play - Was sollen wir spielen? Seaside Special C64\"},{\"start\":\"02:18:30\",\"title\":\"Retro Talk - Ready Player One mit Patrick und Robin\"},{\"start\":\"02:51:54\",\"title\":\"Retro Talk - Dogfight mit den Pretty old Pixeln\"},{\"start\":\"04:14:08\",\"title\":\"Retro Talk - Dune 2 mit Daniel\"},{\"start\":\"04:23:45\",\"title\":\"Retro Talk - Interview mit Roland Austinat\"},{\"start\":\"06:15:08\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"06:16:18\",\"title\":\"Retro Mysteries SoundQuiz \"},{\"start\":\"06:33:36\",\"title\":\"Retro Mysteries Quiz mit Andreas\"},{\"start\":\"06:44:55\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"07:06:20\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"07:13:14\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2018-04-14_retrokompott_-_063_-_sega_saturn_part_1.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        </p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">HELFT UNS DIE REGELMESSIGE AUSSTRAHLUNG UND ZUKUNFT DES PODCASTS ZU SICHERN UND UNTERSTUETZT UNS<br />\nAUF <a href=\"http://www.patreon.com/retrokompott\">PATREON</a> ODER <a href=\"http://paypal.me/retrokompott\">PAYPAL</a><br />\nVIELEN DANK!</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Fabskimo:</p>\n<p style=\"text-align: center;\">Ich habe gehoert die naechsten Wochen geht es nur um CPC´s?</p>\n<p style=\"text-align: center;\">Robin:</p>\n<p style=\"text-align: center;\">Ich glaube die Leitung nach Berlin war schon wieder gestoert…..</p>\n<p style=\"text-align: center;\">Patrick:</p>\n<p style=\"text-align: center;\">Fab, wir haben Sega Wochen&#8230;</p>\n<p style=\"text-align: center;\">Selmar:</p>\n<p style=\"text-align: center;\">Ist ja wie bei Mc Donalds….</p>\n<p style=\"text-align: center;\">Andreas:</p>\n<p style=\"text-align: center;\">&#8230;aber lange nicht so vorhersehbar</p>\n<p style=\"text-align: center;\">Oliver:</p>\n<p style=\"text-align: center;\">&#8230;und da es voraufgezeichnet wurde kann selbst am Freitag den 13ten nichts schiefgehen.</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\"> <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-04-14_retrokompott_-_063_-_sega_saturn_part_1.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 63</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.patreon.com/posts/nachlese-zur-63-18166189\">N63</a> 13.04.2018 0h58min   Nachlese Folge 63   <a href=\"https://www.patreon.com/posts/nachlese-zur-63-18166189\">fuer Patreonen</a></p>\n</div>\n<p style=\"text-align: center;\">mit Patrick, Robin, Fabskimo, Selmar, Andreas, Oliver</p>\n<p style=\"text-align: center;\">und als Themenexperten Selmar, Andreas, Oliver</p>\n<p style=\"text-align: center;\">(Aufnahmedatum des Themas: 15.03.2018)</p>\n<p style=\"text-align: center;\">Dauer: 7h13</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Die naechsten LIVE Termine auf <a href=\"http://www.mixlr.com/retrokompott\">www.mixlr.com/retrokompott</a> :</p>\n<p style=\"text-align: center;\">24.04.2018  21:00 Uhr LIVE Aufzeichnung Thema Last Ninja</p>\n<p style=\"text-align: center;\">Bei den Themen kann es zu kurfristigen Aenderungen kommen.</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Ihr wollt beim Retrokompott mitmachen?</p>\n<div style=\"text-align: center;\">\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a><br />\noder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzeichnung<br />\ndes naechsten Themas als erstes!</p>\n<p>ab 3$ im Monat &#8222;Robins Retro Woche&#8220; (<a href=\"https://www.patreon.com/posts/robins-retro-17866073\">aktuelle Folge</a>)<br />\nund demnaechst: &#8222;Patrick am Pranger&#8220;</p>\n<hr />\n<hr />\n<p>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</p>\n<p>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></p>\n</div>\n<div>\n<div>\n<p>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</p>\n<p>&nbsp;</p>\n<div>\n<hr />\n</div>\n</div>\n<hr />\n<p>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</p>\n</div>\n</div>\n</div>\n<p>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</p>\n<div>\n<hr />\n<hr />\n<p>Werbung in eigener Sache:</p>\n</div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken</a></p>\n<p>&nbsp;</p>\n</div>\n</div>\n<hr />\n<hr />\n<p>Die Links und weiterfuehrenden Infos zum Podcast:</p>\n</div>\n</div>\n<p style=\"text-align: center;\">Die Musik fuer diese Folge stammt von Bug of NCI<br />\nausser es wurde anders erwaehnt. Saemtliche Musik ist gemafrei.</p>\n<p style=\"text-align: center;\"> <a href=\"https://theretrohour.com/c64-jeroen-tel-interview/\">C64 Legend Jeroen Tel of Maniacs of Noise – The Retro Hour EP114</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.digisaurier.de/12-pc-programme-die-mal-ganz-wichtig-waren/\">http://www.digisaurier.de/12-pc-programme-die-mal-ganz-wichtig-waren/</a></p>\n<p>&nbsp;</p>\n<p style=\"text-align: center;\"><a href=\"https://www.youtube.com/watch?v=2maKdtHPciQ\">https://www.youtube.com/watch?v=2maKdtHPciQ</a></p>\n<p>&nbsp;</p>\n<p style=\"text-align: center;\"><a href=\"https://www.heise.de/newsticker/meldung/TGIQF-das-Quiz-Was-wissen-Sie-ueber-den-C64-4011128.html\">https://www.heise.de/newsticker/meldung/TGIQF-das-Quiz-Was-wissen-Sie-ueber-den-C64-4011128.html</a></p>\n<p>&nbsp;</p>\n<p style=\"text-align: center;\"><a href=\"https://www.playstation.com/en-us/games/horizon-chase-turbo-ps4/\">https://www.playstation.com/en-us/games/horizon-chase-turbo-ps4/</a></p>\n<p>&nbsp;</p>\n<p style=\"text-align: center;\"><a href=\"http://www.gallopingghostarcade.com/\">http://www.gallopingghostarcade.com/</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.atari-computermuseum.de/warentest.htm\"> </a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.youtube.com/watch?time_continue=209&amp;v=au-lkMURXas\">MAGFest 2018: Super Guitar Bros</a></p>\n<p>&nbsp;</p>\n<p style=\"text-align: center;\"><a href=\"http://www.playnation.de/spiele-news/kurioses/sammler-findet-drogen-mehreren-nes-modulen-id74025.html\">http://www.playnation.de/spiele-news/kurioses/sammler-findet-drogen-mehreren-nes-modulen-id74025.html</a></p>\n<p>&nbsp;</p>\n<div style=\"text-align: center;\">\n<hr />\n</div>\n<div id=\"magicdomid510\">\n<hr />\n<p style=\"text-align: center;\">Naechste Rahmenprogrammaufzeichnung:</p>\n<p style=\"text-align: center;\">LIVE:  ??<br />\nThema: Sega Saturn PART 2</p>\n<p style=\"text-align: center;\">LIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a></p>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></p>\n<p style=\"text-align: center;\">weitere Infos in der Textdatei.<br />\nDiese wird regelmaessig aktualisiert,<br />\nes kommen auch noch C64 &amp; Konsolenspiele dazu.</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">\n</div>\n",
