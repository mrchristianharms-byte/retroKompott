,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 025 - Fussballspiele vor 1995\",\"subtitle\":null,\"summary\":null,\"duration\":\"5:50:29\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Vorgepl\\u00e4nkel\"},{\"start\":\"00:07:06\",\"title\":\"Podwichteln Ank\\u00fcndigung\"},{\"start\":\"00:11:53\",\"title\":\"Mailbox -  eure Stimme im Retrokompott\"},{\"start\":\"00:18:10\",\"title\":\"Audiokommentar Philipp\"},{\"start\":\"00:31:28\",\"title\":\"Zur\\u00fcck in die Gegenwart\"},{\"start\":\"00:40:22\",\"title\":\"Thema: Fussballspiele vor 1995\"},{\"start\":\"00:40:25\",\"title\":\"Champions League Klasse\"},{\"start\":\"01:27:59\",\"title\":\"Euro League Klasse\"},{\"start\":\"01:54:08\",\"title\":\"Abstiegsklasse\"},{\"start\":\"02:05:10\",\"title\":\"Exoten\"},{\"start\":\"02:25:53\",\"title\":\"Pod Quest - das Res\\u00fcmee ...\"},{\"start\":\"02:25:58\",\"title\":\"Hocus Pocus\"},{\"start\":\"02:30:35\",\"title\":\"Traz\"},{\"start\":\"02:35:44\",\"title\":\"Leander\"},{\"start\":\"02:36:57\",\"title\":\"Shinobi 3\"},{\"start\":\"02:42:38\",\"title\":\"Pod Quest -  Next Level - Was sollen wir spielen?\"},{\"start\":\"02:50:53\",\"title\":\"Retro Intern - Neues aus der Szene\"},{\"start\":\"02:51:05\",\"title\":\"Verlosung und Ergebnis\"},{\"start\":\"03:20:02\",\"title\":\"Das Ger\\u00e4usch aus der Vergangenheit\"},{\"start\":\"03:30:03\",\"title\":\"DAS INTERVIEW - Andrew Hewson\"},{\"start\":\"04:44:36\",\"title\":\"Bonustracks\"},{\"start\":\"04:45:19\",\"title\":\"Bonustrack 1 Welches Spiel bin ich?\"},{\"start\":\"05:01:16\",\"title\":\"Bonustrack 2  Patrick und Robin spielen Fussballspiele\"},{\"start\":\"05:22:04\",\"title\":\"Bonustrack 3 War Inc Project Airo$\"},{\"start\":\"05:47:28\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2016-11-12_retrokompott_-_025_-_fussballspiele_mp3.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        <br />\n<a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2016-11-12_retrokompott_-_025_-_fussballspiele_mp3.mp3?\" target=\"_blank\">Download von Folge 25</a></p>\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<hr />\n<p>Aufnahmedatum: 11.11.2016<br />\nmit Patrick, Robin, Derk, Fabskimo &amp; Bonnadinho<br />\nDauer: 5:50</p>\n<div id=\"magicdomid8\">\n<div>\n<hr />\n</div>\n<div></div>\n<p>Patrick:<br />\nWir brauchen einen guten Kick Off fuer die neue Ausgabe</p>\n<p>Robin:<br />\nPuhhh, der naechste Podcast ist immer der schwerste!</p>\n<p>Patrick:<br />\nhhmmmm und dauert dieses Mal dann 90 Minuten?</p>\n<p>Fabskimo:<br />\nNicht bei uns! So schnell werden wir auch heute nicht fertig!</p>\n</div>\n<div>\n<div id=\"magicdomid6\">\n<div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<hr />\n<div id=\"magicdomid651\">\n<p>Ihr wollt beim Retrokompott mitmachen?</p>\n</div>\n<div>Unterstuetzen kann man den Podcast bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a>,<br />\ndamit sichert ihr die Zukunft dieses Podcasts und erhaltet<br />\nviele spezielle Tracks, Videos und Infos<br />\nexclusiv oder als erste!</div>\n<div></div>\n<div>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</div>\n</div>\n</div>\n<div id=\"magicdomid10\">\n<div>\n<div></div>\n<div>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></div>\n<div></div>\n<div>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unser <a href=\"http://www.retrokompott.de\">Homepage</a>.Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR</a></div>\n<div>\n<p>Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abbonieren.</p>\n</div>\n<div></div>\n</div>\n</div>\n<hr />\n<div></div>\n<div id=\"magicdomid92\">Die Links und weiterfuehrenden Infos zum Podcast:</div>\n<div></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"><a href=\"http://www.gamersglobal.de/news/122094/retrokompott-folge-24-pcs-im-wandel-der-zeit-3-teil\">http://www.gamersglobal.de/news/122094/retrokompott-folge-24-pcs-im-wandel-der-zeit-3-teil</a></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\">Zum Thema Robotron und KC Rechner<br />\n<a href=\"https://www.youtube.com/watch?v=PUW9MJUSeYA\">https://www.youtube.com/watch?v=PUW9MJUSeYA</a></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\">Tetris Track Remix von Sami Koistinen:<br />\n<a href=\"https://www.youtube.com/watch?v=D4DD9nPwJvA\"> https://www.youtube.com/watch?v=D4DD9nPwJvA</a></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\">Last Ninja &#8211; zwei remixes</div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\">\n<p>Central Park Theme Remix von Richard Braithwaite:<a href=\"https://www.youtube.com/watch?v=P2eFlVpQ3dc\"> https://www.youtube.com/watch?v=P2eFlVpQ3dc</a></p>\n</div>\n<p>&nbsp;</p>\n<div style=\"text-align: center;\">\n<p>Main Theme for Classical Guitar von Jamie Maxwell:<a href=\"https://www.youtube.com/watch?v=fi8Cce46hGo\"> https://www.youtube.com/watch?v=fi8Cce46hGo</a></p>\n</div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\">35 jahre Fussballspiele<br />\n<a href=\"https://www.youtube.com/watch?v=l6sKoL0qSOQ\">https://www.youtube.com/watch?v=l6sKoL0qSOQ</a></div>\n<p>&nbsp;</p>\n<div style=\"text-align: center;\">\n<p>“Soccer”-Variante der Pong-Videokonsole der 70er<br />\n<a href=\"http://de.ign.com/feature/80619/von-soccer-pong-zu-fifa-eine-nachhilfestunde-in-sachen-fussb\">http://de.ign.com/feature/80619/von-soccer-pong-zu-fifa-eine-nachhilfestunde-in-sachen-fussb</a></p>\n</div>\n<p>&nbsp;</p>\n<div style=\"text-align: center;\">\n<p>Angry Video Game Nerd ueber Atari Sportspiele<br />\n<a href=\"http://cinemassacre.com/2012/12/17/avgn-atari-sports/\">http://cinemassacre.com/2012/12/17/avgn-atari-sports/</a></p>\n</div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\">Leander (Amiga)<br />\n<a href=\"https://www.youtube.com/watch?v=mROgK7srbDM\">https://www.youtube.com/watch?v=mROgK7srbDM</a></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\">Shinobi III Return of the Ninja Master &#8211; 1993 Sega Genesis<a href=\"https://archive.org/details/sg_Shinobi_III_Return_of_the_Ninja_Master_1993_Sega_US\"> https://archive.org/details/sg_Shinobi_III_Return_of_the_Ninja_Master_1993_Sega_US</a></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\">\n<p><a href=\"https://futurezone.at/digital-life/zwoelf-meter-breiter-pac-man-auf-steirische-a2-gesprueht/229.400.904\">https://futurezone.at/digital-life/zwoelf-meter-breiter-pac-man-auf-steirische-a2-gesprueht/229.400.904</a></p>\n<p><a href=\"http://www.ebay.de/itm/Ultra-RARE-Commodore-65-prototype-aka-DX64-or-C90-fully-working-see-video-/141796044241?nma=true&amp;si=Eefxy1XCBJ5Sj9vzd5%252Fu6G%252Bcb7k%253D&amp;orig_cvip=true&amp;rt=nc&amp;_trksid=p2047675.l2557\">http://www.ebay.de/itm/Ultra-RARE-Commodore-65-prototype-aka-DX64-or-C90-fully-working-see-video-/141796044241?nma=true&amp;si=Eefxy1XCBJ5Sj9vzd5%252Fu6G%252Bcb7k%253D&amp;orig_cvip=true&amp;rt=nc&amp;_trksid=p2047675.l2557</a></p>\n</div>\n<p>&nbsp;</p>\n<div style=\"text-align: center;\">\n<p><a href=\"http://www.indieretronews.com/2016/11/fs-uae-281-amiga-emulator-with-great.html\">http://www.indieretronews.com/2016/11/fs-uae-281-amiga-emulator-with-great.html</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.youtube.com/watch?v=qFAz9fkXxx4\">https://www.youtube.com/watch?v=qFAz9fkXxx4</a></p>\n<p>&nbsp;</p>\n<p>Groete PC Big box sammlung der welt<br />\n<a href=\"http://csdb.dk/event/?id=2299\">http://csdb.dk/event/?id=2299</a></p>\n<p>&nbsp;</p>\n<p>x2016 Demos<br />\n<a href=\"https://www.youtube.com/watch?v=BwqWsgkhfAs\">https://www.youtube.com/watch?v=BwqWsgkhfAs</a></p>\n<p>&nbsp;</p>\n<p>Donkey Kong remake (gab ja vorher 2 originale)<br />\n<a href=\"https://www.c64-wiki.de/index.php/Goattracker\">https://www.c64-wiki.de/index.php/Goattracker</a></p>\n<p>&nbsp;</p>\n<p>C64 Musik auf PC machen<br />\n<a href=\"https://www.kickstarter.com/projects/mevdinc/super-samurai-remake-of-amiga-retro-classic-first\">https://www.kickstarter.com/projects/mevdinc/super-samurai-remake-of-amiga-retro-classic-first</a></p>\n<p>&nbsp;</p>\n<p>Symphonic Selections-Konzert<br />\n<a href=\"http://www.gameconcerts.com/neues/ansicht/article/orchesteralbum-zu-turrican-ii-mit-urauffuehrung-in-bochum/\">http://www.gameconcerts.com/neues/ansicht/article/orchesteralbum-zu-turrican-ii-mit-urauffuehrung-in-bochum/</a></p>\n<p>&nbsp;</p>\n<p>TecToy bringt neues Sega Mega Drive<br />\n<a href=\"http://www.heypoorplayer.com/2016/10/31/new-sega-mega-drive-unveiled/\">http://www.heypoorplayer.com/2016/10/31/new-sega-mega-drive-unveiled/</a></p>\n<p>&nbsp;</p>\n<p>ab 4. November wird die Wii-U nicht mehr produziert<br />\n<a href=\"http://www.polygon.com/wii-u/2016/11/1/13487008/wii-u-dead-production-ends\">http://www.polygon.com/wii-u/2016/11/1/13487008/wii-u-dead-production-ends</a></p>\n<p>&nbsp;</p>\n<p>NES Classic Mini ist<br />\n<a href=\"https://www.amazon.de/gp/offer-listing/B01IFJEWTM/ref=dp_olp_new?ie=UTF8&amp;condition=new\">https://www.amazon.de/gp/offer-listing/B01IFJEWTM/ref=dp_olp_new?ie=UTF8&amp;condition=new</a></p>\n<p>&nbsp;</p>\n</div>\n<div style=\"text-align: center;\">\n<p>&#8212;&#8212;&#8212;&#8211;</p>\n</div>\n<div id=\"magicdomid510\">\n<div style=\"text-align: center;\">\n<p>Naechste Sendung:</p>\n</div>\n<div style=\"text-align: center;\">voraussichtlich 25.11.2016, 22:00 Uhr</div>\n<div style=\"text-align: center;\">erotische Computerspiele 8 Bit</div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\">weitere Infos demnaechst hier.</div>\n<div style=\"text-align: center;\">LIVE auf mixlr.com/retrokompott</div>\n</div>\n",
