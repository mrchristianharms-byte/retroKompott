ily\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 112 - Metroidvanias Part IV\",\"subtitle\":null,\"summary\":null,\"duration\":\"4:12:45\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Vorspann &amp; Danksagungen\"},{\"start\":\"00:01:08\",\"title\":\"Heute sind mit dabei  \"},{\"start\":\"00:01:19\",\"title\":\"Vorgepl\\u00e4nkel\"},{\"start\":\"00:02:05\",\"title\":\"Titelmusik\"},{\"start\":\"00:03:25\",\"title\":\"Retro Warm Up - auf in eine neue Runde  \"},{\"start\":\"00:12:03\",\"title\":\"Einspieler Werbung in eigener Sache\"},{\"start\":\"00:17:57\",\"title\":\"Einspieler Wie kann man uns erreichen?\"},{\"start\":\"00:20:13\",\"title\":\"Retro Facts: Thema - Metroidvanias Part IV\"},{\"start\":\"01:19:00\",\"title\":\"Pausenmusik Chris Huelsbeck - Miami Midnight Drive\"},{\"start\":\"01:23:17\",\"title\":\"Retro Mysteries - Quiz mit  Markus Wegl (Ewig Gestern)\"},{\"start\":\"01:55:13\",\"title\":\"Einspieler Merchandise\"},{\"start\":\"01:56:05\",\"title\":\"Retro Talk - Interview mit Christian Ohrens\"},{\"start\":\"03:03:56\",\"title\":\"Pausenmusik - Bug of NCI\"},{\"start\":\"03:05:04\",\"title\":\"Retro Play - Microdot C64\"},{\"start\":\"03:15:46\",\"title\":\"Retro Play - Zeit f\\u00fcr altes und Neues\"},{\"start\":\"03:33:57\",\"title\":\"Sendeplan ab 09.03.2020\"},{\"start\":\"03:37:34\",\"title\":\"Retrotalk Auspackaudio 032020 (Andreas)\"},{\"start\":\"03:41:10\",\"title\":\"Retrotalk MSX 2 (Axel)\"},{\"start\":\"03:45:46\",\"title\":\"Einspieler - Events\"},{\"start\":\"03:46:52\",\"title\":\"Pausenmusik - Bug of NCI\"},{\"start\":\"03:47:57\",\"title\":\"Retro News - Neues aus der Szene\"},{\"start\":\"03:59:11\",\"title\":\"Einspieler Kontaktinfos (lang)\"},{\"start\":\"04:01:02\",\"title\":\"Retro Credits \"},{\"start\":\"04:09:27\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2020-03-09_retrokompott_-_112_-_metroidvanias.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        \r\n\r\n\r\n<hr class=\"wp-block-separator\" />\r\n\r\n\r\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS-FEED</a>  <a href=\"https://www.facebook.com/retrokompott/\">Facebook</a>  <a href=\"https://twitter.com/retrokompott/\">Twitter</a>  <a href=\"https://www.instagram.com/retrokompott/\">Instagramm</a></p>\r\n<hr class=\"wp-block-separator\" />\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">HELFT UNS, DIE REGELMAESSIGE AUSSTRAHLUNG UND ZUKUNFT DES PODCASTS ZU SICHERN UND UNTERSTUETZT UNS AUF <a href=\"http://www.patreon.com/retrokompott\">PATREON</a>, <a href=\"https://steadyhq.com/de/retrokompott\">STEADY</a> ODER <a href=\"http://paypal.me/retrokompott\">PAYPAL.</a> Infos zu unser Event Location in Hamburg findet man <a href=\"https://www.facebook.com/retrospieleclub/\">HIER</a>. Zugang zu unser internen WhatsApp Gruppe erhaltet ihr auf Anfrage per <a href=\"mail@retrokompott.de\">Mail</a>.</p>\r\n<hr />\r\n\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2020-03-09_retrokompott_-_112_-_metroidvanias.mp3?\" target=\"_blank\" rel=\"noreferrer noopener\">Download von Folge 112</a></p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">mit Patrick, Robin, fabskimo &amp; Oliver</p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">und als Themenexperten Andreas, Oliver, Derk &amp; Marius Aufnahmedatum des Themas: 02.10.2019</p>\r\n\r\n\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Dauer:  4h13 min</p>\r\n<hr />\r\n\r\n\r\n<p style=\"text-align: center;\"><em>Die naechsten Live Termine &amp; Events:</em></p>\r\n<p style=\"text-align: center;\">&#8230;</p>\r\n<p style=\"text-align: center;\">13.03 <a href=\"https://blog.retrokompott.de/01-stammtisch/\">Stammtisch</a> Folge 58 (ab 21 Uhr)</p>\r\n<p style=\"text-align: center;\">&#8230;</p>\r\n<p style=\"text-align: center;\">20.03 <a href=\"https://blog.retrokompott.de/01-stammtisch/\">Stammtisch</a> Folge 59 (ab 21 Uhr)</p>\r\n<p style=\"text-align: center;\">&#8230;</p>\r\n<p style=\"text-align: center;\">22.03  <a href=\"https://blog.retrokompott.de/01-live/\">Retrokompott Folge 113 ab 21:45</a></p>\r\n<p style=\"text-align: center;\">&#8230;</p>\r\n<p style=\"text-align: center;\">Events in der Event Location Hamburg Horn finet man <a href=\"http://www.retrospieleclub.de\">hier</a>.</p>\r\n<pre><br />Folge 112 unserer \"kleinen\" Zeitreise in die Welt vergangener Homecomputer,<br />Spielekonsolen und Games ist online. Der Retrokompott Podcast ist eine <br />Internet-Radiosendung fuer alle Fans von C64, AMIGA, MS-DOS und Co. <br />Thematisch geht es mit Andreas, Derk, Marius &amp; Oliver zum letzten Mal um <br />Metroidvanias, genauer gesagt um die Grenzfaelle des Genres. Im Rahmenprogramm <br />sind Patrick, Robin, fabskimo &amp; Oliver mit dabei.<br />Wer von den Hoerern in unser stndig erwaehnten „geheimen“ Unterstuetzer WhatsApp <br />Gruppe mitmachen moechte, kann uns gerne eine Mail schreiben mit einer kleinen <br />Begruendung, warum. Vielleicht schicken wir Euch bei besonders witzigen <br />Einsendungen einen Einladungslink.<br />Unterstuetzer erhalten den Link bei Patreon oder Steady automatisch und koennen<br />jederzeit mit einsteigen!<br />Unsere Unterstuetzer erhalten auch Zugriff auf diverse Extraformate, den<br />kompletten Stammtisch und viele Previews &amp; Sonderaktionen <br />(www.patreon.com/retrokompott).<br />Wer die Retro Quickies vermisst - diese fehlen, da wir dieses Unterstuetzerziel<br />dieses Mal nicht erreicht haben. Juergen hat aber schon fleissig vorproduziert. <br />Sobald wir das Ziel wieder erreicht haben, geht es natuerlich mit neuen <br />Einspielern weiter. Wir freuen uns ueber jeden kleine neue Unterstuetzung bei <br />Patreon oder Steady, denn nur mit einer breiten Basis aus der Community sind <br />unsere Ziele langfristig und dauerhaft zu sichern.<br />Im Interview dieses mal Christian Ohrens, ein binder Spieler. Wie das geht <br />und warum Christian schon immer ein Spielefan war, erfahrt ihr in der heutigen <br />Ausgabe. Das Interview hatten wir am 18.01. voraufgezeichnet, wer sich fuer <br />sein aktuelles Event interessiert, auf dem man selber einmal ausprobieren <br />kann Nichtsehend zu spielen, findet die Infos auf seiner Homepage oder bei <br />Facebook (https://blind-durch-hamburg.de.<br />Die Pausenmusiken stammen von Chris Huelsbeck &amp; Bug of NCI (Wir nutzen seine <br />royalty-free Lizenz, wer mehr Informationen dazu haben ,oder Chris ebenfalls <br />unterstuetzen moechte, sollte sein Patreon Profil besuchen: <br />www.patreon.com/chris_huelsbeck.<br />Natuerlich gibt es auch wieder ein Quiz in der Retrolurch Edition 3.0. <br />Heute ist Markus Wegl von Ewig Gestern mit dabei.<br />Im Retro Play kuemmern wir uns Microdot fuer den C64, ein altes, grafisch zuerst <br />unauffaelliges Spiel, welches doch ziemlich modern zu sein scheint.<br />Im Retrotalk spricht Andreas ueber sein Unterstuetzer Paket von Maerz und Axel <br />stimmt uns schon einmal mit seinen Erinnerungen auf die kommenden MSX <br />Wochen ein.<br /><br />#Folge #Zeitreise #Homecomputer #Spielekonsolen #Games #Retrokompott #Podcast <br />#C64 #AMIGA #MSDOS #commodore #metroid #metroidvanias #retrostammtisch <br />#christianohrens #microdot #interview #paypal #patreon #steady #Live #Chat <br />#retrospieleclub #Retrozeit #comillusion #retrolurch #quiz </pre>\r\n<hr />\r\n<p style=\"text-align: center;\">WERBUNG: Unsere neue Retro Event Location findet man hier: <a href=\"https://www.facebook.com/retrospieleclub/\">https://www.facebook.com/retrospieleclub/</a> Merchandise Artikel gibt es ab jetzt auch im Shop: <a href=\"https://shop.spreadshirt.de/retrokompott\">RETROKOMPOTT MERCHANDISE</a></p>\r\n\r\n\r\n<hr class=\"wp-block-separator\" />\r\n<p style=\"text-align: center;\">Ihr wollt beim Retrokompott mitmachen?</p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON,</a> <a href=\"https://steadyhq.com/de/retrokompott\">STEADY</a>, oder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL (als Belohnung schalten wir <a href=\"https://blog.retrokompott.de/you-tube-videos/\">Videos</a> frei), damit sichert ihr die Zukunft dieses Podcasts und erhaltet viele spezielle Tracks, Videos und Infos wie zum Beipsiel die Voraufzeichnung des naechsten Themas als erstes!</p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\"><strong>Bei Patreon und Steady bieten wir unseren Unterstuetzern verschiedene Optionen an. Die genauen Infos findet ihr <a href=\"https://blog.retrokompott.de/04-exclusive-formate/\">hier.</a> Unterstuetzen kann man uns schon ab 1$/1 Euro im Monat </strong></p>\r\n<hr class=\"wp-block-separator\" />\r\n<p style=\"text-align: center;\">Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Per Mail erreicht man uns unter <a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>, oder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>. Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</p>\r\n\r\n\r\n\r\n<p style=\"text-align: center;\">Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de.</a></p>\r\n\r\n\r\n\r\n\r\n<hr class=\"wp-block-separator\" />\r\n\r\n<hr class=\"wp-block-separator\" />\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Werbung in eigener Sache:</p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR </a> aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken</a></p>\r\n\r\n\r\n<hr class=\"wp-block-separator\" />\r\n\r\n<hr class=\"wp-block-separator\" />\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Die Musiken fuer diese Folge stammen von <br />BugofNCI &amp; Chris Huelsbeck. <br />Die Royalty Free Musik von Chris Huelsbeck <br />lohnt sich auch immer zu unterstuetzen:</p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\"><a href=\"https://www.patreon.com/chris_huelsbeck\"><b>www.patreon.com/chris_huelsbeck</b></a></p>\r\n\r\n\r\n<hr class=\"wp-block-separator\" />\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">weiterfuehrende Links: <b></b></p>\r\n<p style=\"text-align: center;\"><a href=\"https://www.protovision.games/games/wormhole.php?language=de\"><b>https://www.protovision.games/games/wormhole.php?language=de</b></a></p>\r\n<p>&nbsp;</p>\r\n<p style=\"text-align: center;\"><a href=\"https://www.gamestar.de/artikel/turrican-soundtrack-chris-huelsbeck-interview,3354440.html\"><b>https://www.gamestar.de/artikel/turrican-soundtrack-chris-huelsbeck-interview,3354440.html</b></a></p>\r\n<p style=\"text-align: center;\"> </p>\r\n<p style=\"text-align: center;\"><a href=\"http://www.indieretronews.com/2020/03/the-pit-1982-arcade-game-gets-zx.html\"><b>http://www.indieretronews.com/2020/03/the-pit-1982-arcade-game-gets-zx.html</b></a></p>\r\n<p style=\"text-align: center;\"> </p>\r\n<p style=\"text-align: center;\"><a href=\"https://www.welt.de/vermischtes/article206392631/Letztes-Exemplar-PlayStation-Protoyp-fuer-Rekordsumme-versteigert.html\"><b>https://www.welt.de/vermischtes/article206392631/Letztes-Exemplar-PlayStation-Protoyp-fuer-Rekordsumme-versteigert.html</b></a></p>\r\n<p style=\"text-align: center;\"> </p>\r\n<p style=\"text-align: center;\"><a href=\"http://www.indieretronews.com/2020/02/sams-journey-gets-new-nes-footage.html\"><b>http://www.indieretronews.com/2020/02/sams-journey-gets-new-nes-footage.html</b></a></p>\r\n<p>&nbsp;</p>\r\n<hr />\r\n<p style=\"text-align: center;\">unser Kooperations &amp; Werbepartner, sowie andere Projekte: <a href=\"http://www.retrospieleclub.de\">Retro Spiele Club Hamburg Horn</a></p>\r\n\r\n\r\n\r\n<figure class=\"wp-block-embed\">\r\n<div class=\"wp-block-embed__wrapper\" style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></div>\r\n</figure>\r\n\r\n\r\n\r\n<figure class=\"wp-block-embed\">\r\n<div class=\"wp-block-embed__wrapper\" style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></div>\r\n</figure>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">weitere Infos in der Textdatei. Diese wird regelmaessig aktualisiert, es kommen immer neue Spiele dazu.</p>\r\n\r\n\r\n<hr class=\"wp-block-separator\" />\r\n\r\n",
