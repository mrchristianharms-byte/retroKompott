r.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        \r\n<!-- /wp:post-content -->\r\n\r\n<!-- wp:separator --><hr class=\"wp-block-separator\" /><!-- /wp:separator -->\r\n\r\n<!-- wp:separator -->\r\n<p><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS-FEED</a> <a href=\"https://discord.gg/T7NQzF2WRK\">Discord</a> <a href=\"http://www.patreon.com/retrokompott\">PATREON</a> <a href=\"https://steadyhq.com/de/retrokompott\">STEADY</a> <a href=\"http://paypal.me/retrokompott\">PAYPAL</a> <a href=\"https://www.youtube.com/channel/UC3n_WXlK-BlcGAJOMMV2vaQ\">YOUTUBE</a> <a href=\"https://www.twitch.tv/retro_kompott\">TWITCH</a> <a href=\"https://www.facebook.com/retrokompott/\">Facebook</a> <a href=\"https://twitter.com/retrokompott/\">Twitter</a> <a href=\"https://www.instagram.com/retrokompott/\">Instagramm</a></p>\r\n<!-- wp:separator --><hr class=\"wp-block-separator\" /><!-- /wp:separator -->\r\n\r\n<!-- wp:separator -->\r\n<p><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2024-09-02_retrokompott_-_229_-_strike_commander.mp3?\">Download von Folge 229</a></p>\r\n<!-- /wp:separator -->\r\n\r\n<!-- wp:paragraph -->\r\n<pre>mit Patrick, Robin &amp; Selmar</pre>\r\n<pre>Themenexperten:</pre>\r\n<pre>Alexander &amp; Selmar</pre>\r\n<pre>Dauer: 4:03 min</pre>\r\n<hr />\r\n<p><b>Shownotes:</b></p>\r\n<pre><b>allgemeine Podcast Infos:</b></pre>\r\n<pre>Jeden Mittwoch gibt es um 20:15 eine <a href=\"http://www.retrolagerfeuer.de\">Big Box Verkaufsshow</a> auf Twitch\r\n(am ersten Mittwoxch im Monat das Retro Bingo), \r\njeden Donnerstag ab 20 Uhr gibt es den <a href=\"https://blog.retrokompott.de/live-video-stammtisch/\"> LIVE VIDEO STAMMTISCH</a>, \r\njeden Freitag ab 21 Uhr den <a href=\"https://blog.retrokompott.de/01-stammtisch/\"> LIVE AUDIO STAMMTISCH auf Teamspeak</a>.\r\n\r\nUnseren Retro Spiele Club, unser bespielbares Museum in Hamburg Horn \r\nfindet ihr auf <a href=\"http://www.retrospieleclub.de\">www.retrospieleclub.de</a>. \r\n\r\nFuer weitere Infos nutzt gerne unseren Newsletter \r\n(<a href=\"http://www.retrospieleclub.de/newsletter/\">http://www.retrospieleclub.de/newsletter/</a>).\r\n\r\n<b>Inhalt &amp; Zeitmarken:\r\n</b></pre>\r\n<pre>00:00:00 Vorspann und Danksagungen \r\n00:01:30 Heute sind mit dabei \r\n00:01:41 Titelmusik \r\n00:03:01 Retro Warm Up - auf in eine neue Runde \r\n00:14:59 Werbung (Dragonbox Shop)\r\n00:16:42 Retro Facts: Strike Commander\r\n01:47:40 Einspieler: Werbung in eigener Sache\r\n01:49:30 Musik: Echoes of Nostalgia (P. Becher/udio)\r\n01:51:37 Quiz Classics mit Christian (inkl. Hoererfrage)\r\n02:08:04 Retro Talk - Interview mit Thomas Eberle\r\n02:55:18 Musik: Nostalgic Arcade (P. Becher / udio)\r\n02:57:26 Retro Play - Was haben wir gespielt?\r\n03:24:13 Retro News - Neues aus der Szene \r\n03:44:47 Musik: Komiku - Mr Paillettes Theme (Public Domain)\r\n03:45:52 Retro Talk - Neu i. d. Sammlung - 2 Retro Buecher (Christian H.)\r\n03:49:51 Einspieler: Unser Retro Spiele Museum\r\n03:50:41 Retro Credits - Kurz vor Schluss\r\n04:00:11 Abspann\r\n\r\nDauer: 04:03:22</pre>\r\n<pre>HELFT UNS, DIE REGELMAESSIGE AUSSTRAHLUNG UND ZUKUNFT DES PODCASTS ZU SICHERN\r\nUND UNTERSTUETZT UNS AUF<a href=\"http://www.patreon.com/retrokompott\"> PATREON</a>,  ODER<a href=\"http://paypal.me/retrokompott\"> PAYPAL.</a> \r\nZugang zu unserer internen WhatsApp Gruppe erhalten Unterstuetzer automatisch.</pre>\r\n<pre><b>Die gespielten Spiele der Teilnehmer:</b><b> </b></pre>\r\n<pre>Das besondere Spiel:</pre>\r\n<pre>Patrick: Obsession AMIGA\r\nRobin  : Panzer General PC und Playstation</pre>\r\n<pre>… und der Rest:</pre>\r\n<pre>Patrick: Disposable Hero, Mega Typhoon, Pang, R Type Leo, Jeff Minter Story\r\nRobin  : Rebel Assault 1\r\nSelmar : The Crimson Diamond</pre>\r\n<p><strong>Die Links aus den News: </strong></p>\r\n<pre><a href=\"https://jpgames.de/2024/08/legacy-of-kain-ist-mit-einer-neuauflage-zurueck-aber-die-plattform-besitzt-ihr-wahrscheinlich-nicht/\">https://jpgames.de/2024/08/legacy-of-kain-ist-mit-einer-neuauflage-zurueck-aber-die-plattform-besitzt-ihr-wahrscheinlich-nicht/</a>\r\n<a href=\"https://x.com/GWR/status/1823318344927195260\">https://x.com/GWR/status/1823318344927195260</a>\r\n<a href=\"https://twitter.com/GWR/status/1823318344927195260\">Guinness World Records (@GWR) on X</a></pre>\r\n<pre><strong>\r\nDiscord\r\n</strong></pre>\r\n<pre><a href=\"https://www.moddb.com/mods/doom-2-ray-traced\">https://www.moddb.com/mods/doom-2-ray-traced</a>\r\n<a href=\"https://www.moddb.com/mods/doom-2-ray-traced\">Doom 2: RAY TRACED mod</a>\r\n<a href=\"https://www.gamersglobal.de/user-artikel/donkey-kong\">https://www.gamersglobal.de/user-artikel/donkey-kong</a>\r\n<a href=\"https://youtu.be/1Oo2CZWbHXw?si=_YZc6nznNwhUMB-P\">https://youtu.be/1Oo2CZWbHXw?si=_YZc6nznNwhUMB-P</a>\r\n<a href=\"https://www.youtube.com\">YouTube</a>\r\n<a href=\"https://www.youtube.com/channel/UCVeOdA6hDpT_SZ4jhuDXAwA\">Joshua Barretto</a>\r\n<a href=\"https://www.youtube.com/watch?v=1Oo2CZWbHXw\">Audio, Polygon Subdivision, and Much More! [SM64 GBA]</a>\r\n<a href=\"https://www.timeextension.com/news/2024/08/the-snes-has-just-got-its-own-unofficial-super-mario-bros-maker\">https://www.timeextension.com/news/2024/08/the-snes-has-just-got-its-own-unofficial-super-mario-bros-maker</a>\r\n<a href=\"https://www.timeextension.com/news/2024/08/the-snes-has-just-got-its-own-unofficial-super-mario-bros-maker\">The SNES Has Just Got Its Own (Unofficial) Super Mario Bros. Maker</a>\r\n<a href=\"https://stadt-bremerhaven.de/atari-7800-angekuendigt/\">https://stadt-bremerhaven.de/atari-7800-angekuendigt/</a>\r\n<a href=\"https://stadt-bremerhaven.de/\">Caschys Blog</a>\r\n<a href=\"https://stadt-bremerhaven.de/author/caschy/\">caschy</a>\r\n<a href=\"https://stadt-bremerhaven.de/atari-7800-angekuendigt/\">Atari 7800+ angekuendigt</a>\r\n<a href=\"https://x.com/timeextension64/status/1827637506407342209?t=2Vuua_utJAGnXVm6QPlG4Q&amp;s=19\">https://x.com/timeextension64/status/1827637506407342209?t=2Vuua_utJAGnXVm6QPlG4Q&amp;s=19</a>\r\n<a href=\"https://twitter.com/timeextension64/status/1827637506407342209?t=2Vuua_utJAGnXVm6QPlG4Q&amp;s=19\">Time Extension (@timeextension64) on X</a>\r\n<a href=\"https://www.pcgameshardware.de/Spiele-Thema-239104/News/Super-Mario-Rainbow-Stars-Nintendo-Fanprojekt-1454423/\">https://www.pcgameshardware.de/Spiele-Thema-239104/News/Super-Mario-Rainbow-Stars-Nintendo-Fanprojekt-1454423/</a>\r\n<a href=\"https://www.pcgameshardware.de/Spiele-Thema-239104/News/Super-Mario-Rainbow-Stars-Nintendo-Fanprojekt-1454423/\">Kostenlos fuer PC: Neues Super Mario-Fanprojekt fuehlt sich wie die a...</a>\r\n<a href=\"https://www.eurogamer.de/castlevania-dominus-collection-bringt-heute-3-ds-spiele-auf-die-switch\">https://www.eurogamer.de/castlevania-dominus-collection-bringt-heute-3-ds-spiele-auf-die-switch</a>\r\n<a href=\"https://stadt-bremerhaven.de/kult-computer-zx-spectrum-kehrt-zurueck/\">https://stadt-bremerhaven.de/kult-computer-zx-spectrum-kehrt-zurueck/</a>\r\n<a href=\"https://stadt-bremerhaven.de/\">Caschys Blog</a>\r\n<a href=\"https://stadt-bremerhaven.de/author/caschy/\">caschy</a>\r\n<a href=\"https://stadt-bremerhaven.de/kult-computer-zx-spectrum-kehrt-zurueck/\">Kult-Computer ZX Spectrum kehrt zurueck</a>\r\n<a href=\"https://www.gamingonlinux.com/2024/08/emudeck-team-announce-linux-powered-emudeck-machines/\">https://www.gamingonlinux.com/2024/08/emudeck-team-announce-linux-powered-emudeck-machines/</a>\r\n<a href=\"https://www.gamingonlinux.com/2024/08/emudeck-team-announce-linux-powered-emudeck-machines/\">EmuDeck team announce Linux-powered EmuDeck Machines</a>\r\n<a href=\"https://youtu.be/jHS1RJREG2Q\">https://youtu.be/jHS1RJREG2Q</a>\r\n<a href=\"https://www.youtube.com\">YouTube</a>\r\n<a href=\"https://www.youtube.com/channel/UC9Ryt3XOGYBoAJVsBHNGDzA\">Theoretically Media</a>\r\n<a href=\"https://www.youtube.com/watch?v=jHS1RJREG2Q\">AI Doom Changes Games Forever</a></pre>\r\n<pre><strong>\r\nLizenzen &amp; Werbung:</strong></pre>\r\n<pre><strong>Musik Lizenzen:</strong></pre>\r\n<pre>\"Titel, Rubriken &amp; Abspannmusik\"\r\n(Patrick Becher, lizenziert fuer den Retrokompott und seine Projekte, gemafrei)\r\n\r\n\"Echoes of Nostalgia\" \r\n\"Nostalgic Arcade\"\r\nUdio KI/Patrick Becher</pre>\r\n<pre>\"Retro Quiz Title\"\r\n(Christian Ohrens, mit Genehmigung des Urhebers, uneingeschraenktes Nutzungsrecht fuer den Retrokompott und seine Projekte, Instrumente:. Impact Soundworks \"Super Audio Card\" sowie ReFx \"Nexus 4\"=\r\n\r\n\"Mr Paillettes Theme\"\r\nKomiku (Public Domain)\r\n\r\nWir danken unserem Werbepartner fuer die Themenrubrik,\r\nDragonbox (<a href=\"https://dragonbox.de/de/\">https://dragonbox.de/de/</a>)\r\n<b>Kontaktmoeglichkeiten &amp; Infoseiten:\r\n\r\nIhr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren \r\nRetro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten? \r\nPer Mail erreicht man uns unter mail@retrokompott.de Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, \r\nauf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>, oder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>. Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</b>\r\n\r\n<a href=\"http://www.retrospieleclub.de\">www.retrospieleclub.de</a> (unser Museum in Hamburg)\r\n<a href=\"http://www.retrokompott.de\">www.retrokompott.de</a> (unser Podcast)\r\n<a href=\"https://www.twitch.tv/retro_kompott\">https://www.twitch.tv/retro_kompott</a> (unser Twitch Kanal, hier senden wir die Gala LIVE)\r\n<a href=\"https://www.youtube.com/channel/UC3n_WXlK-BlcGAJOMMV2vaQ\">https://www.youtube.com/channel/UC3n_WXlK-BlcGAJOMMV2vaQ</a> (unser Youtube Archiv)\r\n<a href=\"http://facebook.com/retrospieleclub\">facebook.com/retrospieleclub</a> (unser Museum auf Facebook)\r\n<a href=\"https://www.facebook.com/retrokompott\">https://www.facebook.com/retrokompott</a> (unser Podcast auf Facebook)\r\n<a href=\"http://twitter.com/retrokompott\">twitter.com/retrokompott</a> (unser Twitter Account)\r\n<a href=\"http://instagram.com/retrokompott\">instagram.com/retrokompott</a> (Instagram)\r\n<a href=\"http://patreon.com/retrokompott\">patreon.com/retrokompott</a> (Patreon)\r\n<a href=\"http://steadyhq.com/retrokompott\">steadyhq.com/retrokompott </a>(Steady)\r\n<a href=\"https://discord.gg/T7NQzF2WRK\">https://discord.gg/T7NQzF2WRK</a> (Discord)\r\n<a href=\"https://www.paypal.me/retrokompott\">https://www.paypal.me/retrokompott</a> (Spendenlink fuer Projekte)\r\n\r\nDer Retrokompott Podcast ist eine Produktion der Fa. Com Illusion Gbr., Abt. Medienpublikation, \r\nweitere Informationen findet man hier: \r\n<a href=\"https://blog.retrokompott.de/impressum/\">https://blog.retrokompott.de/impressum/</a>, \r\n<a href=\"https://blog.retrokompott.de/datenschutz/\">https://blog.retrokompott.de/datenschutz/</a>.\r\n\r\n</pre>\r\n<pre><b>Viel Spass wuenscht das Retrokompott Team.</b></pre>\r\n<pre>#Folge #Zeitreise #Homecomputer #Spielekonsolen #Games #Retrokompott #Podcast #C64\r\n#StrikeCommander #Origin #AMIGA #MSDOS #commodore #Thomas Eberle #patreon #steady #Live  \r\n#retrospieleclub #quiz</pre>\r\n<p>&nbsp;</p>\r\n<hr class=\"wp-block-separator\" /><!-- /wp:paragraph -->\r\n\r\n<!-- wp:separator /--><!-- /wp:separator -->",
