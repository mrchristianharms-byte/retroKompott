,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 070 - CPC Part II Teil1\",\"subtitle\":null,\"summary\":null,\"duration\":\"7:40:51\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:01:42\",\"title\":\"Vierzeiler\"},{\"start\":\"00:01:54\",\"title\":\"Titelmusik\"},{\"start\":\"00:03:11\",\"title\":\"Heute sind mit dabei   \"},{\"start\":\"00:03:22\",\"title\":\"Retro Warm Up - auf in eine neue Runde    \"},{\"start\":\"00:16:20\",\"title\":\"Retro Facts: CPC Part 2 Teil 1\"},{\"start\":\"01:32:13\",\"title\":\"Pausenmusik - Anatol Locker Crush\\u2019d [disquiet0122-8bET]\"},{\"start\":\"01:35:23\",\"title\":\"Retro Mysteries - Gast Holger Aurich\"},{\"start\":\"02:06:29\",\"title\":\"Retro Talk - Interview Anatol Locker\"},{\"start\":\"03:15:32\",\"title\":\"Pausenmusik - Anatol Locker Raiden [disquiet0155-mixmatch]\"},{\"start\":\"03:19:40\",\"title\":\"Retro Play - das Resume Tilt Codemasters\"},{\"start\":\"03:24:59\",\"title\":\"Retro Play - Was sollen wir spielen? Monster Buster C64\"},{\"start\":\"03:26:48\",\"title\":\"Retro Talk - Axel Ehrich \\u00fcber den CPC\"},{\"start\":\"03:42:07\",\"title\":\"Retro Talk - Kordanor \\u00fcber Lands of Lore\"},{\"start\":\"03:46:42\",\"title\":\"Retro Talk - PoP Burntime mit Derk, Robin &amp; Selmar\"},{\"start\":\"04:57:16\",\"title\":\"Retro Talk - Rollenspiel Test mit Andreas, Patrick &amp; Fabskimo\"},{\"start\":\"06:42:12\",\"title\":\"Pausenmusik (Buf of NCI)\"},{\"start\":\"06:43:20\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"07:09:32\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"07:30:14\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"07:37:50\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2018-07-21_retrokompott_-_070_-_cpc_part2_teil1.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        </p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">HELFT UNS DIE REGELMESSIGE AUSSTRAHLUNG UND ZUKUNFT DES PODCASTS ZU SICHERN UND UNTERSTUETZT UNS<br />\nAUF <a href=\"http://www.patreon.com/retrokompott\">PATREON</a> ODER <a href=\"http://paypal.me/retrokompott\">PAYPAL</a> (hier gibt es <a href=\"https://blog.retrokompott.de/you-tube-videos/\">BONUS VIDEOS</a> freizuschalten)</p>\n<p style=\"text-align: center;\">weitere Infos in diesem <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-06-10_retrokompott_patreon_special_001.mp3?\">PATREON Special Podcast</a></p>\n<hr />\n<hr />\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<p><a href=\"https://blog.retrokompott.de/wp-content/uploads/2018/07/folgenbild_71.jpg\"><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-2381\" src=\"https://blog.retrokompott.de/wp-content/uploads/2018/07/folgenbild_71.jpg\" alt=\"\" width=\"542\" height=\"542\" srcset=\"https://blog.retrokompott.de/wp-content/uploads/2018/07/folgenbild_71.jpg 1440w, https://blog.retrokompott.de/wp-content/uploads/2018/07/folgenbild_71-150x150.jpg 150w, https://blog.retrokompott.de/wp-content/uploads/2018/07/folgenbild_71-300x300.jpg 300w, https://blog.retrokompott.de/wp-content/uploads/2018/07/folgenbild_71-768x768.jpg 768w, https://blog.retrokompott.de/wp-content/uploads/2018/07/folgenbild_71-1024x1024.jpg 1024w, https://blog.retrokompott.de/wp-content/uploads/2018/07/folgenbild_71-144x144.jpg 144w\" sizes=\"auto, (max-width: 542px) 100vw, 542px\" /></a></p>\n<p>Robin:</p>\n<p>Irgendwas stimmt hier heute nicht und es liegt NICHT an der Hitze</p>\n<p>Fabskimo:</p>\n<p>Irgendwas ist hier durcheinander</p>\n<p>Andreas:</p>\n<p>Wo ist meine Bastelrubrik ?</p>\n<p>Fabskimo:</p>\n<p>Haben wir keine Emails bekommen ?</p>\n<p>Patrick:</p>\n<p>Es ist alles wie immer, nur manches an anderer Stelle 🙂</p>\n<hr />\n<hr />\n<p><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-07-21_retrokompott_-_070_-_cpc_part2_teil1.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 70</a></p>\n<p><a href=\"https://www.patreon.com/posts/nachlese-zur-70-20208446\">N70</a> 20.07.2018 0h22min   Nachlese Folge 70   <a href=\"https://www.patreon.com/posts/nachlese-zur-70-20208446\">fuer Patreonen</a></p>\n</div>\n<p style=\"text-align: center;\">mit Patrick, Robin, Fabskimo &amp; Andreas</p>\n<p style=\"text-align: center;\">und als Themenexperten Fabskimo, Juergen &amp; Andreas</p>\n<p style=\"text-align: center;\">(Aufnahmedatum des Themas: 20.06.2018)</p>\n<p style=\"text-align: center;\">Dauer: 7h41</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Die naechsten LIVE Termine auf <a href=\"http://www.mixlr.com/retrokompott\">www.mixlr.com/retrokompott:</a></p>\n<p style=\"text-align: center;\">03.08.2018 22:00 Aufzeichnung Rahmenprogramm CPC Part2 Teil2</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Ihr wollt beim Retrokompott mitmachen?</p>\n<div style=\"text-align: center;\">\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a><br />\noder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL<br />\n(als Belohnung schalten wir <a href=\"https://blog.retrokompott.de/you-tube-videos/\">Videos</a> frei),<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzeichnung<br />\ndes naechsten Themas als erstes!</p>\n<p>ab 3$ im Monat<br />\n&#8222;Robins Retro Woche&#8220; (<a href=\"https://www.patreon.com/posts/robins-retro-19808649\">aktuelle Folge 11</a>)<br />\n&#8222;Patrick am Pranger&#8220; (<a href=\"https://www.patreon.com/posts/patrick-am-folge-20208293\">aktuelle Folge 10</a>)</p>\n<hr />\n<hr />\n<p>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</p>\n<p>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></p>\n</div>\n<div>\n<div>\n<p>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</p>\n<p>&nbsp;</p>\n<div>\n<hr />\n</div>\n</div>\n<hr />\n<p>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</p>\n</div>\n</div>\n</div>\n<p>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</p>\n<div>\n<hr />\n<hr />\n<p>Werbung in eigener Sache:</p>\n</div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken</a></p>\n<p>&nbsp;</p>\n</div>\n</div>\n<hr />\n<hr />\n<p>Die Links und weiterfuehrenden Infos zum Podcast:</p>\n</div>\n</div>\n<p style=\"text-align: center;\">Die Musik fuer diese Folge stammt von Bug of NCI</p>\n<p style=\"text-align: center;\">und von unserem Interviewgast Anatol Locker:</p>\n<p style=\"text-align: center;\">Crush’d [disquiet0122-8bET]</p>\n<p style=\"text-align: center;\">Raiden [disquiet0155-mixmatch]</p>\n<p style=\"text-align: center;\">(Creative Commons Share Alike)</p>\n<p style=\"text-align: center;\">Hier gibt es mehr:</p>\n<p><iframe loading=\"lazy\" title=\"analoc\" width=\"550\" height=\"450\" scrolling=\"no\" frameborder=\"no\" src=\"https://w.soundcloud.com/player/?visual=true&#038;url=https%3A%2F%2Fapi.soundcloud.com%2Fusers%2F18669&#038;show_artwork=true&#038;maxheight=825&#038;maxwidth=550\"></iframe></p>\n<p style=\"text-align: center;\">Saemtliche Musik ist gemafrei.</p>\n<p style=\"text-align: center;\">Die weiterfuehrendne Links:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.japandoku.de/\">www.japandoku.de</a></p>\n<p style=\"text-align: center;\"><a href=\"https://groupees.com/remutexx\">https://groupees.com/remutexx</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.playerone.de/2018/07/07/die-25-besten-spiele-fuer-den-commodore-amiga/\">https://www.playerone.de/2018/07/07/die-25-besten-spiele-fuer-den-commodore-amiga/</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.spiegel.de/netzwelt/games/internationale-computerspielsammlung-unsere-vision-ist-ein-house-of-games-a-1217074.html\">http://www.spiegel.de/netzwelt/games/internationale-computerspielsammlung-unsere-vision-ist-ein-house-of-games-a-1217074.html</a></p>\n<p style=\"text-align: center;\"><a href=\"http://mag.shock2.info/mega-man-legacy-kollektionen-erscheinen-mit-rookie-hunter-modus/\">Mega Man Legacy Kollektionen erscheinen mit Rookie Hunter Modus</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.homecomputermuseum.nl/\">https://www.homecomputermuseum.nl/</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.retromagazine.eu/retro/2018-07/veranstaltung-7-luhecon-4-august-2018-winsen-an-der-luhe-deutschland/\"><b>Veranstaltung: 7. LuheCon, 4. August 2018, Winsen an der Luhe, Deutschland</b></a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.digisaurier.de/verlorenes-wissen-von-rs232-jumpern-und-anderen-dingen-1/\">https://www.digisaurier.de/verlorenes-wissen-von-rs232-jumpern-und-anderen-dingen-1/</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.indieretronews.com/2018/07/giana-sisters-special-edition-amiga.html?m=0\">https://www.indieretronews.com/2018/07/giana-sisters-special-edition-amiga.html?m=0</a></p>\n<p style=\"text-align: center;\"><a href=\"http://ejagfest.de/\">http://ejagfest.de/</a></p>\n<hr />\n<div id=\"magicdomid510\">\n<p style=\"text-align: center;\">Naechste Rahmenprogrammaufzeichnung:</p>\n<p style=\"text-align: center;\">LIVE: 03.08.2018<br />\nLIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a></p>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></p>\n<p style=\"text-align: center;\">weitere Infos in der Textdatei.<br />\nDiese wird regelmaessig aktualisiert,<br />\nes kommen auch noch C64 &amp; Konsolenspiele dazu.</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">\n</div>\n",
