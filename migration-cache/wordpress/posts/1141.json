,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 038 - Rainbow Arts Part 2\",\"subtitle\":null,\"summary\":null,\"duration\":\"7:56:52\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:00:18\",\"title\":\"Vierzeiler\"},{\"start\":\"00:00:34\",\"title\":\"Titelmusik\"},{\"start\":\"00:01:52\",\"title\":\"Heute sind mit dabei\"},{\"start\":\"00:02:03\",\"title\":\"Retro Warm Up - auf in eine neue Runde\"},{\"start\":\"00:43:10\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"01:16:00\",\"title\":\"Retro Play - was sollen wir spielen ?\"},{\"start\":\"01:19:22\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"01:20:30\",\"title\":\"Retro Play - das Resumee\"},{\"start\":\"01:21:01\",\"title\":\"Retro Play - Barbarian (Palace) C64\"},{\"start\":\"01:35:44\",\"title\":\"Retro Play - Pang C64\"},{\"start\":\"01:43:55\",\"title\":\"Retro Facts - Rainbow Arts ab 1989\"},{\"start\":\"03:47:12\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"03:48:33\",\"title\":\"Retro Talk - auf ein Wort\"},{\"start\":\"03:48:42\",\"title\":\"Roman - Muds\"},{\"start\":\"03:55:21\",\"title\":\"Carsten Borgmeier - Rainbow Arts\"},{\"start\":\"04:14:48\",\"title\":\"Wolfgang: Rainbow Arts\"},{\"start\":\"04:20:29\",\"title\":\"PoP: task Force 1942\"},{\"start\":\"05:06:47\",\"title\":\"Retro Talk - Interview Joerg Langer\"},{\"start\":\"06:38:34\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"06:39:24\",\"title\":\"Retro Mysteries - R\\u00e4tsel aus der Vergangenheit\"},{\"start\":\"07:11:04\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"07:43:37\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"07:53:49\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2017-04-29_retrokompott_-_038_-_rainbow_arts_part2.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        <br />\n<a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2017-04-29_retrokompott_-_038_-_rainbow_arts_part2.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 38</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.patreon.com/posts/9571910\">N05</a> 14.04.2017 0h33in   Nachlese Folge 38   <a href=\"https://www.patreon.com/posts/9571910\">exclusiv fuer Patreon</a><a href=\"https://www.patreon.com/posts/die-nachlese-zur-8832336\"><br />\n</a>bisher nicht ausgestrahlt: &#8211;</p>\n<p style=\"text-align: center;\">\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<hr />\n<p>Aufnahmedatum: 12.04.2017 &amp; 28.04.2017<br />\nmit Patrick, Robin, Wolfgang &amp; Fabskimo<br />\nDauer: 7h57</p>\n<div id=\"magicdomid8\">\n<div>\n<hr />\n</div>\n<div></div>\n<p>Robin:</p>\n<p>…. Ich traeume von alten Verpackungen und dicken Handbuechern</p>\n<p>Selmar:<br />\n&#8230; Retro Grafik ist fast eine Kunstform</p>\n<p>&nbsp;</p>\n<p>Fabskimo:<br />\n&#8230; ich will immer nur GPL spielen</p>\n<p>&nbsp;</p>\n<p>Wolfgang:<br />\n… ich habe immer noch Rainbow Arts in meinem Kopf</p>\n<p>&nbsp;</p>\n<p>Patrick:<br />\n&#8230; dann seid ihr doch alle richtig beim Retrokompott  🙂</p>\n<div></div>\n</div>\n<div>\n<div id=\"magicdomid6\">\n<div style=\"text-align: center;\">\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<hr />\n<div id=\"magicdomid651\">\n<h2><span style=\"text-decoration: underline;\"><strong>Ihr wollt beim Retrokompott mitmachen?</strong></span></h2>\n</div>\n<h3>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a>,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzecichnung<br />\ndes naechsten Themas als erstes!</h3>\n<div> Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</div>\n<div>\n<p>An unser Verlosung nimmt jeder teil, der uns einen Audiokommentar fuer die Retrotalk Rubrik schickt<br />\nund den Vermerk Verlsoung + eigene Adresse mit angibt.<br />\nPatreon Unterstuetzer koennen auch<br />\nohne Audiokommentar an der Verlosung teilnehmen.</p>\n</div>\n</div>\n</div>\n<div id=\"magicdomid10\">\n<div>\n<div></div>\n<div>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></div>\n<div></div>\n<div>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unser <a href=\"http://www.retrokompott.de\">Homepage</a>.<br />\nUnser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR</a></div>\n<div>\n<p>Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abbonieren.</p>\n</div>\n<div></div>\n</div>\n</div>\n<hr />\n<div></div>\n<div id=\"magicdomid92\">Die Links und weiterfuehrenden Infos zum Podcast:</div>\n</div>\n<div></div>\n<div>\n<p><b>Rainbow Arts Part 2</b></p>\n<p><b>1989</b></p>\n<p><a href=\"http://www.gamesthatwerent.com/gtw64/arcadian/\">A</a>idon C64<a href=\"http://www.gamesthatwerent.com/gtw64/arcadian/\">Arcadian</a> C64</p>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/2131/\">Circus Attractions</a></p>\n<p><a href=\"https://www.c64-wiki.de/wiki/Grand_Monster_Slam\"><br />\nGrand Monster Slam</a></p>\n<p>&nbsp;</p>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/255/\">Danger Freak</a></p>\n<p><a href=\"https://www.c64-wiki.de/wiki/Hard%27n%27Heavy\"><br />\nHard&#8217;n&#8217;Heavy</a></p>\n<p><a href=\"https://www.c64-wiki.de/wiki/Spherical\">Spherical</a></p>\n<p><a href=\"http://www.lemon64.com/?mainurl=http%3A//www.lemon64.com/games/details.php%3FID%3D2819\"><br />\nWarriors</a></p>\n<p><a href=\"https://www.c64-wiki.de/wiki/X-Out\">X-OutOxxonian</a></p>\n</div>\n<p>&nbsp;</p>\n<div>\n<h3><b>1990</b><b></b></h3>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/7143/\"><br />\n3001 O&#8217;Connor&#8217;s Fight</a></p>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/1107/\"><br />\nCurse of RA</a></p>\n<p>Apprentice</p>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/3201/\">East vs. West: Berlin 1948</a></p>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/977/\">Masterblazer</a></p>\n<p><a href=\"https://www.c64-wiki.de/wiki/Sunny_Shine_-_On_the_Funny_Side_of_Life\">Sunny Shine</a></p>\n<p><a href=\"https://de.wikipedia.org/wiki/M.U.D.S.\">M.U.D.S.</a></p>\n<p><a href=\"https://www.c64-wiki.de/wiki/Turrican\">Turrican</a></p>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/353/\">Z-Out</a></p>\n<p><b>1991</b></p>\n<p><a href=\"https://www.c64-wiki.de/wiki/Log%21cal\">Logical</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.c64-wiki.de/wiki/Turrican_II\">Turrican II</a></p>\n<p><a href=\"https://de.wikipedia.org/wiki/Mad_TV\">Mad TV</a></p>\n<h3></h3>\n<h3><b>1992</b><b></b></h3>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/1538/\">Vision &#8211; The 5 Dimension Utopia</a></p>\n<h3><b>1993</b><b></b></h3>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/3572/\">Flies Attack on Earth</a></p>\n<p><a href=\"http://www.ebay.de/itm/Sound-FX-MACS-OPERA-Rainbow-Arts-1992-BigBox-Boxed-PC-DOS-Retro-Disk-5-25/141259376078\">Sound FX MACS OPERA</a></p>\n<p><a href=\"https://de.wikipedia.org/wiki/Turrican#Turrican_3:_Payment_Day\">Turrican 3</a></p>\n<h3><b>1994</b><b></b></h3>\n<p>Farben Spiele PC Rainbow Kids</p>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/530/\">Lollypo</a></p>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/3971/\">Hurra Deutschland</a></p>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/914/\">St.Thomas</a></p>\n<h3></h3>\n<h3><b>1995</b><b></b></h3>\n<p><a href=\"http://www.mobygames.com/game/snes/rendering-ranger-r\">Rendering Ranger R²</a></p>\n<h3></h3>\n<h3><b>1996</b><b></b></h3>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/6759/\">Claim to Power</a></p>\n<p><a href=\"http://www.kultboy.com/testbericht-uebersicht/5539/\">Imperium Romanum</a></p>\n<h3></h3>\n<h3><b>1998</b><b></b></h3>\n<p><a href=\"https://www.youtube.com/watch?v=9VXALO7Wjl8\">Turrican 3D</a></p>\n<h3></h3>\n<h3><b>&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8211;</b></h3>\n<p><b>TOP 10 Hitlisten Rainbow Arts komplett<br />\n</b></p>\n<p>&nbsp;</p>\n<p>C64:</p>\n<p><b>10.0 giana sisters</b><b>9.5 katakis</b></p>\n<p><b>9.5 turrican ii</b></p>\n<p><b>9.0 rtype</b></p>\n<p><b>8.5 To be on Top</b></p>\n<p><b>8.5 turrican</b></p>\n<p><b>8.5 x-out</b></p>\n<p><b>7.5 hardn heavy</b></p>\n<p><b>7.5 curse of ra</b></p>\n<p><b>7.0 logical</b></p>\n<p><b>7.0 spherical</b></p>\n<p><b>7.0 madness</b><br />\n<b>Amiga</b></p>\n<p><b>9.5 turrican ii</b></p>\n<p><b>9.5 turrican iii</b></p>\n<p><b>8.5 turrican</b></p>\n<p><b>8.0 giana sisters</b></p>\n<p><b>8.0 rtype</b></p>\n<p><b>8.0 z-out</b></p>\n<p><b>8.0 x-out</b></p>\n<p><b>8.0 hardn heavy</b></p>\n<p><b>8.0 mad tv</b></p>\n<p><b>7.5 curse of ra</b></p>\n<p><b>7.5 logical</b></p>\n<p><b>7.5 lollipop</b></p>\n</div>\n<h3><b>&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8211;</b></h3>\n<p><a href=\"http://www.faz.net/aktuell/feuilleton/medien/entwickler-lehnen-deutschen-computerspielpreis-ab-14990528.html\">Entwickler lehnen deutschen computerspielpreis ab</a></p>\n<p><a href=\"http://www.bild.de/spiele/spiele-news/deutscher-computerspielpreis/computerspielpreis-eklat-mimimi-51504028.bild.html\">http://www.bild.de/spiele/spiele-news/deutscher-computerspielpreis/computerspielpreis-eklat-mimimi-51504028.bild.html</a></p>\n<p><a href=\"https://www.heise.de/newsticker/meldung/Ende-fuer-die-Nintendo-Classic-Mini-3686206.html\">Ende fuer die Nintendo-Classic-Mini</a><br />\n<a href=\"http://www.computerbild.de/artikel/cbs-News-PC-Super-Nintendo-Classic-Mini-SNES-17066439.html\">CBS-News: Super-Nintendo-Classic-Mini-SNES</a><br />\n<a href=\"http://www.indieretronews.com/2017/04/nemesis-enhanced-gradius-blasts-its-way.html?m=1\">Tipp von Toni Galvez: Nemesis &#8211; An enhanced Gradius blasts its way onto the MSX2</a><br />\n<a href=\"http://olduse.net/\">olduse.net &#8211; Usenet, updated in real time as it was thirty years ago.</a><br />\n<a href=\"http://xproger.info/projects/OpenLara/\">OpenLara &#8211; Lara Croft im Browser spielen</a><br />\n<a href=\"https://www.fig.co/campaigns/phoenix-point\">Phoenix Point das neue Strategiespiel vom Entwickler der original X-COM Serie.</a><br />\n<a href=\"https://www.heise.de/newsticker/meldung/Streaming-Tipp-Die-Amiga-Story-vorab-in-der-ZDF-Mediathek-3697687.html\">die Amiga Story in der ZDF-Mediathek</a><br />\n<a href=\"http://www.lemon64.com/forum/viewtopic.php?p=780914&amp;sid=b64eaa9aa915742cecbb03818e27ce13\">MEGA 65 Prototyp Board is ready (german video)</a><br />\n<a href=\"http://www.highsnobiety.com/2017/04/11/bandai-tamagotchi-2017-return/\">The Original Tamagotchi Is Back &amp; You Can Buy One Right Now</a><br />\n<a href=\"http://www.chip.de/artikel/Besser-