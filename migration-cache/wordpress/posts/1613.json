n    <tab name=\"transcripts\">\n      <tab-transcripts></tab-transcripts>\n    </tab>\n    <tab name=\"files\">\n      <tab-files></tab-files>\n    </tab>\n    <tab name=\"playlist\">\n      <tab-playlist></tab-playlist>\n    </tab>\n    <tab name=\"share\">\n      <tab-share></tab-share>\n    </tab>\n    <tab-overflow></tab-overflow>\n  </div>\n  <error></error>\n</root>\n</div>\n            <script>\n              document.addEventListener(\"DOMContentLoaded\", function() {\n                var player = document.getElementById(\"player-6aee478fd1979\");\n                podlovePlayerCache.add([null, {\"url\":\"https:\\/\\/blog.retrokompott.de\\/wp-json\\/podlove-web-player\\/shortcode\\/config\\/retrokompott\\/theme\\/retrokompott\",\"data\":{\"activeTab\":\"chapters\",\"subscribe-button\":null,\"share\":{\"channels\":[\"facebook\",\"twitter\",\"whats-app\",\"linkedin\",\"pinterest\",\"xing\",\"mail\",\"link\"],\"outlet\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/share.html\",\"sharePlaytime\":true},\"related-episodes\":{\"source\":\"disabled\",\"value\":null},\"version\":5,\"theme\":{\"tokens\":{\"brand\":\"#15C0E6\",\"brandDark\":\"#235973\",\"brandDarkest\":\"#1A3A4A\",\"brandLightest\":\"#E9F1F5\",\"shadeDark\":\"#807E7C\",\"shadeBase\":\"#807E7C\",\"contrast\":\"#000\",\"alt\":\"#fff\"},\"fonts\":{\"ci\":{\"name\":\"ci\",\"family\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":800},\"regular\":{\"name\":\"regular\",\"family\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":300},\"bold\":{\"name\":\"bold\",\"family\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 052 - neue C64 Spiele Part 2\",\"subtitle\":null,\"summary\":null,\"duration\":\"4:55:20\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:00:53\",\"title\":\"Vierzeiler\"},{\"start\":\"00:01:01\",\"title\":\"Titelmusik\"},{\"start\":\"00:02:18\",\"title\":\"Heute sind mit dabei\"},{\"start\":\"00:02:30\",\"title\":\"Retro Warm Up - auf in eine neue Runde mit Gaesten\"},{\"start\":\"00:47:25\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"01:12:18\",\"title\":\"Retro Facts: neue C64 Spiele PART 2\"},{\"start\":\"02:38:28\",\"title\":\"PAUSENMUSIK dance-fairy dragee2 (Sputnik)\"},{\"start\":\"02:39:56\",\"title\":\"Retro Mysteries Quiz mit Robert\"},{\"start\":\"03:01:00\",\"title\":\"Retro Mysteries Soundquiz mit Geo\\/GIJoe\"},{\"start\":\"03:18:11\",\"title\":\"Retro Play - Was sollen wir spielen? AGENT USA C64\"},{\"start\":\"03:20:46\",\"title\":\"PAUSENMUSIK chippydoodle-psy (Sputnik)\"},{\"start\":\"03:21:38\",\"title\":\"Retro Play - das Resumee Parsec C64\"},{\"start\":\"03:30:12\",\"title\":\"Retro Talk - Caroline Cliffords Retro game Slam Berlin\"},{\"start\":\"03:42:45\",\"title\":\"Retro Talk - Interview mit Mel Croucher\"},{\"start\":\"04:26:52\",\"title\":\"PAUSENMUSIK euphonic excrescenz (Sputnik)\"},{\"start\":\"04:31:28\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"04:41:41\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"04:52:20\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2017-11-11_retrokompott_-_052_-_neue_c64_spiele_part2.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        <br />\n<a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2017-11-11_retrokompott_-_052_-_neue_c64_spiele_part2.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 52</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.patreon.com/posts/nachlese-zur-52-15325490\">N19</a> 10.11.2017 0h30min   Nachlese Folge 52   <a href=\"https://www.patreon.com/posts/nachlese-zur-52-15325490\">heute fuer Alle </a></p>\n<p style=\"text-align: center;\">Die Nachlese der Folge 52, direkt vom Amiga Meeting aus Neumuenster.</p>\n<p style=\"text-align: center;\">Da unser Hauptpodcast dieses Mal unter Serverproblemen und anderen techn. Problemen litt (daher verzoegert sich die Veroeffentlichung auch noch), geben wir die Nachlese heute fuer alle frei. So kommen auch die &#8222;normalen Hoerer&#8220; mal in den Genuss die Nachlese zu hoeren, die ja sonst unseren Patreon Unterstuetzern vorbehalten ist. Viel Spass!</p>\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<hr />\n<p>Aufnahmedatum: 26.10.2017 &amp; 10.11.2017<br />\nmit <b>Robin, Patrick, Fabskimo, Phillipp<br />\n</b></p>\n<p><b>und als Themenexperten Patrick, Fabskimo, Phillipp</b></p>\n<p>Dauer: 4h55</p>\n<div id=\"magicdomid8\">\n<div>\n<hr />\n</div>\n<div>\n<p>Robin:</p>\n<p>Hier laufen so viele Leute rum und es ist so laut</p>\n<p>&nbsp;</p>\n<p>Patrick:</p>\n<p>Keine Ahnung wo wir hier gelandet sind</p>\n<p>&nbsp;</p>\n<p>Fabskimo:</p>\n<p>&#8230; keine Angst, das sind nur Amiga Fans, die wollen nur spielen!</p>\n</div>\n</div>\n<div>\n<div id=\"magicdomid6\">\n<div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<hr />\n<div id=\"magicdomid651\">\n<h2><strong>Ihr wollt beim Retrokompott mitmachen?</strong></h2>\n</div>\n<h3>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a><br />\noder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzeichnung<br />\ndes naechsten Themas als erstes!</h3>\n<div>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</div>\n<div>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></div>\n</div>\n<div>\n<div>\n<div>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</div>\n</div>\n<div>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</div>\n</div>\n</div>\n</div>\n<div>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</div>\n<div></div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<div>&#8230;</div>\n<div>&#8212;</div>\n<div>Das Rahmenprogramm zeichnen wir jeden zweiten Freitag<br />\nLIVE auf: <a href=\"http://www.mixlr.com/retrokompott\">www.mixlr.com/retrokompott</a></div>\n<div>&#8212;</div>\n<div>\n<p>Werbung in eigener Sache:</p>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken<br />\n</a>&#8230;</p>\n</div>\n<div></div>\n</div>\n</div>\n<hr />\n<div></div>\n<div>\n<p>Die Links und weiterfuehrenden Infos zum Podcast:</p>\n</div>\n</div>\n</div>\n<div>\n<p>Die Musik fuer diese Folge stammt von Bug of NCI &amp; Sputnik, ausser es wurde anders erwaehnt. Saemtliche Musik ist gemafrei.</p>\n<p>&nbsp;</p>\n<p><a href=\"http://oiger.de/2017/10/31/raritaet-der-heimcomputer-aera-c65-aufgetaucht/165659\">http://oiger.de/2017/10/31/raritaet-der-heimcomputer-aera-c65-aufgetaucht/165659</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.ebay.de/itm/Ultra-rare-Commodore-65-RAM-Expansion-C65-DX64-C90-prototype-working/322853882595?hash=item4b2b974ae3:g:neoAAOSwl65Z9gp8\">https://www.ebay.de/itm/Ultra-rare-Commodore-65-RAM-Expansion-C65-DX64-C90-prototype-working/322853882595?hash=item4b2b974ae3:g:neoAAOSwl65Z9gp8</a></p>\n<p>&nbsp;</p>\n</div>\n<p>&nbsp;</p>\n<div>\n<p><a href=\"https://www.swr3.de/aktuell/nachrichten/Ein-Pac-im-Kornfeld-Pac-Man-im-Real-Life/-/id=47428/did=4568258/1kfiqzm/index.html\">https://www.swr3.de/aktuell/nachrichten/Ein-Pac-im-Kornfeld-Pac-Man-im-Real-Life/-/id=47428/did=4568258/1kfiqzm/index.html</a></p>\n<p>&nbsp;</p>\n<p><a href=\"http://reset.cbm8bit.com/\">http://reset.cbm8bit.com/</a></p>\n<p><a href=\"http://amitopia.com/max-knight-is-a-totally-new-amiga-game-released-for-free-on-aminet/\">max knight is a totally new amiga-game released for free on aminet</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.golem.de/news/sakura-echtes-floppy-laufwerk-fuer-amiga-disketten-1501-111743.html\">https://www.golem.de/news/sakura-echtes-floppy-laufwerk-fuer-amiga-disketten-1501-111743.html</a></p>\n<p>&nbsp;</p>\n</div>\n<p>&nbsp;</p>\n<div>\n<p><a href=\"http://amitopia.com/the-amazing-vampire-effect-at-amiga32/\">http://amitopia.com/the-amazing-vampire-effect-at-amiga32/</a></p>\n</div>\n</div>\n</div>\n</div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\">&#8230;&#8230;&#8230;&#8230;&#8230;&#8230;&#8230;.</div>\n<div id=\"magicdomid510\">\n<div style=\"text-align: center;\">\n<p>Naechste Rahmenprogrammaufzeichnung:<br />\nACHTUNG!!! AUSNAHMSWEISE DONNERSTAG</p>\n</div>\n<div style=\"text-align: center;\">\n<p>LIVE:  23.11.2017 18:00 Uhr</p>\n<p>LIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a><br />\n(Thema als Aufzeichnung vorausichtlich ab 20:00 Uhr)</p>\n<p>Thema: Jaguar</p>\n</div>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></p>\n<p style=\"text-align: center;\">weitere Infos in der Textdatei.<br />\nDiese wird regelmaessig aktualisiert,<br />\nes kommen auch noch C64 &amp; Konsolenspiele dazu.</p>\n</div>\n",
