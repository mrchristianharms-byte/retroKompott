,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 045 - Crossover Zankstelle Part 2\",\"subtitle\":null,\"summary\":null,\"duration\":\"5:08:27\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:00:58\",\"title\":\"Vierzeiler\"},{\"start\":\"00:01:13\",\"title\":\"Titelmusik\"},{\"start\":\"00:02:32\",\"title\":\"Heute sind mit dabei\"},{\"start\":\"00:02:43\",\"title\":\"Retro Warm Up - auf in eine neue Runde\"},{\"start\":\"00:21:00\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"00:32:10\",\"title\":\"Retro Facts: Das Thema Crossover Zankstelle PART 1\"},{\"start\":\"02:10:35\",\"title\":\"PAUSENMUSIK (Phillip Gross)\"},{\"start\":\"02:11:22\",\"title\":\"Retro Play - Was sollen wir spielen?\"},{\"start\":\"02:13:10\",\"title\":\"PAUSENMUSIK (Phillip Gross)\"},{\"start\":\"02:15:13\",\"title\":\"Retro Play - das Resumee Lupo Alberto\"},{\"start\":\"02:27:57\",\"title\":\"Retro Talk - Night of the Pods\"},{\"start\":\"03:12:53\",\"title\":\"Retro Talk - Wirklich boeses Kind\"},{\"start\":\"03:29:20\",\"title\":\"Retro Talk - PoP Super Mario 2\"},{\"start\":\"04:24:41\",\"title\":\"Retro Talk - Interview: Gari Biasillo\"},{\"start\":\"04:57:01\",\"title\":\"PAUSENMUSIK (Phillip Gross)\"},{\"start\":\"04:59:05\",\"title\":\"Retro Mysteries\"},{\"start\":\"04:59:24\",\"title\":\"Retro Mysteries - Ger\\u00e4uscheraten\"},{\"start\":\"05:14:40\",\"title\":\"Retro Mysteries - Quiz mit der Zankstelle\"},{\"start\":\"05:37:45\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"05:55:37\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"06:07:22\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2017-08-06_retrokompott_-_045_-_crossover_zankstelle.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        <br />\n<a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2017-08-06_retrokompott_-_045_-_crossover_zankstelle.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 45</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.patreon.com/posts/nachlese-folge-13684622\">N12</a> 04.08.2017 0h34min   Nachlese Folge 45   <a href=\"https://www.patreon.com/posts/nachlese-folge-13684622\">exclusiv fuer Patreon</a><a href=\"https://www.patreon.com/posts/die-nachlese-zur-8832336\"><br />\n</a></p>\n</div>\n<div id=\"magicdomid99\">\n<hr />\n<p style=\"text-align: center;\">Aufnahmedatum: 26.07.2017 &amp; 04.08.2017<br />\nmit <b>Robin, Patrick, Juergen, Jonas &amp; Sebastian  </b>und Hendrik<br />\nDauer: 6h10</p>\n<div id=\"magicdomid8\">\n<div>\n<hr />\n</div>\n<p style=\"text-align: center;\">Patrick:<br />\nSelbst mit Gaesten von kuerzeren Podcasts haben wir ein Problem</p>\n<p style=\"text-align: center;\">Fabskimo:<br />\nWieso ? Habt ihr die Zankstelle auch zugequatscht<br />\nund nicht zu Wort kommen lassen ?</p>\n<p style=\"text-align: center;\">Patrick:<br />\nDabei habe ich mich sehr zurueckgehalten!</p>\n<p style=\"text-align: center;\">Fab:<br />\nRetro ist halt immer lang aber niemals langweilig!</p>\n<p style=\"text-align: center;\">Hendrik:<br />\nWas zu beweisen waere!</p>\n<p style=\"text-align: center;\">Juergen:<br />\nMehr dazu spaeter!</p>\n<div></div>\n</div>\n<div>\n<div id=\"magicdomid6\">\n<div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<hr />\n<div id=\"magicdomid651\">\n<h2 style=\"text-align: center;\"><strong>Ihr wollt beim Retrokompott mitmachen?</strong></h2>\n</div>\n<h3 style=\"text-align: center;\">Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a>,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzecichnung<br />\ndes naechsten Themas als erstes!</h3>\n<div style=\"text-align: center;\">Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</div>\n<div style=\"text-align: center;\"></div>\n</div>\n<div style=\"text-align: center;\">\n<div>\n<div>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></div>\n<div>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.</div>\n</div>\n<div>Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</div>\n<div></div>\n</div>\n</div>\n<div id=\"magicdomid10\" style=\"text-align: center;\">\n<div>\n<div>Alle aktuellen Projekte finde man auch unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a></div>\n</div>\n</div>\n</div>\n<div style=\"text-align: center;\">unseren neuen Kanal findet ihr hier:</div>\n<div style=\"text-align: center;\">RETROKOMPOTT CLASSIC &#8211; Das Thema<br />\n<a href=\"http://www.medienpublikation.de/Kompottpods/classic_thema/feed.xml\">RSS &#8211; FEED</a></div>\n<div id=\"magicdomid96\" style=\"text-align: center;\">\n<div id=\"magicdomid10\">\n<div></div>\n<div>\n<div>&#8230;</div>\n<div>\n<p>Werbung in eigener Sache:</p>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken<br />\n</a>&#8230;</p>\n</div>\n<div></div>\n</div>\n</div>\n<hr />\n<div></div>\n<div id=\"magicdomid92\">Die Links und weiterfuehrenden Infos zum Podcast:</div>\n<div></div>\n</div>\n</div>\n<div style=\"text-align: center;\">Die Musik fuer diese Folge wurde uns freundlicherweise von Phillip Gross zur Verfuegung gestellt:</div>\n</div>\n<div style=\"text-align: center;\"></div>\n<div style=\"text-align: center;\"><a href=\"http://freemusicarchive.org/music/Phillip_Gross/Katzenmusik/\">http://freemusicarchive.org/music/Phillip_Gross/Katzenmusik/</a><br />\n<a href=\"https://creativecommons.org/licenses/by-nc-nd/4.0/\">https://creativecommons.org/licenses/by-nc-nd/4.0/</a></div>\n</div>\n</div>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<div style=\"text-align: center;\">\n<p>Die Links:</p>\n</div>\n<h4 class=\"text-center\"> <a href=\"https://galencia.itch.io/galencia\">A GALAGA INSPIRED SHOOT &#8218;EM UP FOR PAL COMMODORE 64 COMPUTERS</a></h4>\n<p>&nbsp;</p>\n<div style=\"text-align: center;\">\n<p><i>  </i><a href=\"https://www.kickstarter.com/projects/1696861912/empire-deluxe-combined-edition\">Empire Deluxe remake bei Kickstarter</a></p>\n<p><i> </i><i></i><i>   </i></p>\n<p><a href=\"http://www.n-tv.de/technik/Firefox-trudelt-in-die-Bedeutungslosigkeit-article19952994.html\">Firefox trudelt in die Bedeutungslosigkeit</a></p>\n<p>&nbsp;</p>\n<p><a href=\"http://www.spiegel.de/netzwelt/apps/microsoft-paint-microsoft-stellt-nach-32-jahre-weiterentwicklung-ein-a-1159452.html\">Microsoft Paint &#8211; microsoft stellt nach 32 jahren weiterentwicklung ein</a></p>\n<p>&nbsp;</p>\n<p><a href=\"http://www.pcgameshardware.de/Football-Manager-2019-Spiel-61190/News/kommt-samt-DFL-Lizenz-nach-Deutschland-1234072/\">Brexit: SEGA Football Manager kommt samt DFL-Lizenz nach Deutschland</a></p>\n<p><i><br />\n</i><a href=\"http://lotek64.com/hp/index.php\">Lotek &#8211; Ausgabe 55</a></p>\n<p>&nbsp;</p>\n<p><a href=\"http://gamingnerd.net/retro-ecke/von-huellen-und-schachteln-wie-der-verpackungs-rueckgang-die-gameswelt-veraendert-5519981/\">von Huellen und Schachteln</a></p>\n<p>&nbsp;</p>\n<p><a href=\"http://www.pcgames.de/Sega-Firma-18682/News/Sega-Genesis-und-Atari-2600-Preise-der-neuaufgelegten-Konsolen-bekannt-1233643/\">Sega Genesis &amp; Atari 2600: Preise der neu aufgelegten Konsolen bekannt</a></p>\n<p>&nbsp;</p>\n<p><a href=\"http://www.t3.com/features/made-in-japan-the-truth-about-the-retro-gaming-and-technology-market-in-japan\">Made in Japan: the TRUTH about the retro gaming and technology market in Japan</a></p>\n<p>&nbsp;</p>\n<p>&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;&#8211;</p>\n</div>\n<div id=\"magicdomid510\">\n<div style=\"text-align: center;\">\n<p>Naechste Sendung:</p>\n</div>\n<div style=\"text-align: center;\">\n<p>LIVE:  18.08.2017 22:00 Uhr</p>\n<p>LIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a><br />\n(Thema als Aufzeichnung vorausichtlich ab 20:00 Uhr)</p>\n<p>Thema: Zankstelle Crossover Part 2</p>\n</div>\n<p style=\"text-align: center;\"><strong>Ihr wollt die Originalspiele aus der Zeit besitzen ?</strong></p>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></p>\n<p style=\"text-align: center;\">weitere Infos in der Textdatei.<br />\nDiese wird regelmaessig aktualisiert,<br />\nes kommen auch noch C64, Amiga &amp; Konsolenspiele dazu.</p>