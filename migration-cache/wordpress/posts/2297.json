,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 067 - Sega Mega Drive PART 2\",\"subtitle\":null,\"summary\":null,\"duration\":\"6:52:37\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:01:45\",\"title\":\"Vierzeiler\"},{\"start\":\"00:02:05\",\"title\":\"Titelmusik\"},{\"start\":\"00:03:22\",\"title\":\"Heute sind mit dabei   \"},{\"start\":\"00:03:33\",\"title\":\"Retro Warm Up - auf in eine neue Runde    \"},{\"start\":\"00:46:02\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"00:55:35\",\"title\":\"Retro Facts: Sega Mega Drive PART 2\"},{\"start\":\"02:21:23\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"02:22:13\",\"title\":\"Retro Play - das Resume Foxx fights back C64\"},{\"start\":\"02:27:57\",\"title\":\"Retro Play - Was sollen wir spielen? Slicks (Codemasters) C64\"},{\"start\":\"02:29:22\",\"title\":\"Retro Talk - PoP Thunderhawk\"},{\"start\":\"03:22:27\",\"title\":\"Retro Talk - Commodore Meeting 2018 Wien (Andreas)\"},{\"start\":\"03:38:07\",\"title\":\"Retro Talk - Outlaws (Juergen)\"},{\"start\":\"03:46:34\",\"title\":\"Retro Talk - Interview Michael Lang\"},{\"start\":\"04:46:03\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"04:47:21\",\"title\":\"Retro Mysteries SoundQuiz \"},{\"start\":\"05:07:00\",\"title\":\"Retro Mysteries Teamquiz\"},{\"start\":\"06:00:14\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"06:45:44\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"06:52:37\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2018-06-09_retrokompott_-_067_-_sega_mega_drive_part2.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        </p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">HELFT UNS DIE REGELMESSIGE AUSSTRAHLUNG UND ZUKUNFT DES PODCASTS ZU SICHERN UND UNTERSTUETZT UNS<br />\nAUF <a href=\"http://www.patreon.com/retrokompott\">PATREON</a> ODER <a href=\"http://paypal.me/retrokompott\">PAYPAL</a></p>\n<p style=\"text-align: center;\">weitere Infos in diesem <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-06-10_retrokompott_patreon_special_001.mp3?\">PATREON Special Podcast</a></p>\n<p style=\"text-align: center;\">\n<hr />\n<hr />\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<p>Patrick:<br />\nOk, sind schon alle da?</p>\n<p>Fabskimo:<br />\nWird spaeter. Bei mir demonstrieren die Flughafenliebhaber.</p>\n<p>Derk:<br />\nSteh vor einer Demonstration der Alkoholfreibiertrinker.</p>\n<p>Oliver:<br />\nBei mir sind es die Anonymen Grafiker fuer Pixel (AGP). Dauert noch.</p>\n<p>Andreas:<br />\nIch komm spaeter, die Jodlmeister demonstrieren hier.</p>\n<p>Robin:<br />\nNa Gott sei dank passiert sowas bei uns in Hamburg nicht.</p>\n<hr />\n<hr />\n<p><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-06-09_retrokompott_-_067_-_sega_mega_drive_part2.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 67</a></p>\n<p><a href=\"https://www.patreon.com/posts/die-nachlese-zur-19338670\">N67</a> 08.06.2018 0h40min   Nachlese Folge 67   <a href=\"https://www.patreon.com/posts/die-nachlese-zur-19338670\">fuer Patreonen</a></p>\n</div>\n<p style=\"text-align: center;\">mit Patrick, Robin, Fabskimo, Andreas, Oliver, &amp; Derk</p>\n<p style=\"text-align: center;\">und als Themenexperten Oliver, Andreas &amp; Robin</p>\n<p style=\"text-align: center;\">(Aufnahmedatum des Themas: 22.03.2018)</p>\n<p style=\"text-align: center;\">Dauer: 6h52</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Die naechsten LIVE Termine auf <a href=\"http://www.mixlr.com/retrokompott\">www.mixlr.com/retrokompott:</a></p>\n<p style=\"text-align: center;\">22.06.2018 22:00 Aufzeichnung Rahmenprogramm SEGA MEGA DRIVE PART 3</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Ihr wollt beim Retrokompott mitmachen?</p>\n<div style=\"text-align: center;\">\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a><br />\noder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzeichnung<br />\ndes naechsten Themas als erstes!</p>\n<p>ab 3$ im Monat<br />\n&#8222;Robins Retro Woche&#8220; (<a href=\"https://www.patreon.com/posts/robins-retro-vom-18943794\">aktuelle Folge 10</a>)<br />\n&#8222;Patrick am Pranger&#8220; (<a href=\"https://www.patreon.com/posts/patrick-am-folge-19034857\">aktuelle Folge 6</a>)</p>\n<hr />\n<hr />\n<p>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</p>\n<p>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></p>\n</div>\n<div>\n<div>\n<p>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</p>\n<p>&nbsp;</p>\n<div>\n<hr />\n</div>\n</div>\n<hr />\n<p>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</p>\n</div>\n</div>\n</div>\n<p>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</p>\n<div>\n<hr />\n<hr />\n<p>Werbung in eigener Sache:</p>\n</div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken</a></p>\n<p>&nbsp;</p>\n</div>\n</div>\n<hr />\n<hr />\n<p>Die Links und weiterfuehrenden Infos zum Podcast:</p>\n</div>\n</div>\n<p style=\"text-align: center;\">Die Musik fuer diese Folge stammt von Bug of NCI<br />\nausser es wurde anders erwaehnt. Saemtliche Musik ist gemafrei.</p>\n<p style=\"text-align: center;\">\n<p style=\"text-align: center;\">Ataribox</p>\n<p style=\"text-align: center;\"><a href=\"https://www.indiegogo.com/projects/atari-vcs-game-stream-connect-like-never-before-computers-pc#/\">https://www.indiegogo.com/projects/atari-vcs-game-stream-connect-like-never-before-computers-pc#/</a></p>\n<p style=\"text-align: center;\">spectrum vega game over</p>\n<p style=\"text-align: center;\"><a href=\"https://www.bbc.com/news/technology-44381247\">https://www.bbc.com/news/technology-44381247</a></p>\n<p style=\"text-align: center;\">ZX Vega+ console faces Indiegogo&#8217;s debt collectors</p>\n<p style=\"text-align: center;\"><a href=\"https://www.bbc.com/news/technology-44319346\">https://www.bbc.com/news/technology-44319346</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.bild.de/spiele/spiele-news/adventure/leisure-suit-larry-kommt-wieder-55793406.bild.html\">https://www.bild.de/spiele/spiele-news/adventure/leisure-suit-larry-kommt-wieder-55793406.bild.html</a></p>\n<p style=\"text-align: center;\"><a href=\"https://store.steampowered.com/app/290930/HalfLife_2_Update/\">Half-Life 2: Update on Steam</a></p>\n<p style=\"text-align: center;\">\n<p style=\"text-align: center;\"><a href=\"https://www.welt.de/wirtschaft/webwelt/article176668717/Amiga-Historie-Als-Commodores-Brotkaesten-die-Welt-eroberten.html\">https://www.welt.de/wirtschaft/webwelt/article176668717/Amiga-Historie-Als-Commodores-Brotkaesten-die-Welt-eroberten.html</a></p>\n<p style=\"text-align: center;\"><a href=\"https://thenextweb.com/gaming/2018/05/15/monkey-island-fans-are-begging-disney-to-sell-the-rights-back-to-its-creator/\">https://thenextweb.com/gaming/2018/05/15/monkey-island-fans-are-begging-disney-to-sell-the-rights-back-to-its-creator/</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.indieretronews.com/2018/05/eye-of-beholder-dungeon-crawling.html\">http://www.indieretronews.com/2018/05/eye-of-beholder-dungeon-crawling.html</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.heldenderfreizeit.com/sega-mega-drive-classics-spiele/\">https://www.heldenderfreizeit.com/sega-mega-drive-classics-spiele/</a></p>\n<p style=\"text-align: center;\"><a href=\"https://tassilo.itch.io/pixelme\">https://tassilo.itch.io/pixelme</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.kickstarter.com/projects/1973096722/planet-x3-for-ms-dos\">https://www.kickstarter.com/projects/1973096722/planet-x3-for-ms-dos</a></p>\n<p style=\"text-align: center;\"><a href=\"https://csdb.dk/release/?id=165137\">https://csdb.dk/release/?id=165137</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.pcgameshardware.de/Intellivision-Corporation-Firma-240184/News/Neue-Konsole-in-Entwicklung-1257455/\">http://www.pcgameshardware.de/Intellivision-Corporation-Firma-240184/News/Neue-Konsole-in-Entwicklung-1257455/</a></p>\n<div style=\"text-align: center;\">\n<hr />\n</div>\n<div id=\"magicdomid510\">\n<hr />\n<p style=\"text-align: center;\">Naechste Rahmenprogrammaufzeichnung:</p>\n<p style=\"text-align: center;\">LIVE: 22.06.2018<br />\nLIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a></p>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></p>\n<p style=\"text-align: center;\">weitere Infos in der Textdatei.<br />\nDiese wird regelmaessig aktualisiert,<br />\nes kommen auch noch C64 &amp; Konsolenspiele dazu.</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">\n</div>\n",
