,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 075 - Radio PARALAX Part I\",\"subtitle\":null,\"summary\":null,\"duration\":\"05:51:01\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:01:20\",\"title\":\"Vierzeiler\"},{\"start\":\"00:01:35\",\"title\":\"Titelmusik\"},{\"start\":\"00:02:53\",\"title\":\"Heute sind mit dabei   \"},{\"start\":\"00:03:05\",\"title\":\"Retro Warm Up - auf in eine neue Runde  \"},{\"start\":\"00:22:37\",\"title\":\"Retro Facts: Cross Over Radio PARALAX Part I\"},{\"start\":\"02:06:15\",\"title\":\"Pausenmusik - Bug of NCI\"},{\"start\":\"02:07:06\",\"title\":\"Retro Mysteries - Armin Hierstetter vom Retroplace\"},{\"start\":\"02:45:54\",\"title\":\"Retro Talk - Interview Matthew Cannon\"},{\"start\":\"03:41:55\",\"title\":\"Pausenmusik - Bug of NCI\"},{\"start\":\"03:43:05\",\"title\":\"Retro Play - das Resume Shadow of the Beast C64\"},{\"start\":\"03:54:30\",\"title\":\"Retro Play - Was sollen wir spielen? Yoomp Atari XL\"},{\"start\":\"03:57:15\",\"title\":\"Retro Talk - Wolfgang auf er Doreco\"},{\"start\":\"04:03:33\",\"title\":\"Retro Talk - RSN8887 ueber Colorado, Starblade und Metal Mutant\"},{\"start\":\"04:18:32\",\"title\":\"Retro Talk - Boris ueber den Oric 1\"},{\"start\":\"04:24:36\",\"title\":\"Retro Talk - Retro Stories 03 - Digitales Neuland\"},{\"start\":\"04:57:31\",\"title\":\"Pausenmusik - Chris Huelsbeck - The Cruisin&#039; Crew Theme (Jingle Version)\"},{\"start\":\"04:57:43\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"05:35:19\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"05:40:06\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"05:47:56\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2018-09-29_retrokompott_-_075_-_crossover_paralax_teil1.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        </p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">HELFT UNS DIE REGELMESSIGE AUSSTRAHLUNG UND ZUKUNFT DES PODCASTS ZU SICHERN UND UNTERSTUETZT UNS<br />\nAUF <a href=\"http://www.patreon.com/retrokompott\">PATREON</a>, <a href=\"https://steadyhq.com/de/retrokompott\">STEADY</a> ODER <a href=\"http://paypal.me/retrokompott\">PAYPAL</a> (hier gibt es <a href=\"https://blog.retrokompott.de/you-tube-videos/\">BONUS VIDEOS</a> freizuschalten)</p>\n<p style=\"text-align: center;\">weitere Infos in diesem <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-06-10_retrokompott_patreon_special_001.mp3?\">PATREON Special Podcast</a></p>\n<p style=\"text-align: center;\">Merchandise Artikel gibt es ab jetzt auch im Shop:<br />\n<a href=\"https://shop.spreadshirt.de/retrokompott\">RETROKOMPOTT MERCHANDISE</a></p>\n<hr />\n<hr />\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<p><a href=\"https://blog.retrokompott.de/wp-content/uploads/2018/09/folgenbild_75_.jpg\"><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-2631\" src=\"https://blog.retrokompott.de/wp-content/uploads/2018/09/folgenbild_75_.jpg\" alt=\"\" width=\"1440\" height=\"1440\" srcset=\"https://blog.retrokompott.de/wp-content/uploads/2018/09/folgenbild_75_.jpg 1440w, https://blog.retrokompott.de/wp-content/uploads/2018/09/folgenbild_75_-150x150.jpg 150w, https://blog.retrokompott.de/wp-content/uploads/2018/09/folgenbild_75_-300x300.jpg 300w, https://blog.retrokompott.de/wp-content/uploads/2018/09/folgenbild_75_-768x768.jpg 768w, https://blog.retrokompott.de/wp-content/uploads/2018/09/folgenbild_75_-1024x1024.jpg 1024w, https://blog.retrokompott.de/wp-content/uploads/2018/09/folgenbild_75_-144x144.jpg 144w\" sizes=\"auto, (max-width: 1440px) 100vw, 1440px\" /></a></p>\n</div>\n<p style=\"text-align: center;\">Patrick:</p>\n<p style=\"text-align: center;\">Herzlich Willkommen beim Retrokompott Classic Mini</p>\n<p style=\"text-align: center;\">Robin:</p>\n<p style=\"text-align: center;\">Was soll das jetzt?</p>\n<p style=\"text-align: center;\">Fabskimo:</p>\n<p style=\"text-align: center;\">Alle machen doch jetzt was mit MINI, also muessen wir das auch tun!</p>\n<p style=\"text-align: center;\">Andreas:</p>\n<p style=\"text-align: center;\">Minikompott, Mini Retrostories, Mini Me!</p>\n<p style=\"text-align: center;\">Oliver:</p>\n<p style=\"text-align: center;\">Genau, keine Folge darf mehr ueber eine Stunde gehen!</p>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<hr />\n<hr />\n<p><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-09-29_retrokompott_-_075_-_crossover_paralax_teil1.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 75</a></p>\n<p><a href=\"https://www.patreon.com/posts/nachlese-zur-75-21709528\">N75</a> 28.09.2018 0h27 min   Nachlese Folge 75   <a href=\"https://www.patreon.com/posts/nachlese-zur-75-21709528\">fuer Patreonen</a></p>\n</div>\n<p style=\"text-align: center;\">mit Patrick, Robin, Fabskimo, Oliver &amp; Andreas</p>\n<p style=\"text-align: center;\">und als Themenexperten<br />\nPatrick, Oliver, Manuel und noch einige andere</p>\n<p style=\"text-align: center;\">(Aufnahmedatum des Themas: 09.09.2018</p>\n<p style=\"text-align: center;\">Dauer: 5h51</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Die naechsten Termine:</p>\n<p style=\"text-align: center;\">05.10.2018 21:00 RETROKOMPOTT STAMMTISCH <a href=\"https://blog.retrokompott.de/01-stammtisch/\">(teilnehmen)</a></p>\n<p style=\"text-align: center;\">12.10.2018 22:00 Crossover Radio PARALAX Part II <a href=\"http://www.mixlr.com/retrokompott\">(live)</a></p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Ihr wollt beim Retrokompott mitmachen?</p>\n<div style=\"text-align: center;\">\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON,</a> <a href=\"https://steadyhq.com/de/retrokompott\">STEADY</a><br />\noder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL<br />\n(als Belohnung schalten wir <a href=\"https://blog.retrokompott.de/you-tube-videos/\">Videos</a> frei),<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzeichnung<br />\ndes naechsten Themas als erstes!</p>\n<p>ab 3$ im Monat<br />\n&#8222;Robins Retro Woche&#8220; (<a href=\"https://www.patreon.com/posts/robins-retro-12-20718055\">aktuelle Folge 12</a>)<br />\n&#8222;Patrick am Pranger&#8220; (<a href=\"https://www.patreon.com/posts/patrick-am-folge-20828108\">aktuelle Folge 11</a>)</p>\n<hr />\n<hr />\n<p>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</p>\n<p>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></p>\n</div>\n<div>\n<div>\n<p>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</p>\n<div>\n<hr />\n</div>\n</div>\n<hr />\n<p>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</p>\n</div>\n</div>\n</div>\n<p>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</p>\n<div>\n<hr />\n<hr />\n<p>Werbung in eigener Sache:</p>\n</div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken</a></p>\n</div>\n</div>\n<hr />\n<hr />\n</div>\n</div>\n<p style=\"text-align: center;\">Die Musiken fuer diese Folge stammen von<br />\nChris Huelsbeck &amp; Bug of NCI :</p>\n<p style=\"text-align: center;\"><b>Music titles by Chris Huelsbeck, used under a royalty-free license, please visit</b><a href=\"https://www.patreon.com/chris_huelsbeck\"> <b>www.patreon.com/chris_huelsbeck</b></a><b> for more info!</b></p>\n<p style=\"text-align: center;\">Saemtliche Musik ist gemafrei.</p>\n<hr />\n<p style=\"text-align: center;\">Die weiterfuehrenden Links:</p>\n<p style=\"text-align: center;\"> <a href=\"http://logpl.gplworld.de/index.htm\">LEGENDS of GPL &#8211; 20th Anniversary Edition</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.maniac.de/news/n64-nintendo-laesst-controller-schuetzen-kommt-ein-mini/\">https://www.maniac.de/news/n64-nintendo-laesst-controller-schuetzen-kommt-ein-mini/</a></p>\n<p style=\"text-align: center;\"><a href=\"http://idoregesz.hu/product/multimedia-breakout-commodore-c64/\">http://idoregesz.hu/product/multimedia-breakout-commodore-c64/</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.playstation.com/de-de/explore/playstation-classic/\">https://www.playstation.com/de-de/explore/playstation-classic/</a></p>\n<p style=\"text-align: center;\"><a href=\"https://atariage.com/store/index.php?l=product_detail&amp;p=1146\">https://atariage.com/store/index.php?l=product_detail&amp;p=1146</a></p>\n<p style=\"text-align: center;\"><a href=\"http://ultimateconsoledatabase.com/\">http://ultimateconsoledatabase.com/</a></p>\n<hr />\n<div id=\"magicdomid510\">\n<p style=\"text-align: center;\">Naechste Rahmenprogrammaufzeichnung:</p>\n<p style=\"text-align: center;\">LIVE: 12.09.2018<br />\nLIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a></p>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></p>\n<p style=\"text-align: center;\">weitere Infos in der Textdatei.<br />\nDiese wird regelmaessig aktualisiert,<br />\nes kommen auch noch C64 &amp; Konsolenspiele dazu.</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">\n</div>\n",
