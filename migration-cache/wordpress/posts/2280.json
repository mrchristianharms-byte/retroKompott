n    <tab name=\"transcripts\">\n      <tab-transcripts></tab-transcripts>\n    </tab>\n    <tab name=\"files\">\n      <tab-files></tab-files>\n    </tab>\n    <tab name=\"playlist\">\n      <tab-playlist></tab-playlist>\n    </tab>\n    <tab name=\"share\">\n      <tab-share></tab-share>\n    </tab>\n    <tab-overflow></tab-overflow>\n  </div>\n  <error></error>\n</root>\n</div>\n            <script>\n              document.addEventListener(\"DOMContentLoaded\", function() {\n                var player = document.getElementById(\"player-6aee478fc57e0\");\n                podlovePlayerCache.add([null, {\"url\":\"https:\\/\\/blog.retrokompott.de\\/wp-json\\/podlove-web-player\\/shortcode\\/config\\/retrokompott\\/theme\\/retrokompott\",\"data\":{\"activeTab\":\"chapters\",\"subscribe-button\":null,\"share\":{\"channels\":[\"facebook\",\"twitter\",\"whats-app\",\"linkedin\",\"pinterest\",\"xing\",\"mail\",\"link\"],\"outlet\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/share.html\",\"sharePlaytime\":true},\"related-episodes\":{\"source\":\"disabled\",\"value\":null},\"version\":5,\"theme\":{\"tokens\":{\"brand\":\"#15C0E6\",\"brandDark\":\"#235973\",\"brandDarkest\":\"#1A3A4A\",\"brandLightest\":\"#E9F1F5\",\"shadeDark\":\"#807E7C\",\"shadeBase\":\"#807E7C\",\"contrast\":\"#000\",\"alt\":\"#fff\"},\"fonts\":{\"ci\":{\"name\":\"ci\",\"family\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":800},\"regular\":{\"name\":\"regular\",\"family\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":300},\"bold\":{\"name\":\"bold\",\"family\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 066 - \",\"subtitle\":null,\"summary\":null,\"duration\":\"5:40:07\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:01:42\",\"title\":\"Vierzeiler\"},{\"start\":\"00:02:13\",\"title\":\"Titelmusik\"},{\"start\":\"00:03:30\",\"title\":\"Heute sind mit dabei   \"},{\"start\":\"00:03:41\",\"title\":\"Retro Warm Up - auf in eine neue Runde    \"},{\"start\":\"00:43:44\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"00:54:13\",\"title\":\"Retro Facts: Sega Mega Drive PART 1\"},{\"start\":\"02:19:20\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"02:20:10\",\"title\":\"Retro Play - das Resume Crack (Linel) Amiga\"},{\"start\":\"02:25:11\",\"title\":\"Retro Play - Was sollen wir spielen? Fox Fights Back C64\"},{\"start\":\"02:26:43\",\"title\":\"Retro Talk - PoP Sam &amp; Max: Hit the Road\"},{\"start\":\"03:32:19\",\"title\":\"Retro Talk - Interview Christian Gleinser\"},{\"start\":\"04:29:09\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"04:30:19\",\"title\":\"Retro Mysteries Quiz mit Wolfgang W.\"},{\"start\":\"04:46:51\",\"title\":\"Retro Mysteries SoundQuiz \"},{\"start\":\"05:00:54\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"05:27:35\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"05:37:03\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2018-05-26_retrokompott_-_066_-_sega_mega_drive_part1.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        </p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">HELFT UNS DIE REGELMESSIGE AUSSTRAHLUNG UND ZUKUNFT DES PODCASTS ZU SICHERN UND UNTERSTUETZT UNS<br />\nAUF <a href=\"http://www.patreon.com/retrokompott\">PATREON</a> ODER <a href=\"http://paypal.me/retrokompott\">PAYPAL</a></p>\n<p style=\"text-align: center;\">VIELEN DANK!</p>\n<hr />\n<hr />\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<p>Patrick:<br />\nIch bitte Euch um die Erlaubnis Euch auch heute im Podcast namentlich ansprechen zu duerfen</p>\n<p>Robin:<br />\nErteilt. Und wenn wir eine Email nennen erlauben wir auch allen Hoerern uns anzuschreiben.</p>\n<p>Oliver:<br />\nErteilt. Und wenn ich versehentlich meinen Namen nenne braucht ihr keinen Piepton darueber legen</p>\n<p>Selmar:<br />\nErteilt, mich erreicht ihr unter robin@retrokompott.de</p>\n<p>Fabskimo:<br />\nWas haben die denn jetzt schon wieder fuer Stoerungen?</p>\n<p>Andreas:<br />\n..das darf ich Dir aus Datenschutzgruenden nicht sagen….</p>\n<p>&nbsp;</p>\n<hr />\n<hr />\n<p><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-05-26_retrokompott_-_066_-_sega_mega_drive_part1.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 66</a></p>\n<p><a href=\"https://www.patreon.com/posts/die-nachlese-zur-19034833\">N65</a> 11.05.2018 0h43min   Nachlese Folge 66   <a href=\"https://www.patreon.com/posts/die-nachlese-zur-19034833\">fuer Patreonen</a></p>\n</div>\n<p style=\"text-align: center;\">mit Patrick, Robin, Fabskimo, Andreas, Oliver, &amp; Selmar</p>\n<p style=\"text-align: center;\">und als Themenexperten Oliver, Andreas &amp; Robin</p>\n<p style=\"text-align: center;\">(Aufnahmedatum des Themas: 22.03.2018)</p>\n<p style=\"text-align: center;\">Dauer: 5h40</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Die naechsten LIVE Termine auf <a href=\"http://www.mixlr.com/retrokompott\">www.mixlr.com/retrokompott:</a><br />\n30.05.2018  22:00 Uhr <a href=\"http://www.mixlr.com/retrokompott\">LIVE</a> Voraufzeichnung QUIZ<br />\n08.06.2018 22:00 Aufzeichnung Rahmenprogramm SEGA MEGA DRIVE PART 2</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">Ihr wollt beim Retrokompott mitmachen?</p>\n<div style=\"text-align: center;\">\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a><br />\noder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzeichnung<br />\ndes naechsten Themas als erstes!</p>\n<p>ab 3$ im Monat<br />\n&#8222;Robins Retro Woche&#8220; (<a href=\"https://www.patreon.com/posts/robins-retro-vom-18943794\">aktuelle Folge 9</a>)<br />\n&#8222;Patrick am Pranger&#8220; (<a href=\"https://www.patreon.com/posts/patrick-am-folge-19034857\">aktuelle Folge 6</a>)</p>\n<hr />\n<hr />\n<p>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</p>\n<p>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></p>\n</div>\n<div>\n<div>\n<p>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</p>\n<p>&nbsp;</p>\n<div>\n<hr />\n</div>\n</div>\n<hr />\n<p>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</p>\n</div>\n</div>\n</div>\n<p>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</p>\n<div>\n<hr />\n<hr />\n<p>Werbung in eigener Sache:</p>\n</div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken</a></p>\n<p>&nbsp;</p>\n</div>\n</div>\n<hr />\n<hr />\n<p>Die Links und weiterfuehrenden Infos zum Podcast:</p>\n</div>\n</div>\n<p style=\"text-align: center;\">Die Musik fuer diese Folge stammt von Bug of NCI<br />\nausser es wurde anders erwaehnt. Saemtliche Musik ist gemafrei.</p>\n<p style=\"text-align: center;\"><a href=\"https://www.gamepro.de/artikel/n64-classic-mini-nintendo-beantragt-neuen-markenschutz-fuer-den-n64,3329976.html\">https://www.gamepro.de/artikel/n64-classic-mini-nintendo-beantragt-neuen-markenschutz-fuer-den-n64,3329976.html</a></p>\n<p>&nbsp;</p>\n<p style=\"text-align: center;\">Oliver Lindau hat c64mini games wertungen zusammengestellt</p>\n<p style=\"text-align: center;\"><a href=\"https://docs.google.com/spreadsheets/d/18XYfGJxan8o8ePiQHGkPqGa6N3OxrCl-MMCqda3D0fk/edit#gid=0\">https://docs.google.com/spreadsheets/d/18XYfGJxan8o8ePiQHGkPqGa6N3OxrCl-MMCqda3D0fk/edit#gid=0</a></p>\n<p>&nbsp;</p>\n<p style=\"text-align: center;\">Pac man Jahrestag</p>\n<p style=\"text-align: center;\"><a href=\"http://winfuture.de/news,103301.html\">http://winfuture.de/news,103301.html</a></p>\n<p>&nbsp;</p>\n<p style=\"text-align: center;\"><a href=\"http://www.nintendolife.com/news/2017/12/retro-bit_announces_r-type_returns_for_super_nintendo\">endolife.com/news/2017/12/retro-bit_announces_r-type_returns_for_super_nintendo</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.computerbild.de/artikel/cbs-News-PC-Amiga-Die-Gaming-Revolution-21635339.html\">http://www.computerbild.de/artikel/cbs-News-PC-Amiga-Die-Gaming-Revolution-21635339.html</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.kickstarter.com/projects/orionsoft/retro-game-designer?lang=de\">https://www.kickstarter.com/projects/orionsoft/retro-game-designer?lang=de</a></p>\n<p style=\"text-align: center;\"><a href=\"https://homecomputermuseum.de/doku/man_de.htm\">Basic-Anleitungen Commodore Atari Amstrad Sinclair</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.kickstarter.com/projects/wildpower/streets-of-steel-the-sidescrollin-beatem-up-boardg?lang=de\">https://www.kickstarter.com/projects/wildpower/streets-of-steel-the-sidescrollin-beatem-up-boardg?lang=de</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.gamestar.de/artikel/bundesfighter-2-turbo-staatsanwaltschaft-ermittelt-nicht-wegen-hakenkreuz-im-spiel-aendert-sich-die-rechtslage,3329420.html\">https://www.gamestar.de/artikel/bundesfighter-2-turbo-staatsanwaltschaft-ermittelt-nicht-wegen-hakenkreuz-im-spiel-aendert-sich-die-rechtslage,3329420.html</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.pcgames.de/Nintendo-Firma-15624/News/nes-dokumentarfilm-jubilaeum-original-spiele-release-1213327/\">http://www.pcgames.de/Nintendo-Firma-15624/News/nes-dokumentarfilm-jubilaeum-original-spiele-release-1213327/</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.kultpower.de/phpbb/viewtopic.php?f=16&amp;t=33268&amp;sid=6b2407be7fc6fa362b536e77c6bf53bc\">https://www.kultpower.de/phpbb/viewtopic.php?f=16&amp;t=33268&amp;sid=6b2407be7fc6fa362b536e77c6bf53bc</a></p>\n<div style=\"text-align: center;\">\n<hr />\n</div>\n<div id=\"magicdomid510\">\n<hr />\n<p style=\"text-align: center;\">Naechste Rahmenprogrammaufzeichnung:</p>\n<p style=\"text-align: center;\">LIVE: 08.06.2018<br />\nLIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a></p>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></p>\n<p style=\"text-align: center;\">weitere Infos in der Textdatei.<br />\nDiese wird regelmaessig aktualisiert,<br />\nes kommen auch noch C64 &amp; Konsolenspiele dazu.</p>\n<hr />\n<hr />\n<p style=\"text-align: center;\">\n</div>\n",
