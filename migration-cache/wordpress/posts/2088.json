,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 060 - Dreamcast Part I\",\"subtitle\":null,\"summary\":null,\"duration\":\"6:02:48\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:01:04\",\"title\":\"Vierzeiler\"},{\"start\":\"00:01:16\",\"title\":\"Titelmusik\"},{\"start\":\"00:02:33\",\"title\":\"Heute sind mit dabei   \"},{\"start\":\"00:02:43\",\"title\":\"Retro Warm Up - auf in eine neue Runde    \"},{\"start\":\"00:51:47\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"00:55:54\",\"title\":\"Einspieler Andreas\"},{\"start\":\"01:13:44\",\"title\":\"Einspieler Andreas Archimides\"},{\"start\":\"01:14:34\",\"title\":\"Retro Facts: Dreamcast Part I\"},{\"start\":\"02:31:08\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"02:32:18\",\"title\":\"Retro Play - das Resume Adventures of Quik &amp; Silva AMIGA\"},{\"start\":\"02:41:47\",\"title\":\"Retro Play - Was sollen wir spielen? Quick Command C64\"},{\"start\":\"02:42:59\",\"title\":\"Retro Talk - Fab auf der BCC\"},{\"start\":\"03:20:46\",\"title\":\"Retro Talk - Aces over Europe (PoP)\"},{\"start\":\"04:04:18\",\"title\":\"Retro Talk - das Interview Georg Rottensteiner\"},{\"start\":\"04:49:35\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"04:50:43\",\"title\":\"Retro Mysteries SoundQuiz \"},{\"start\":\"05:18:02\",\"title\":\"Retro Mysteries Quiz mit Alex\"},{\"start\":\"05:37:07\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"05:52:01\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"05:59:43\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2018-03-03_retrokompott_-_060_-_dreamcast_part1.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        <br />\n<a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-03-03_retrokompott_-_060_-_dreamcast_part1.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 60</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.patreon.com/posts/nachlese-folge-17329777\">N60</a> 03.03.2018 0h30min   Nachlese Folge 59   <a href=\"https://www.patreon.com/posts/nachlese-folge-17329777\">fuer Patreonen</a></p>\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<p>Aufnahmedatum: 01.02.2018<br />\nmit <b>Robin, Patrick &amp; Fabskimo<br />\n</b></p>\n<p><b>und als Themenexperten<br />\n</b></p>\n<p>Marius, Selmar, Robin</p>\n<p>Dauer: 6h03</p>\n<hr />\n<div id=\"magicdomid8\">\n<div>\n<p>Die naechsten LIVE Termine</p>\n<p>04.03.2018  20:00 Uhr LIVE Thema Wertungsroulette<br />\n15.03.2018  20:00 Uhr LIVE Thema SATURN<br />\n16.03.2018  22:00 Uhr LIVE Rahmen Folge 61 (Dreamcast Part II)<br />\n22.03.2018  20:00 Uhr LIVE Thema Mega Drive / Mega CD / 32x</p>\n<p>Bei den Themen kann es zu kurfristigen Aenderungen kommen.</p>\n<hr />\n</div>\n</div>\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<p>Patrick:<br />\nIn Berlin gab es eine c64 Party ?</p>\n<p>Robin:<br />\nDa waere ich eh nicht hingegangen, ich steh nur auf MS DOS PCs</p>\n<p>Fabskimo:<br />\nDa habt ihr aber einiges verpasst</p>\n<p>Patrick:<br />\nNicht wenn DU dieses mal deine Aufnahmetechnik im Griff hattest 🙂</p>\n<hr />\n<p><strong>Ihr wollt beim Retrokompott mitmachen?</strong></p>\n<div>\n<div id=\"magicdomid6\">\n<div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<h3>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a><br />\noder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzeichnung<br />\ndes naechsten Themas als erstes!</h3>\n<div>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</div>\n<div>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></div>\n</div>\n<div>\n<div>\n<div>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</div>\n<div></div>\n</div>\n<div>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</div>\n</div>\n</div>\n</div>\n<div>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</div>\n<div></div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<div>&#8230;</div>\n<div>&#8212;</div>\n<div>Das Rahmenprogramm zeichnen wir jeden zweiten Freitag<br />\nLIVE auf: <a href=\"http://www.mixlr.com/retrokompott\">www.mixlr.com/retrokompott</a></div>\n<div>(wenn wir bei Patreon.com/retrokompott unser Ziel erreichen, werden wir weiterhin versuchen 2 X im Monat zu senden)<br />\n&#8212;</div>\n<div></div>\n<div>\n<p>Werbung in eigener Sache:</p>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken<br />\n</a>&#8230;</p>\n</div>\n<div></div>\n</div>\n</div>\n<hr />\n<div></div>\n<div>\n<p>Die Links und weiterfuehrenden Infos zum Podcast:</p>\n</div>\n</div>\n</div>\n<div>\n<p>Die Musik fuer diese Folge stammt von Bug of NCI<br />\nausser es wurde anders erwaehnt. Saemtliche Musik ist gemafrei.</p>\n</div>\n<p><a href=\"https://www.germanremixgroup.de/content/releases/\">https://www.germanremixgroup.de/content/releases/</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.youtube.com/watch?v=6PjzOvcymzI\">The 8-Bit Guy &#8211; 200th Episode Special &#8211; A Day in my Life</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.c64-wiki.de/wiki/NUFLI\">https://www.c64-wiki.de/wiki/NUFLI</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.derstandard.de/story/2000073812272/trap-adventure-2-das-schwierigste-und-frustrierendste-spiel-aller-zeiten\">https://www.derstandard.de/story/2000073812272/trap-adventure-2-das-schwierigste-und-frustrierendste-spiel-aller-zeiten</a></p>\n<p>&nbsp;</p>\n<p><a href=\"http://www.8-bitcentral.com/blog/2017/retron77.html\">http://www.8-bitcentral.com/blog/2017/retron77.html</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.youtube.com/watch?v=El_qHskaRfg\">https://www.youtube.com/watch?v=El_qHskaRfg</a></p>\n<p>Pets Rescue c16</p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.youtube.com/watch?v=VPuikArOx6Y\">Tinder in the 1980s</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.derstandard.de/story/2000072781698/die-wilden-80er-als-radiosender-raubkopien-von-spielen-ausstrahlten\">https://www.derstandard.de/story/2000072781698/die-wilden-80er-als-radiosender-raubkopien-von-spielen-ausstrahlten</a></p>\n<p>&nbsp;</p>\n<p><a href=\"http://www.playretrogames.com/\">http://ww.playretrogames.com/</a></p>\n<p>&nbsp;</p>\n<p><a href=\"http://www.c64preservation.com/\">http://www.c64preservation.com/</a></p>\n<div>\n<p>&nbsp;</p>\n<p>&#8230;&#8230;&#8230;&#8230;&#8230;&#8230;..</p>\n</div>\n</div>\n</div>\n</div>\n<div id=\"magicdomid510\">\n<div style=\"text-align: center;\">\n<p>Naechste Rahmenprogrammaufzeichnung:</p>\n</div>\n<div style=\"text-align: center;\">\n<p>LIVE:  16.03.2018 22:00 Uhr<br />\nThema: Dreamcast PART 2</p>\n<p>LIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a></p>\n</div>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></p>\n<p style=\"text-align: center;\">weitere Infos in der Textdatei.<br />\nDiese wird regelmaessig aktualisiert,<br />\nes kommen auch noch C64 &amp; Konsolenspiele dazu.</p>\n</div>\n",
