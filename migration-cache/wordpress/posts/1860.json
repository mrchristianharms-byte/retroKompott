,\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 059 - Archimedes\",\"subtitle\":null,\"summary\":null,\"duration\":\"5:33:08\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:01:03\",\"title\":\"Vierzeiler\"},{\"start\":\"00:01:16\",\"title\":\"Titelmusik\"},{\"start\":\"00:02:33\",\"title\":\"Heute sind mit dabei       \"},{\"start\":\"00:02:43\",\"title\":\"Retro Warm Up - auf in eine neue Runde\"},{\"start\":\"00:30:29\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"00:47:33\",\"title\":\"Retro Facts: Archimedes\"},{\"start\":\"02:12:37\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"02:13:44\",\"title\":\"Retro Play - das Resume Verkeersrally C64\"},{\"start\":\"02:21:13\",\"title\":\"Retro Play - Was sollen wir spielen? \"},{\"start\":\"02:22:58\",\"title\":\"Retro Talk - PoP Unirally\"},{\"start\":\"03:07:52\",\"title\":\"Retro Talk - das Interview Marc Wardenga\"},{\"start\":\"04:07:42\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"04:08:47\",\"title\":\"Retro Mysteries SoundQuiz \"},{\"start\":\"04:24:17\",\"title\":\"Retro Mysteries Quiz mit Senad\"},{\"start\":\"04:56:39\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"05:21:51\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"05:30:03\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2018-02-10_retrokompott_-_059_-_archimedes.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        <br />\n<a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-02-10_retrokompott_-_059_-_archimedes.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 59</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.patreon.com/posts/nachlese-zur-59-16910798\">N59</a> 09.02.2018 0h35min   Nachlese Folge 59   <a href=\"https://www.patreon.com/posts/nachlese-zur-59-16910798\">fuer Patreonen</a></p>\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<p>Aufnahmedatum: 23.01.2018<br />\nmit <b>Robin, Patrick, Selmar &amp; Fabskimo<br />\n</b></p>\n<p><b>und als Themenexperten<br />\n</b></p>\n<p>Fabskimo, Patrick, Markus &amp; Tim</p>\n<p>Dauer: 5h33</p>\n<div id=\"magicdomid8\">\n<div>\n<hr />\n</div>\n</div>\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<p>Patrick:<br />\nWir haben immer noch keinen Vierzeiler fertig!</p>\n<p>Robin:<br />\nWas guckst du mich an. ich hab keine Ideen.</p>\n<p>Fabskimo:<br />\nIch denke mal darueber nach. mir faellt bestimmt was ein.</p>\n<p>Selmar:<br />\nEs gibt Buecher, in denen so was steht 😉</p>\n<p>Robin:<br />\nEis am Stiel &#8211; Das Malbuch ?</p>\n<hr />\n<p><strong>Ihr wollt beim Retrokompott mitmachen?</strong></p>\n<div>\n<div id=\"magicdomid6\">\n<div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<h3>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a><br />\noder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzeichnung<br />\ndes naechsten Themas als erstes!</h3>\n<div>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</div>\n<div>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></div>\n</div>\n<div>\n<div>\n<div>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</div>\n<div></div>\n</div>\n<div>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</div>\n</div>\n</div>\n</div>\n<div>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</div>\n<div></div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<div>&#8230;</div>\n<div>&#8212;</div>\n<div>Das Rahmenprogramm zeichnen wir jeden zweiten Freitag<br />\nLIVE auf: <a href=\"http://www.mixlr.com/retrokompott\">www.mixlr.com/retrokompott</a></div>\n<div>(wenn wir bei Patreon.com/retrokompott unser Ziel erreichen, werden wir weiterhin versuchen 2 X im Monat zu senden)<br />\n&#8212;</div>\n<div></div>\n<div>\n<p>Werbung in eigener Sache:</p>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken<br />\n</a>&#8230;</p>\n</div>\n<div></div>\n</div>\n</div>\n<hr />\n<div></div>\n<div>\n<p>Die Links und weiterfuehrenden Infos zum Podcast:</p>\n</div>\n</div>\n</div>\n<div>\n<p>Die Musik fuer diese Folge stammt von Bug of NCI<br />\nausser es wurde anders erwaehnt. Saemtliche Musik ist gemafrei.</p>\n<p><a href=\"http://www.amigafuture.de/viewtopic.php?t=44339\" target=\"_blank\" rel=\"noopener\">20 Jahr AMIGA Future</a></p>\n<p><a href=\"http://www.amigafuture.de/kb.php?mode=article&amp;k=1192\" target=\"_blank\" rel=\"noopener\">Die Geschichte der Amiga Future Teil 1</a></p>\n<p><a href=\"http://www.amigafuture.de/kb.php?mode=article&amp;k=3143\" target=\"_blank\" rel=\"noopener\">Die Geschichte der Amiga Future Teil 2</a></p>\n<p><a href=\"http://www.amigafuture.de/kb.php?mode=article&amp;k=4670\" target=\"_blank\" rel=\"noopener\">Die Geschichte der Amiga Future Teil 3</a></p>\n<p><a href=\"https://l.facebook.com/l.php?u=http%3A%2F%2Fwww.amigafuture.de%2Fkb.php%3Fmode%3Darticle%26k%3D1192&amp;h=ATNCDQu9hGDm9nBg6TzPz5UJ-ieD1pkBLdxvniFGMLJYct4FLpO_3NH1LILVqqeE3ouxGIkma4buFG83ZNY6uKKZ0x8VaMEs8EZCXgwaeRcLBBQju-F6cQgb93lkiQPDrScLsDTfIIjojrHuvSP4jSG3Lf9xK7aB\" target=\"_blank\" rel=\"noopener\">http://www.amigafuture.de/kb.php?mode=article&amp;k=1192</a></p>\n<p><a href=\"http://www.amigafuture.de/kb.php?mode=article&amp;k=4621\" target=\"_blank\" rel=\"noopener\">15 Jahre &#8222;Amiga Future&#8220;-Webpage</a></p>\n<p><a href=\"http://www.apc-tcp.de/index-de.php?page=history\" target=\"_blank\" rel=\"noopener\">Geschichte von APC&amp;TCP</a><a href=\"https://l.facebook.com/l.php?u=http%3A%2F%2Fwww.apc-tcp.de%2Findex-de.php%3Fpage%3Dhistory&amp;h=ATNCDQu9hGDm9nBg6TzPz5UJ-ieD1pkBLdxvniFGMLJYct4FLpO_3NH1LILVqqeE3ouxGIkma4buFG83ZNY6uKKZ0x8VaMEs8EZCXgwaeRcLBBQju-F6cQgb93lkiQPDrScLsDTfIIjojrHuvSP4jSG3Lf9xK7aB\" target=\"_blank\" rel=\"noopener\"><br />\n</a></p>\n<p><a href=\"https://derstandard.at/2000073674315/100-000-Dollar-Finderlohn-Sammler-sucht-verzweifelt-Bild-fuer-NES\" target=\"_blank\" rel=\"noopener\">100.000 Dollar Finderlohn: Sammler sucht verzweifelt Bild von NES-Game-Verpackung</a></p>\n<p><a href=\"https://www.germanremixgroup.de/content/2018/01/album-no-4-announcement-traile