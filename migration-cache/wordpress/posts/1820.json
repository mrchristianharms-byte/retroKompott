n    <tab name=\"transcripts\">\n      <tab-transcripts></tab-transcripts>\n    </tab>\n    <tab name=\"files\">\n      <tab-files></tab-files>\n    </tab>\n    <tab name=\"playlist\">\n      <tab-playlist></tab-playlist>\n    </tab>\n    <tab name=\"share\">\n      <tab-share></tab-share>\n    </tab>\n    <tab-overflow></tab-overflow>\n  </div>\n  <error></error>\n</root>\n</div>\n            <script>\n              document.addEventListener(\"DOMContentLoaded\", function() {\n                var player = document.getElementById(\"player-6aee478fcd682\");\n                podlovePlayerCache.add([null, {\"url\":\"https:\\/\\/blog.retrokompott.de\\/wp-json\\/podlove-web-player\\/shortcode\\/config\\/retrokompott\\/theme\\/retrokompott\",\"data\":{\"activeTab\":\"chapters\",\"subscribe-button\":null,\"share\":{\"channels\":[\"facebook\",\"twitter\",\"whats-app\",\"linkedin\",\"pinterest\",\"xing\",\"mail\",\"link\"],\"outlet\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/share.html\",\"sharePlaytime\":true},\"related-episodes\":{\"source\":\"disabled\",\"value\":null},\"version\":5,\"theme\":{\"tokens\":{\"brand\":\"#15C0E6\",\"brandDark\":\"#235973\",\"brandDarkest\":\"#1A3A4A\",\"brandLightest\":\"#E9F1F5\",\"shadeDark\":\"#807E7C\",\"shadeBase\":\"#807E7C\",\"contrast\":\"#000\",\"alt\":\"#fff\"},\"fonts\":{\"ci\":{\"name\":\"ci\",\"family\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":800},\"regular\":{\"name\":\"regular\",\"family\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":300},\"bold\":{\"name\":\"bold\",\"family\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 057 - ASM Jahr 1987 Part 2\",\"subtitle\":null,\"summary\":null,\"duration\":\"6:29:39\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Einleitung\"},{\"start\":\"00:00:56\",\"title\":\"Vierzeiler\"},{\"start\":\"00:01:14\",\"title\":\"Titelmusik\"},{\"start\":\"00:02:31\",\"title\":\"Heute sind mit dabei       \"},{\"start\":\"00:02:42\",\"title\":\"Retro Warm Up - auf in eine neue Runde\"},{\"start\":\"00:24:44\",\"title\":\"Retromail - eure Stimme im Retrokompott\"},{\"start\":\"00:38:34\",\"title\":\"Retro Facts: Das ASM Jahr 1987 PART 2\"},{\"start\":\"18:15\",\"title\":\"PAUSENMUSIK\"},{\"start\":\"02:19:23\",\"title\":\"Retro Play - das Resume Photo Safari C64\"},{\"start\":\"02:25:45\",\"title\":\"Retro Play - Was sollen wir spielen? Hat-Tricki C64\"},{\"start\":\"02:28:17\",\"title\":\"Retro Talk - Geschichte von Player One\"},{\"start\":\"02:40:17\",\"title\":\"Retro Talk - Sams Journey mit Oliver und Patrick\"},{\"start\":\"03:21:08\",\"title\":\"Retro Talk - das Interview Frank Ziemlinski\"},{\"start\":\"05:19:58\",\"title\":\"Verlosungsaktion Moorhuhn\"},{\"start\":\"23:10\",\"title\":\"Retro Mysteries SoundQuiz \"},{\"start\":\"05:41:41\",\"title\":\"Retro Mysteries Quiz mit Georg Rottensteiner\"},{\"start\":\"05:59:24\",\"title\":\"Retro Today - Retro Gegenwart\"},{\"start\":\"06:14:46\",\"title\":\"Retro Credits - kurz vor Schluss\"},{\"start\":\"06:27:19\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2018-01-13_retrokompott_-_057_-_asm_1987_part2.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        <br />\n<a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2018-01-13_retrokompott_-_057_-_asm_1987_part2.mp3?\" target=\"_blank\" rel=\"noopener\">Download von Folge 57</a></p>\n<p style=\"text-align: center;\"><a href=\"https://www.patreon.com/posts/nachlese-zur-57-16379351\">N57</a> 12.01.2017 0h53min   Nachlese Folge 57   <a href=\"https://www.patreon.com/posts/nachlese-zur-57-16379351\">fuer Patreonen</a></p>\n</div>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<p>Aufnahmedatum: 14.12.2017 &amp; 12.01.2018<br />\nmit <b>Robin, Patrick, Selmar<br />\n</b></p>\n<p><b>und als Themenexperten<br />\n</b></p>\n<p>Patrick, Robin, Fabskimo &amp; Wolfgang</p>\n<p>Dauer: 6h29</p>\n<div id=\"magicdomid8\">\n<div>\n<hr />\n</div>\n</div>\n</div>\n<p style=\"text-align: center;\">Fabskimo:<br />\nna, wie war euer Weihnachten und der Jahreswechsel?</p>\n<p style=\"text-align: center;\">Robin:<br />\nich hab mir da noch einen Rechner zugelegt..</p>\n<p style=\"text-align: center;\">Patrick :<br />\nalso bei mir gabs etwas Urlaub, jetzt wieder viel zu viel Arbeit, und natuerlich SAM</p>\n<p style=\"text-align: center;\">Selmar:<br />\nich bin die Sache strategisch angegangen und es lief alles nach Plan</p>\n<div id=\"magicdomid99\" style=\"text-align: center;\">\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<hr />\n<p><strong>Ihr wollt beim Retrokompott mitmachen?</strong></p>\n<div>\n<div id=\"magicdomid6\">\n<div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<h3>Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON</a><br />\noder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL,<br />\ndamit sichert ihr die Zukunft dieses Podcasts<br />\nund erhaltet viele spezielle Tracks, Videos und Infos<br />\nwie zum Beipsiel die Voraufzeichnung<br />\ndes naechsten Themas als erstes!</h3>\n<div>Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</div>\n<div>Per Mail erreicht man uns unter<br />\n<a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></div>\n</div>\n<div>\n<div>\n<div>Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>,<br />\noder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>.Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</div>\n<div></div>\n</div>\n<div>Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de</a>:</div>\n</div>\n</div>\n</div>\n<div>RETROKOMPOTT<br />\nRETROKOMPOTT CLASSIC &#8211; Das Thema (komplett und kompakt)<br />\nCACHEKOMPOTT &#8211; der Geocaching Podcast aus Hamburg<br />\nPODCASTKOMPOTT TESTKANAL (Nullnummern, Ideen &amp; Experimente)</div>\n<div></div>\n<div id=\"magicdomid96\">\n<div id=\"magicdomid10\">\n<div>\n<div>&#8230;</div>\n<div>&#8212;</div>\n<div>Das Rahmenprogramm zeichnen wir jeden zweiten Freitag<br />\nLIVE auf: <a href=\"http://www.mixlr.com/retrokompott\">www.mixlr.com/retrokompott</a></div>\n<div>&#8212;</div>\n<div>\n<p>Werbung in eigener Sache:</p>\n<p>Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR<br />\n</a>aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken<br />\n</a>&#8230;</p>\n</div>\n<div></div>\n</div>\n</div>\n<hr />\n<div></div>\n<div>\n<p>Die Links und weiterfuehrenden Infos zum Podcast:</p>\n</div>\n</div>\n</div>\n<div>\n<p>Die Musik fuer diese Folge stammt von Bug of NCI<br />\nausser es wurde anders erwaehnt. Saemtliche Musik ist gemafrei.</p>\n<p>&nbsp;</p>\n</div>\n<p><a href=\"http://www.retromagazine.eu/retro/2018-01/video-warum-retro-spiele-mist-sind/\">http://www.retromagazine.eu/retro/2018-01/video-warum-retro-spiele-mist-sind/</a></p>\n<p>&nbsp;</p>\n<p><a href=\"https://www.kickstarter.com/projects/954662076/gameshell-redefine-retro-game-console\">GameShell, Open Source Retro Gaming &amp; STEM Portable Console</a></p>\n<p><a href=\"https://www.youtube.com/watch?v=5s4tv-60Hd8\">https://www.youtube.com/watch?v=5s4tv-60Hd8<b><br />\n</b></a><b></b></p>\n<p>&nbsp;</p>\n<p><a href=\"https://gizmodo.com/game-boy-is-coming-back-thanks-to-hyperkin-1821898716\">https://gizmodo.com/game-boy-is-coming-back-thanks-to-hyperkin-1821898716</a></p>\n<p><a href=\"https://www.youtube.com/watch?v=QEZEVy6aIww\">https://www.youtube.com/watch?v=QEZEVy6aIww</a></p>\n<p>&#8230;&#8230;&#8230;&#8230;&#8230;&#8230;..</p>\n</div>\n</div>\n</div>\n<div id=\"magicdomid510\">\n<div style=\"text-align: center;\">\n<p>Naechste Rahmenprogrammaufzeichnung:</p>\n</div>\n<div style=\"text-align: center;\">\n<p>LIVE:  26.01.2018 22:00 Uhr</p>\n<p>LIVE auf <a href=\"http://mixlr.com/retrokompott\">mixlr.com/retrokompott</a></p>\n<p>Thema: 1987 Part 3</p>\n</div>\n<p style=\"text-align: center;\">unser Kooperationspartner:</p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/verkauf.php\">http://www.medienpublikation.de/verkauf.php</a></p>\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/vkakt.txt\">http://www.medienpublikation.de/vkakt.txt</a></p>\n<p style=\"text-align: center;\">weitere Infos in der Textdatei.<br />\nDiese wird regelmaessig aktualisiert,<br />\nes kommen auch noch C64 &amp; Konsolenspiele dazu.</p>\n</div>\n",
