ily\":[\"-apple-system\",\"BlinkMacSystemFont\",\"Segoe UI\",\"Roboto\",\"Helvetica\",\"Arial\",\"sans-serif\",\"Apple Color Emoji\",\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\"],\"src\":[],\"weight\":700}}},\"base\":\"https:\\/\\/blog.retrokompott.de\\/wp-content\\/plugins\\/podlove-web-player\\/web-player\\/\"}}]);\n                podlovePlayer(player, {\"title\":\"Folge 114 - MSX Part II\",\"subtitle\":null,\"summary\":null,\"duration\":\"5:57:57\",\"poster\":null,\"chapters\":[{\"start\":\"00:00:00\",\"title\":\"Vorspann &amp; Danksagungen\"},{\"start\":\"00:01:27\",\"title\":\"Heute sind mit dabei  \"},{\"start\":\"00:01:37\",\"title\":\"Vorgepl\\u00e4nkel\"},{\"start\":\"00:03:24\",\"title\":\"Titelmusik\"},{\"start\":\"00:04:44\",\"title\":\"Retro Warm Up - auf in eine neue Runde  \"},{\"start\":\"00:15:06\",\"title\":\"Einspieler Werbung in eigener Sache\"},{\"start\":\"00:16:53\",\"title\":\"Einspieler Wie kann man uns erreichen?\"},{\"start\":\"00:20:17\",\"title\":\"Retro Quickie - 1975 - Adventure (Juegren)\"},{\"start\":\"00:24:08\",\"title\":\"Retro Facts: Thema - MSX Part II\"},{\"start\":\"02:00:04\",\"title\":\"Retro Quickie - 1985 - paradroid\"},{\"start\":\"02:03:18\",\"title\":\"Pausenmusik Chris H\\u00fclsbeck - Flight of the Fairlight\"},{\"start\":\"02:07:45\",\"title\":\"Retro Mysteries - Quiz mit Christian Ohrens\"},{\"start\":\"02:32:10\",\"title\":\"Retro Quickie - 1990 - Battletech 2 (Robin)\"},{\"start\":\"02:35:15\",\"title\":\"Retro Talk - Interview mit Rob Fulop\"},{\"start\":\"03:10:02\",\"title\":\"Retro Quickie - 1995 - Star Trek DS9 - (Juergen)\"},{\"start\":\"03:12:51\",\"title\":\"Pausenmusik - Bug of NCI\"},{\"start\":\"03:15:15\",\"title\":\"Retro Play - Yoland (Amiga)\"},{\"start\":\"03:28:26\",\"title\":\"Retro Quickie - 1990 -  Rodland (Patrick)\"},{\"start\":\"03:30:21\",\"title\":\"Retro Play - Zeit f\\u00fcr altes und Neues\"},{\"start\":\"03:56:40\",\"title\":\"Sendeplan ab 06.04.2020\"},{\"start\":\"03:59:03\",\"title\":\"Retro Quickie - 1990 - Full Metal Planet (Robin)\"},{\"start\":\"04:02:17\",\"title\":\"Retro Talk - Darklands (Pretty old Pixels)\"},{\"start\":\"04:45:59\",\"title\":\"Retro Talk - Prince of Persia - der erste Level\"},{\"start\":\"04:56:53\",\"title\":\"Retro Talk - Prince of Persia - Best Off\"},{\"start\":\"05:15:45\",\"title\":\"Retro Quickie - 1995 - Spirou - (Juergen)\"},{\"start\":\"05:18:31\",\"title\":\"Pausenmusik - Bug of NCI\"},{\"start\":\"05:20:31\",\"title\":\"Retro News - Neues aus der Szene\"},{\"start\":\"05:39:04\",\"title\":\"Retro Quickie - 1995 - Die total verr\\u00fcckte Rally (Patrick)\"},{\"start\":\"05:40:59\",\"title\":\"Retro Mail\"},{\"start\":\"05:42:36\",\"title\":\"Einspieler Kontaktinfos (lang)\"},{\"start\":\"05:44:27\",\"title\":\"Retro Credits \"},{\"start\":\"05:54:39\",\"title\":\"Abspann\"}],\"transcripts\":[],\"audio\":[{\"url\":\"http:\\/\\/www.medienpublikation.de\\/retrocompod\\/podcastgen\\/media\\/2020-04-06_retrokompott_-_114_-_msx_part2.mp3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        \r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<hr class=\"wp-block-separator\" />\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS-FEED</a>  <a href=\"https://www.facebook.com/retrokompott/\">Facebook</a>  <a href=\"https://twitter.com/retrokompott/\">Twitter</a>  <a href=\"https://www.instagram.com/retrokompott/\">Instagramm</a></p>\r\n<hr class=\"wp-block-separator\" />\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">HELFT UNS, DIE REGELMAESSIGE AUSSTRAHLUNG UND ZUKUNFT DES PODCASTS ZU SICHERN UND UNTERSTUETZT UNS AUF <a href=\"http://www.patreon.com/retrokompott\">PATREON</a>, <a href=\"https://steadyhq.com/de/retrokompott\">STEADY</a> ODER <a href=\"http://paypal.me/retrokompott\">PAYPAL.</a> Infos zu unser Event Location in Hamburg findet man <a href=\"https://www.facebook.com/retrospieleclub/\">HIER</a>. Zugang zu unser internen WhatsApp Gruppe erhaltet ihr auf Anfrage per <a href=\"mail@retrokompott.de\">Mail</a>.</p>\r\n<hr />\r\n<p style=\"text-align: center;\">\r\n\r\n\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\"><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2020-04-06_retrokompott_-_114_-_msx_part2.mp3?\" target=\"_blank\" rel=\"noreferrer noopener\">Download von Folge 114</a></p>\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">mit Patrick, Robin, fabskimo, Juergen &amp; Markus</p>\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">und als Themenexperten Markus &amp; Michael <br />Aufnahmedatum des Themas: 28.12.2019</p>\r\n<p style=\"text-align: center;\">\r\n\r\n\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Dauer:  5h57 min</p>\r\n<hr />\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p style=\"text-align: center;\"><em>Die naechsten Live Termine &amp; Events:</em></p>\r\n<p style=\"text-align: center;\">&#8230;</p>\r\n<p style=\"text-align: center;\">09.04 <a href=\"https://blog.retrokompott.de/live-video-stammtisch/\">Stammtisch Lets Play</a> (ab 18 Uhr, Testlauf 17:30)</p>\r\n<p style=\"text-align: center;\">&#8230;</p>\r\n<p style=\"text-align: center;\">10.04 <a href=\"https://blog.retrokompott.de/01-stammtisch/\">Stammtisch</a> (ab 21 Uhr)</p>\r\n<p style=\"text-align: center;\">&#8230;</p>\r\n<p style=\"text-align: center;\">16.04 <a href=\"https://blog.retrokompott.de/live-video-stammtisch/\">Stammtisch Lets Play</a> (ab 18 Uhr, Testlauf 17:30)</p>\r\n<p style=\"text-align: center;\">&#8230;</p>\r\n<p style=\"text-align: center;\">17.04 <a href=\"https://blog.retrokompott.de/01-stammtisch/\">Stammtisch</a> (ab 21 Uhr)</p>\r\n<p style=\"text-align: center;\">&#8230;</p>\r\n<p style=\"text-align: center;\">19.04  <a href=\"https://blog.retrokompott.de/01-live/\">Retrokompott Folge 115 ab 21:45</a></p>\r\n<p style=\"text-align: center;\">&#8230;</p>\r\n<p style=\"text-align: center;\">Events in der Event Location Hamburg Horn finet man <a href=\"http://www.retrospieleclub.de\">hier</a>.</p>\r\n<pre> </pre>\r\n<pre>Folge 114 unserer \"kleinen\" Zeitreise in die Welt vergangener Homecomputer, <br />Spielekonsolen und Games ist online. Der Retrokompott Podcast ist eine <br />Internet-Radiosendung fuer alle Fans von C64, AMIGA, MS-DOS und Co. <br />Thematisch geht es weiter um den MSX, Markus und Michael versuchen uns <br />dieses etwas exotisch anmutende System wieder naeherzubringen. Im <br />Rahmenprogramm sind Patrick, Robin, fabskimo, Juergen &amp; Markus mit dabei.<br /><strong>Kurze aktuelle Stellungnahme zur Corona Krise:</strong><br />Vielen Dank an alle, die uns bisher mit Spenden und anderen Hilfen ueber <br />den Maerz und in den April gebracht haben. Ein Drittel der laufenden Kosten <br />fuer die geschlossene Event Location in Hamburg konnten wir dadurch bereits <br />decken. Unterstuetzung seitens der Vermieter und auch seitens der Politik <br />haben wir bisher leider immer noch nicht bekommen (Stand: 06.04.2020). <br />Wir machen auf jeden Fall weiter und senden in noch hoeherer Schlagzahl, <br />um Euch erst Recht in schwierigen Zeiten mit unserer Zeitreise ein <br />bisschen Ablenkung zu ermoeglichen! Zusaetzlich zum Podcast und dem Stammtisch <br />gibt es jetzt auch noch ein woechentliches Video LIVE Event. Infos dazu auf <br />unserer Homepage, auch dort kann jeder mitmachen. <br />Helfen kann man uns z.B. mit Spenden (PayPal an <a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a>), <br />oder auch durch die Unterstuetzung unserer Podcast Projekte. <br />Wer von den Hoerern in unser staendig erwaehnten „geheimen“ Unterstuetzer <br />WhatsApp Gruppe mitmachen moechte, kann uns gerne eine Mail schreiben <br />mit einer kleinen Begruendung, warum. Vielleicht schicken wir Euch bei <br />besonders witzigen Einsendungen einen Einladungslink.<br />Unterstuetzer erhalten den Link bei Patreon oder Steady automatisch <br />und koennen jederzeit mit einsteigen!<br />Unsere Unterstuetzer erhalten auch Zugriff auf diverse Extraformate, <br />den kompletten Stammtisch und viele Previews &amp; Sonderaktionen <br />(<a href=\"http://www.patreon.com/retrokompott\">www.patreon.com/retrokompott</a>).<br />Die Retro Quickes stammen dieses Mal von Juergen, Patrick &amp; Robin, <br />ermoeglicht durch die Unterstuetzung unserer Community.<br />Im Interview Rob Fulop, ein Pionier der Computergeschichte, der schon <br />in den 70er Jahren des letzten Jahrtausends Spiele entwickelte. <br />Die Pausenmusiken stammen Bug of NCI &amp; Chris Huelsbeck (wir empfehlen <br />immer auch seine Projekte bei Patreon zu unterstuetzen, da er ja auch <br />z.B. tolle Moeglichkeiten bietet viele Musikstuecke Musik sehr guenstig <br />lizensiert in Projekten wie unserem Podcast zu benutzen)<br />Natuerlich gibt es auch wieder ein Quiz in der Retrolurch Edition 3.0. <br />Heute mit Christian Ohrens.<br />Im Retro Play kuemmern wir uns Yolanda fuer den Amiga, wer auch immer <br />die Idee hatte, sollte uns glaube ich im Augenblick nicht unter <br />die Augen treten <br />Im Retrotalk sprechen die Pretty old Pixel ueber den Klassiker <br />Darklands. Zusaetzlich gibt es Einspieler vom ersten Video Stammtisch. <br />Wir haben Prince of Persia gespielt und Arne erklaert Patrick den ersten <br />Level. Anschliessend koennen wir dank des Zusammenschnittes unseres <br />Hoerers Michael noch einmal in die besten emotionalen Momente reinhoeren. <br />Viel Spass wuenscht das Retrokompott Team mit den Retrolurchen <br />Patrick, Robin, fabskimo, Juergen &amp; Markus</pre>\r\n<hr />\r\n<p style=\"text-align: center;\">&lt;WERBUNG&gt; <br />Unsere neue Retro Event Location findet man hier: <a href=\"https://www.facebook.com/retrospieleclub/\">https://www.facebook.com/retrospieleclub/</a><br />Merchandise Artikel gibt es ab jetzt auch im Shop:<br /><a href=\"https://shop.spreadshirt.de/retrokompott\">RETROKOMPOTT MERCHANDISE</a><br />&lt;WERBUNG&gt;</p>\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<hr class=\"wp-block-separator\" />\r\n<p style=\"text-align: center;\">Ihr wollt beim Retrokompott mitmachen?</p>\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Unterstuetzen kann man uns bei <a href=\"https://www.patreon.com/retrokompott?ty=h\">PATREON,</a> <a href=\"https://steadyhq.com/de/retrokompott\">STEADY</a>, oder z.B. auch <a href=\"https://blog.retrokompott.de/helft-uns/\">hier</a> ueber PAYPAL (als Belohnung schalten wir <a href=\"https://blog.retrokompott.de/you-tube-videos/\">Videos</a> frei), damit sichert ihr die Zukunft dieses Podcasts und erhaltet viele spezielle Tracks, Videos und Infos wie zum Beipsiel die Voraufzeichnung des naechsten Themas als erstes!</p>\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\"><strong>Bei Patreon und Steady bieten wir unseren Unterstuetzern verschiedene Optionen an. Die genauen Infos findet ihr <a href=\"https://blog.retrokompott.de/04-exclusive-formate/\">hier.</a> Unterstuetzen kann man uns schon ab 1$/1 Euro im Monat </strong></p>\r\n<hr class=\"wp-block-separator\" />\r\n<p style=\"text-align: center;\">Ihr habt Fragen, Anregungen, Themenvorschlaege, moechtet einen Audio Kommentar fuer unseren Retro Talk abgeben, oder wollt aus irgendeinem anderem Grund mit uns in Kontakt treten?</p>\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Per Mail erreicht man uns unter <a href=\"mailto:mail@retrokompott.de\">mail@retrokompott.de</a></p>\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Ihr findet uns auch bei <a href=\"https://twitter.com/retrokompott\">Twitter</a>, auf <a href=\"https://www.facebook.com/retrokompott/?fref=ts\">Facebook</a>, oder auf unserer <a href=\"http://www.retrokompott.de\">Homepage</a>. Den <a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS Feed</a> kann man HIER abonnieren.</p>\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p style=\"text-align: center;\">Alle aktuellen Projekte finde man unter <a href=\"http://www.podcastkompott.de\">www.podcastkompott.de.</a></p>\r\n<p style=\"text-align: center;\">\r\n\r\n\r\n\r\n</p>\r\n<hr class=\"wp-block-separator\" />\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<hr class=\"wp-block-separator\" />\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Werbung in eigener Sache:</p>\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Unser &#8222;Lager&#8220; erreicht man hier: <a href=\"http://www.com-illusion.de\">Com Illusion GbR </a> aktuelle Spieleliste: <a href=\"http://www.medienpublikation.de/verkauf.php\">hier klicken</a></p>\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<hr class=\"wp-block-separator\" />\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<hr class=\"wp-block-separator\" />\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">Die Musiken fuer diese Folge stammen von</p>\r\n<p style=\"text-align: center;\">BugofNCI &amp; Chris Huelsbeck</p>\r\n<p style=\"text-align: center;\">Die Royalty Free Musik von Chris Huelsbeck lohnt sich auch immer zu unterstuetzen:</p>\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\"><a href=\"https://www.patreon.com/chris_huelsbeck\"><b>www.patreon.com/chris_huelsbeck</b></a></p>\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<hr class=\"wp-block-separator\" />\r\n<p style=\"text-align: center;\">\r\n\r\n</p>\r\n<p class=\"wp-block-paragraph\" style=\"text-align: center;\">weiterfuehrende Links: <b></b></p>\r\n<p style=\"text-align: center;\"><a href=\"https://www.gamepro.de/artikel/netflix-dragons-lair-ryan-reynolds,3356053.html\"><b>https://www.gamepro.de/artikel/netflix-dragons-lair-ryan-reynolds,3356053.html</b></a></p>\r\n<p style=\"text-align: center;\"> </p>\r\n<p style=\"text-align: center;\"><a href=\"https://klopapier.drwuro.com/\"><b>https://klopapier.drwuro.com/</b></a></p>\r\n<p>&nbsp;</p>\r\n<p style=\"text-align: center;\"><a href=\"https://readretro.com/unreleased-nintendo-64-game-viewpoint-2064-dumped/\"><b>https://readretro.com/unreleased-nintendo-64-game-viewpoint-2064-dumped/</b></a></p>\r\n<p style=\"text-align: center;\"> </p>\r\n<p style=\"text-align: center;\"><a href=\"https://www.giga.de/news/nintendo-laesst-super-mario-spiele-in-ps4-creator-sperren/\"><b>https://www.giga.de/news/nintendo-laesst-super-mario-spiele-in-ps4-creator-sperren/</b></a></p>\r\n<p style=\"text-align: center;\"> </p>\r\n<p style=\"text-align: center;\"><a href=\"https://www.schnittberichte.com/news.php?ID=15807\"><b>https://www.schnittberichte.com/news.php?ID=15807</b></a></p>\r\n<p style=\"text-align: center;\"> </p>\r\n<p style=\"text-align: center;\"><a href=\"http://www.indieretronews.com/2020/03/luma-laser-based-c64-puzzle-game.html\"><b>http://www.indieretronews.com/2020/03/luma-l