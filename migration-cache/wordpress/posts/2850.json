  "content": {
    "rendered": "\r\n\r\n\r\n<p class=\"wp-block-paragraph\"><a href=\"https://podcastpreis.de/\"><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-2790 aligncenter\" src=\"https://blog.retrokompott.de/wp-content/uploads/2018/12/podcastpreis.png\" alt=\"\" width=\"2000\" height=\"800\" srcset=\"https://blog.retrokompott.de/wp-content/uploads/2018/12/podcastpreis.png 2000w, https://blog.retrokompott.de/wp-content/uploads/2018/12/podcastpreis-300x120.png 300w, https://blog.retrokompott.de/wp-content/uploads/2018/12/podcastpreis-768x307.png 768w, https://blog.retrokompott.de/wp-content/uploads/2018/12/podcastpreis-1024x410.png 1024w\" sizes=\"auto, (max-width: 2000px) 100vw, 2000px\" /></a></p>\r\n<p style=\"text-align: center;\"><a href=\"https://podcastpreis.de/poll/technik/\">Fuer uns kann man 1 X taeglich in der Rubrik TECHNIK abstimmen</a></p>\r\n<hr />\r\n<p style=\"text-align: center;\">\n            <div class=\"podlove-web-player intrinsic-ignore podlove-web-player-loading\" id=\"player-6aee478fafedd\"><root data-test=\"player--xl\" style=\"max-width:950px;min-width:260px;\">\n  <div class=\"tablet:px-6 tablet:pt-6 mobile:px-4 mobile:pt-4 flex flex-col\">\n    <div class=\"flex-col items-center mobile:flex tablet:hidden\">\n      <show-title class=\"text-sm\"></show-title>\n      <episode-title class=\"text-base mb-2\"></episode-title>\n      <subscribe-button class=\"mb-4 mobile:flex tablet:hidden\"></subscribe-button>\n      <poster class=\"rounded-sm w-48 shadow overflow-hidden\"></poster>\n      <divider class=\"w-full my-6\"></divider>\n    </div>\n\n    <div class=\"tablet:flex flex-grow\">\n      <div class=\"w-64 mobile:hidden tablet:block tablet:mr-6\">\n        <poster class=\"rounded-sm shadow overflow-hidden\"></poster>\n      </div>\n      <div class=\"w-full\">\n        <div class=\"hidden tablet:block\">\n          <show-title class=\"text-base\"></show-title>\n          <episode-title class=\"text-xl desktop:text-2xl