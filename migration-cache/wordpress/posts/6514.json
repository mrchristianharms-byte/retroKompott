p3\",\"mimeType\":\"audio\\/mpeg\",\"title\":\"AUDIO\\/MPEG\",\"size\":0}],\"playlist\":null,\"show\":{\"title\":null}}, \"https://blog.retrokompott.de/wp-json/podlove-web-player/shortcode/config/retrokompott/theme/retrokompott\").then(function() {\n                  player && player.classList.remove(\"podlove-web-player-loading\");\n                });\n              });\n            </script>\n            <style>\n              .podlove-web-player.podlove-web-player-loading {\n                opacity: 0;\n              }\n            </style>\n        \r\n<!-- /wp:post-content -->\r\n\r\n<!-- wp:separator --><hr class=\"wp-block-separator\" /><!-- /wp:separator -->\r\n\r\n<!-- wp:separator -->\r\n<p><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/feed.xml\">RSS-FEED</a> <a href=\"https://discord.gg/T7NQzF2WRK\">Discord</a> <a href=\"http://www.patreon.com/retrokompott\">PATREON</a> <a href=\"https://steadyhq.com/de/retrokompott\">STEADY</a> <a href=\"http://paypal.me/retrokompott\">PAYPAL</a> <a href=\"https://www.youtube.com/channel/UC3n_WXlK-BlcGAJOMMV2vaQ\">YOUTUBE</a> <a href=\"https://www.twitch.tv/retro_kompott\">TWITCH</a> <a href=\"https://www.facebook.com/retrokompott/\">Facebook</a> <a href=\"https://twitter.com/retrokompott/\">Twitter</a> <a href=\"https://www.instagram.com/retrokompott/\">Instagramm</a></p>\r\n<!-- wp:separator --><hr class=\"wp-block-separator\" /><!-- /wp:separator -->\r\n\r\n<!-- wp:separator -->\r\n<p><a href=\"http://www.medienpublikation.de/retrocompod/podcastgen/media/2024-02-05_retrokompott_-_214_-_sega_saturn_geheimtipps_part2.mp3?\">Download von Folge 214</a></p>\r\n<!-- /wp:separator -->\r\n\r\n<!-- wp:paragraph -->\r\n<pre>mit Patrick, Robin &amp; Oliver</pre>\r\n<pre>Themenexperten: Oliver, Michael &amp; Patrick</pre>\r\n<pre>Dauer: 3h53min</pre>\r\n<hr />\r\n<p><b>Shownotes:</b></p>\r\n<pre><b>allgemeine Podcast Infos:</b></pre>\r\n<pre>Jeden Mittwoch gibt es um 20:15 eine <a href=\"http://www.retrolagerfeuer.de\">Big Box Verkaufsshow</a> auf Twitch\r\n(am ersten Mittwoxch im Monat das Retro Bingo), \r\njeden Donnerstag ab 20 Uhr gibt es den <a href=\"https://blog.retrokompott.de/live-video-stammtisch/\"> LIVE VIDEO STAMMTISCH</a>, \r\njeden Freitag ab 21 Uhr den <a href=\"https://blog.retrokompott.de/01-stammtisch/\"> LIVE AUDIO STAMMTISCH auf Teamspeak</a>.\r\n\r\nUnseren Retro Spiele Club, unser bespielbares Museum in Hamburg Horn \r\nfindet ihr auf <a href=\"http://www.retrospieleclub.de\">www.retrospieleclub.de</a>. \r\n\r\nFuer weitere Infos nutzt gerne unseren Newsletter \r\n(<a href=\"http://www.retrospieleclub.de/newsletter/\">http://www.retrospieleclub.de/newsletter/</a>).\r\n\r\n<b>Inhalt &amp; Zeitmarken:\r\n</b></pre>\r\n<pre>00:00:00 Vorspann und Danksagungen \r\n00:01:40 Heute sind mit dabei \r\n00:01:51 Titelmusik \r\n00:03:11 Retro Warm Up - auf in eine neue Runde \r\n00:12:13 Einspieler: Wie kann man uns erreichen? \r\n00:13:18 Werbung - Dragonbox \r\n00:15:00 Retro Facts: Sega Saturn Geheimtipps Part 2\r\n01:16:56 Einspieler: Werbung in eigener Sache\r\n01:18:46 Musik: Komiku - The road we use to travel when we were kids (Public Domain)\r\n01:21:07 Quiz Classics mit Christian\r\n01:31:11 Retro Talk - Interview mit Daniel Schwen\r\n02:20:46 Musik: Komiku - The adventure (Public Domain)\r\n02:21:44 Retro Play - Was haben wir gespielt?\r\n02:54:03 Retro News - Neues aus der Szene \r\n03:27:23 Musik: Komiku - Road 1 Fight (Public Domain)\r\n03:29:11 Retro Credits - Kurz vor Schluss\r\n03:33:40 Hinter den Kulissen\r\n03:49:58 Abspann\r\n\r\nDauer: 03:53:10</pre>\r\n<pre>HELFT UNS, DIE REGELMAESSIGE AUSSTRAHLUNG UND ZUKUNFT DES PODCASTS ZU SICHERN\r\nUND UNTERSTUETZT UNS AUF<a href=\"http://www.patreon.com/retrokompott\"> PATREON</a>,  ODER<a href=\"http://paypal.me/retrokompott\"> PAYPAL.</a> \r\nZugang zu unserer internen WhatsApp Gruppe erhalten Unterstuetzer automatisch.</pre>\r\n<pre><b>\r\nDie gespielten Spiele der Teilnehmer:</b><b> </b></pre>\r\n<pre>Patrick: Hockey (SABA Videoplay) <br />Robin  : Herr der Ringe - Schlacht um Mittelerde<br /><br />Patrick: Easy Racing,the logic inside, Spacejump, Cheap Golf, Gear Tunnel, Jusant<br />Robin  : Civilization 6, War Thunder deinstalliert, Versuche der Colecovision <br />Oliver : Case of the Golden Idol, GreedFall, Superfrog, Prince of Persia Lost Crown,<br />         Vampire Survivor, Ace Attourney</pre>\r\n<pre><strong>Die Links aus den News:</strong><br /><br /><a href=\"https://www.heise.de/news/Deutsche-Bahn-sucht-Admin-fuer-Windows-3-11-for-Workgroups-9611543.html\">https://www.heise.de/news/Deutsche-Bahn-sucht-Admin-fuer-Windows-3-11-for-Workgroups-9611543.html</a><br /><br /><a href=\"https://www.giga.de/news/nintendo-zieht-zwei-konsolen-den-stecker-am-8.-april-ist-es-soweit-xyz/\">https://www.giga.de/news/nintendo-zieht-zwei-konsolen-den-stecker-am-8.-april-ist-es-soweit-xyz/</a><br /><br /><a href=\"https://www.gameswirtschaft.de/wirtschaft/aelteste-spiele-hersteller-deutschland-2024/\">https://www.gameswirtschaft.de/wirtschaft/aelteste-spiele-hersteller-deutschland-2024/</a><br /><br /><a href=\"https://www.creativebloq.com/news/atari-gamestation-portable\">https://www.creativebloq.com/news/atari-gamestation-portable</a>\r\n\r\n<strong><br />Discord:\r\n</strong></pre>\r\n<pre><a href=\"https://mein-mmo.de/bastler-192-luefter-bildschirm-mit-3840-leds-spielt-tetris-doom/\">https://mein-mmo.de/bastler-192-luefter-bildschirm-mit-3840-leds-spielt-tetris-doom/</a><br /><a href=\"https://www.gamestar.de/artikel/piranha-bytes-gothic-elex-schliessung,3406996.html\">https://www.gamestar.de/artikel/piranha-bytes-gothic-elex-schliessung,3406996.html</a><br /><a href=\"https://www.notebookcheck.com/Kickstarter-Projekt-ReBoi-ersetzt-das-Innere-eines-GameBoy-Color-durch-einen-Raspberry-Pi.795652.0.html\">https://www.notebookcheck.com/Kickstarter-Projekt-ReBoi-ersetzt-das-Innere-eines-GameBoy-Color-durch-einen-Raspberry-Pi.795652.0.html</a><br /><br /><a href=\"http